
{
  "name": "seen-in-korea",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-09-27",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "run_worker_first": true
  },
  "images": {
    "binding": "IMAGES"
  },
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "3cb6ba5cb34e436283b2a642452a50ac"
    }
  ],
  "d1_databases": [
    {
      "binding": "SIK_DB",
      "database_name": "seen-in-korea-experiences",
      "database_id": "135074ab-c87b-4198-880c-480dd24eb664"
    }
  ],
  "previews": {
    "images": {
      "binding": "IMAGES"
    },
    "kv_namespaces": [
      {
        "binding": "SESSION",
        "id": "f0fbb30a2d7a4aad9a67224ca9ee55a6"
      }
    ],
    "d1_databases": [
      {
        "binding": "SIK_DB",
        "database_name": "seen-in-korea-experiences-preview",
        "database_id": "318aa042-5105-4791-8b98-fdc6b843676f"
      }
    ]
  },
  "observability": {
    "enabled": true
  }
}
