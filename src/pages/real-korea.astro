---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getInterviews } from '../lib/content';
const interviews = await getInterviews(50);
---
<BaseLayout title="Real Korea — Seen in Korea" description="Published stories and insight from foreigners living in Korea.">
  <main><section class="listing-hero"><div class="wrap"><div class="eyebrow">100 VOICES: KOREA</div><h1>REAL KOREA</h1><p>Published experiences from people living in Korea. Raw private interview data stays outside the public content dataset.</p></div></section>
  <section><div class="wrap"><div class="grid-3">{interviews.map(item => <article class="voice"><span class="tag">{item.country || 'KOREA'}</span><div class="quote">“{item.quote || item.headline}”</div><h3>{item.headline}</h3><p>{item.summary}</p><div class="voice-foot">{item.displayName || 'Anonymous'}{item.yearsInKorea ? ` · ${item.yearsInKorea} years in Korea` : ''}</div></article>)}</div></div></section></main>
</BaseLayout>
