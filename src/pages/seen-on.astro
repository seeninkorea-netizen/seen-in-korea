---
import BaseLayout from '../layouts/BaseLayout.astro';


const evidenceLegend = [
  {
    key: 'confirmed',
    label: 'Confirmed use',
    description:
      'Actual personal use is supported by a public photo, video or attributable first-party statement.'
  },
  {
    key: 'campaign',
    label: 'Official campaign',
    description:
      'The brand confirms an ambassador, campaign or commercial relationship.'
  },
  {
    key: 'reported',
    label: 'Reported',
    description:
      'A reliable source reports the product, but personal use is not independently confirmed.'
  },
  {
    key: 'unconfirmed',
    label: 'Unconfirmed',
    description:
      'Only speculation exists. We do not attach a buying recommendation.'
  }
];


const verifiedProducts = [
  {
    id: 'laneige-juicepop-katseye',

    evidence:
      'campaign',

    evidenceLabel:
      'OFFICIAL CAMPAIGN',

    person:
      'KATSEYE',

    brand:
      'LANEIGE',

    title:
      'JuicePop Box Lip Tint',

    category:
      'Beauty',

    relationship:
      'Global partner · Official campaign',

    note:
      'LANEIGE officially announced KATSEYE as its global partner for the JuicePop Box Lip Tint campaign. This confirms the campaign relationship, not private everyday use.',

    priceRegion:
      'KOREA',

    price:
      '₩23,000',

    priceLabel:
      'Official Korea price',

    checked:
      'Checked · Oct 2026',

    image:
      'https://www.apgroup.com/int/ko/news/__icsFiles/afieldfile/2026/02/02/02024.jpg',

    imageAlt:
      'KATSEYE in the official LANEIGE JuicePop Box Lip Tint campaign',

    imageCredit:
      'OFFICIAL CAMPAIGN IMAGE · AMOREPACIFIC',

    evidenceUrl:
      'https://www.apgroup.com/int/en/news/2026-02-02-2.html',

    storeUrl:
      'https://www.laneige.com/product/%EC%A3%BC%EC%8A%A4%ED%8C%9D-%EB%B0%95%EC%8A%A4-%EB%A6%BD-%ED%8B%B4%ED%8A%B8/94/%7B'
  },


  {
    id: 'anua-pdrn-kendall',

    evidence:
      'campaign',

    evidenceLabel:
      'OFFICIAL CAMPAIGN',

    person:
      'KENDALL JENNER',

    brand:
      'ANUA',

    title:
      'PDRN Collagen Glow Facial Serum Spray',

    category:
      'Beauty',

    relationship:
      'Global ambassador · Brand campaign',

    note:
      'ANUA features the PDRN Serum Spray as one of Kendall Jenner’s Glow Essentials on its official site. We classify this as brand-confirmed campaign evidence rather than independent proof of private everyday use.',

    priceRegion:
      'U.S.',

    price:
      '$29',

    priceLabel:
      'Official U.S. price',

    checked:
      'Checked · Oct 2026',

    image:
      'https://anua.com/cdn/shop/files/Anua_US_Official_Website_kendall_Page_main_banner_pc_47818aba-d92d-4d78-9933-81b6a37a82a9.jpg?v=1781877556&width=1600',

    imageAlt:
      'Kendall Jenner in ANUA official brand imagery',

    imageCredit:
      'OFFICIAL BRAND IMAGE · ANUA',

    evidenceUrl:
      'https://anua.com/pages/about',

    storeUrl:
      'https://anua.com/products/pdrn-100-hyaluronic-acid-hydrating-capsule-mist-100ml'
  }
];


const publishedCount =
  verifiedProducts.length;

const campaignCount =
  verifiedProducts.filter(
    item =>
      item.evidence === 'campaign'
  ).length;

const confirmedUseCount =
  verifiedProducts.filter(
    item =>
      item.evidence === 'confirmed'
  ).length;
---


<BaseLayout
  title="Seen On — Verified Korea Products | SEEN IN KOREA"
  description="Products seen in Korean culture, checked by evidence level, price and official sources before we recommend where to buy."
>

  <main class="seen-on-page">


    <!-- HERO -->
    <section class="seen-on-hero">

      <div class="wrap">

        <div class="seen-on-hero-grid">


          <div class="seen-on-hero-copy">

            <div class="eyebrow">
              02 · SEEN ON
            </div>


            <h1>
              See the look.<br />
              Check the evidence.<br />
              Find the product.
            </h1>


            <p>
              Celebrity attention moves products fast.
              We slow down the claim:
              what is confirmed,
              what is only a campaign,
              what the product actually is,
              and what it costs.
            </p>

          </div>



          <div class="seen-on-verify-panel">

            <a
              class="seen-on-verify-title"
              href="/how-we-verify"
            >
              HOW WE VERIFY

              <span>
                →
              </span>
            </a>


            <div class="seen-on-legend">

              {
                evidenceLegend.map(
                  item => (

                    <div class="seen-on-legend-item">

                      <span
                        class:list={[
                          'seen-on-dot',
                          item.key
                        ]}
                      ></span>


                      <div>

                        <strong>
                          {item.label}
                        </strong>

                        <p>
                          {item.description}
                        </p>

                      </div>

                    </div>

                  )
                )
              }

            </div>

          </div>


        </div>

      </div>

    </section>



    <!-- TRANSPARENCY -->
    <section class="seen-on-status-section">

      <div class="wrap">

        <div class="seen-on-status-grid">


          <div class="seen-on-status-item">

            <strong>
              {publishedCount}
            </strong>

            <span>
              VERIFIED PRODUCTS PUBLISHED
            </span>

          </div>


          <div class="seen-on-status-item">

            <strong>
              {campaignCount}
            </strong>

            <span>
              OFFICIAL CAMPAIGNS
            </span>

          </div>


          <div class="seen-on-status-item">

            <strong>
              {confirmedUseCount}
            </strong>

            <span>
              CONFIRMED PERSONAL USE
            </span>

          </div>


          <div class="seen-on-status-copy">

            <b>
              Why only two?
            </b>

            <p>
              We would rather publish two products
              with traceable evidence than fill the page
              with celebrity-product guesses.
            </p>

          </div>


        </div>

      </div>

    </section>



    <!-- VERIFIED NOW -->
    <section class="seen-on-products-section">

      <div class="wrap">


        <div class="seen-on-section-head">

          <div>

            <div class="seen-on-section-kicker">
              VERIFIED NOW
            </div>

            <h2>
              Products with evidence attached.
            </h2>

            <p>
              Every product below links back
              to the source used for verification.
            </p>

          </div>


          <div class="seen-on-live-label">
            LIVE · {publishedCount} PRODUCTS
          </div>

        </div>



        <div class="seen-on-products-grid">

          {
            verifiedProducts.map(
              item => (

                <article
                  class="seen-on-product"
                  id={item.id}
                >


                  <div class="seen-on-product-media">

                    <img
                      src={item.image}
                      alt={item.imageAlt}
                      loading="lazy"
                    />


                    <span
                      class:list={[
                        'seen-on-evidence-badge',
                        item.evidence
                      ]}
                    >

                      <span
                        class:list={[
                          'seen-on-dot',
                          item.evidence
                        ]}
                      ></span>

                      {item.evidenceLabel}

                    </span>


                    <span class="seen-on-image-credit">
                      {item.imageCredit}
                    </span>

                  </div>



                  <div class="seen-on-product-content">


                    <div class="seen-on-product-meta">

                      <span>
                        {item.category}
                      </span>

                      <span>
                        {item.relationship}
                      </span>

                    </div>


                    <div class="seen-on-person">
                      {item.person} × {item.brand}
                    </div>


                    <h2>
                      {item.title}
                    </h2>


                    <p class="seen-on-product-note">
                      {item.note}
                    </p>



                    <div class="seen-on-evidence-box">

                      <div>

                        <span class="seen-on-box-label">
                          WHAT WE VERIFIED
                        </span>

                        <strong>
                          {item.relationship}
                        </strong>

                      </div>


                      <a
                        href={item.evidenceUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        VIEW OFFICIAL EVIDENCE ↗
                      </a>

                    </div>



                    <div class="seen-on-price-box">

                      <div>

                        <span class="seen-on-box-label">
                          {item.priceRegion}
                        </span>

                        <strong class="seen-on-price">
                          {item.price}
                        </strong>

                      </div>


                      <div class="seen-on-price-detail">

                        <b>
                          {item.priceLabel}
                        </b>

                        <span>
                          {item.checked}
                        </span>

                      </div>

                    </div>



                    <div class="seen-on-actions">

                      <a
                        class="seen-on-action-primary"
                        href={item.storeUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        CHECK OFFICIAL STORE ↗
                      </a>


                      <a
                        class="seen-on-action-secondary"
                        href={item.evidenceUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        SEE SOURCE
                      </a>

                    </div>


                  </div>


                </article>

              )
            )
          }

        </div>


      </div>

    </section>



    <!-- WHY NO PLACEHOLDERS -->
    <section class="seen-on-queue-section">

      <div class="wrap">

        <div class="seen-on-queue-grid">


          <div>

            <div class="eyebrow">
              WHAT COMES NEXT
            </div>

            <h2>
              We add products only
              when the evidence is ready.
            </h2>

          </div>



          <div class="seen-on-queue-steps">


            <div class="seen-on-queue-step">

              <span>
                01
              </span>

              <div>

                <strong>
                  Identify the exact product
                </strong>

                <p>
                  No vague “similar item” or
                  fan-made product identification.
                </p>

              </div>

            </div>


            <div class="seen-on-queue-step">

              <span>
                02
              </span>

              <div>

                <strong>
                  Verify the relationship
                </strong>

                <p>
                  Confirmed use,
                  campaign,
                  reporting or unconfirmed.
                </p>

              </div>

            </div>


            <div class="seen-on-queue-step">

              <span>
                03
              </span>

              <div>

                <strong>
                  Check the price
                </strong>

                <p>
                  Korea and overseas prices
                  are checked separately.
                </p>

              </div>

            </div>


            <div class="seen-on-queue-step">

              <span>
                04
              </span>

              <div>

                <strong>
                  Add the buying option
                </strong>

                <p>
                  Buying links come after
                  the evidence, not before it.
                </p>

              </div>

            </div>


          </div>


        </div>

      </div>

    </section>



    <!-- COMMERCE POLICY -->
    <section class="seen-on-commerce-section">

      <div class="wrap seen-on-commerce-grid">


        <div>

          <div class="eyebrow">
            EDITORIAL × COMMERCE
          </div>

          <h2>
            Verification is not for sale.
          </h2>

        </div>



        <div class="seen-on-commerce-copy">

          <p>
            Seen in Korea may later earn revenue
            from affiliate links, retailer partnerships
            or sponsored offers.
          </p>


          <p>
            Those commercial relationships do not change
            the evidence label.
            A paid relationship cannot turn an
            “Official campaign” into “Confirmed use.”
          </p>


          <p>
            The official-store links currently shown
            on this page are provided for product checking.
            They are not labeled as affiliate links
            unless an affiliate relationship is actually active.
          </p>


          <a href="/how-we-verify">
            READ THE VERIFICATION METHOD →
          </a>

        </div>


      </div>

    </section>


  </main>

</BaseLayout>



<style>

  .seen-on-page {
    background:
      #f3f0ea;
  }


  /* HERO */

  .seen-on-hero {
    padding:
      58px 0 38px;

    border-bottom:
      1px solid
      var(--line);
  }


  .seen-on-hero-grid {
    display:
      grid;

    grid-template-columns:
      minmax(0, 1.08fr)
      minmax(390px, .92fr);

    gap:
      54px;

    align-items:
      end;
  }


  .seen-on-hero-copy h1 {
    max-width:
      800px;

    margin:
      12px 0 20px;

    font-size:
      clamp(
        54px,
        6vw,
        82px
      );

    line-height:
      .9;

    letter-spacing:
      -.067em;
  }


  .seen-on-hero-copy > p {
    max-width:
      700px;

    margin:
      0;

    color:
      var(--muted);

    font-size:
      16px;

    line-height:
      1.5;
  }


  /* VERIFY */

  .seen-on-verify-panel {
    padding-left:
      30px;

    border-left:
      1px solid
      var(--line);
  }


  .seen-on-verify-title {
    display:
      flex;

    justify-content:
      space-between;

    gap:
      20px;

    margin-bottom:
      22px;

    color:
      #111;

    font-size:
      10px;

    font-weight:
      900;

    letter-spacing:
      .09em;
  }


  .seen-on-verify-title span {
    color:
      var(--accent);
  }


  .seen-on-legend {
    display:
      grid;

    grid-template-columns:
      repeat(
        2,
        minmax(0, 1fr)
      );

    gap:
      20px 18px;
  }


  .seen-on-legend-item {
    display:
      grid;

    grid-template-columns:
      12px 1fr;

    gap:
      9px;

    align-items:
      start;
  }


  .seen-on-dot {
    width:
      9px;

    height:
      9px;

    display:
      inline-block;

    flex:
      0 0 auto;

    border-radius:
      999px;

    background:
      #aaa;
  }


  .seen-on-dot.confirmed {
    background:
      #167629;
  }


  .seen-on-dot.campaign {
    background:
      #2768ce;
  }


  .seen-on-dot.reported {
    background:
      var(--accent);
  }


  .seen-on-dot.unconfirmed {
    background:
      #aaa;
  }


  .seen-on-legend-item strong {
    display:
      block;

    margin:
      -2px 0 4px;

    font-size:
      12px;
  }


  .seen-on-legend-item p {
    margin:
      0;

    color:
      var(--muted);

    font-size:
      10px;

    line-height:
      1.45;
  }


  /* STATUS */

  .seen-on-status-section {
    padding:
      18px 0;

    background:
      #111;

    color:
      #fff;
  }


  .seen-on-status-grid {
    display:
      grid;

    grid-template-columns:
      150px 150px 170px 1fr;

    gap:
      0;
  }


  .seen-on-status-item {
    padding:
      6px 22px 6px 0;

    border-right:
      1px solid
      rgba(
        255,
        255,
        255,
        .16
      );
  }


  .seen-on-status-item + .seen-on-status-item {
    padding-left:
      22px;
  }


  .seen-on-status-item strong {
    display:
      block;

    color:
      var(--accent);

    font-size:
      31px;

    line-height:
      1;
  }


  .seen-on-status-item span {
    display:
      block;

    margin-top:
      6px;

    color:
      #aaa;

    font-size:
      7px;

    font-weight:
      900;

    letter-spacing:
      .08em;

    line-height:
      1.35;
  }


  .seen-on-status-copy {
    padding-left:
      25px;
  }


  .seen-on-status-copy b {
    display:
      block;

    margin-bottom:
      3px;

    font-size:
      10px;
  }


  .seen-on-status-copy p {
    max-width:
      520px;

    margin:
      0;

    color:
      #aaa;

    font-size:
      10px;

    line-height:
      1.45;
  }


  /* PRODUCTS */

  .seen-on-products-section {
    padding:
      46px 0 62px;

    background:
      #f8f5ef;
  }


  .seen-on-section-head {
    display:
      flex;

    justify-content:
      space-between;

    align-items:
      end;

    gap:
      30px;

    margin-bottom:
      24px;
  }


  .seen-on-section-kicker {
    color:
      var(--accent);

    font-size:
      10px;

    font-weight:
      900;

    letter-spacing:
      .1em;
  }


  .seen-on-section-head h2 {
    margin:
      6px 0 7px;

    font-size:
      clamp(
        37px,
        4vw,
        53px
      );

    line-height:
      .95;

    letter-spacing:
      -.055em;
  }


  .seen-on-section-head p {
    margin:
      0;

    color:
      var(--muted);

    font-size:
      12px;

    line-height:
      1.45;
  }


  .seen-on-live-label {
    padding:
      8px 10px;

    border:
      1px solid
      var(--line);

    background:
      #fffdfa;

    font-size:
      8px;

    font-weight:
      900;

    letter-spacing:
      .08em;
  }


  .seen-on-products-grid {
    display:
      grid;

    grid-template-columns:
      repeat(
        2,
        minmax(0, 1fr)
      );

    gap:
      16px;
  }


  .seen-on-product {
    overflow:
      hidden;

    background:
      #fffdfa;

    border:
      1px solid
      var(--line);
  }


  .seen-on-product-media {
    position:
      relative;

    height:
      430px;

    overflow:
      hidden;

    background:
      #ddd5ca;
  }


  .seen-on-product-media img {
    width:
      100%;

    height:
      100%;

    display:
      block;

    object-fit:
      cover;
  }


  .seen-on-evidence-badge {
    position:
      absolute;

    top:
      15px;

    left:
      15px;

    display:
      inline-flex;

    align-items:
      center;

    gap:
      7px;

    padding:
      8px 10px;

    background:
      rgba(
        255,
        255,
        255,
        .96
      );

    border:
      1px solid
      rgba(
        0,
        0,
        0,
        .08
      );

    color:
      #111;

    font-size:
      8px;

    font-weight:
      900;

    letter-spacing:
      .06em;
  }


  .seen-on-image-credit {
    position:
      absolute;

    left:
      15px;

    bottom:
      15px;

    padding:
      7px 9px;

    background:
      rgba(
        17,
        17,
        17,
        .88
      );

    color:
      #fff;

    font-size:
      7px;

    font-weight:
      900;

    letter-spacing:
      .07em;
  }


  .seen-on-product-content {
    padding:
      24px;
  }


  .seen-on-product-meta {
    display:
      flex;

    justify-content:
      space-between;

    gap:
      12px;

    color:
      var(--muted);

    font-size:
      8px;

    font-weight:
      800;

    letter-spacing:
      .04em;
  }


  .seen-on-person {
    margin-top:
      24px;

    color:
      var(--accent);

    font-size:
      10px;

    font-weight:
      900;

    letter-spacing:
      .08em;
  }


  .seen-on-product-content > h2 {
    min-height:
      64px;

    margin:
      6px 0 13px;

    font-size:
      clamp(
        29px,
        3vw,
        40px
      );

    line-height:
      .97;

    letter-spacing:
      -.05em;
  }


  .seen-on-product-note {
    min-height:
      74px;

    margin:
      0;

    color:
      var(--muted);

    font-size:
      12px;

    line-height:
      1.55;
  }


  /* EVIDENCE BOX */

  .seen-on-evidence-box {
    margin-top:
      23px;

    padding:
      15px 0;

    display:
      flex;

    justify-content:
      space-between;

    align-items:
      end;

    gap:
      20px;

    border-top:
      1px solid
      var(--line);

    border-bottom:
      1px solid
      var(--line);
  }


  .seen-on-box-label {
    display:
      block;

    margin-bottom:
      5px;

    color:
      var(--muted);

    font-size:
      7px;

    font-weight:
      900;

    letter-spacing:
      .08em;
  }


  .seen-on-evidence-box strong {
    font-size:
      11px;
  }


  .seen-on-evidence-box a {
    flex:
      0 0 auto;

    color:
      var(--accent);

    font-size:
      8px;

    font-weight:
      900;

    letter-spacing:
      .05em;
  }


  /* PRICE */

  .seen-on-price-box {
    padding:
      18px 0;

    display:
      flex;

    justify-content:
      space-between;

    align-items:
      end;

    gap:
      20px;
  }


  .seen-on-price {
    display:
      block;

    font-size:
      30px;

    line-height:
      1;

    letter-spacing:
      -.04em;
  }


  .seen-on-price-detail {
    text-align:
      right;
  }


  .seen-on-price-detail b,
  .seen-on-price-detail span {
    display:
      block;
  }


  .seen-on-price-detail b {
    font-size:
      9px;
  }


  .seen-on-price-detail span {
    margin-top:
      4px;

    color:
      var(--muted);

    font-size:
      8px;
  }


  /* ACTIONS */

  .seen-on-actions {
    display:
      grid;

    grid-template-columns:
      1fr auto;

    gap:
      8px;
  }


  .seen-on-action-primary,
  .seen-on-action-secondary {
    min-height:
      47px;

    display:
      flex;

    align-items:
      center;

    justify-content:
      center;

    padding:
      0 15px;

    font-size:
      8px;

    font-weight:
      900;

    letter-spacing:
      .06em;
  }


  .seen-on-action-primary {
    background:
      var(--accent);

    color:
      #fff;
  }


  .seen-on-action-secondary {
    border:
      1px solid
      var(--line);

    color:
      #111;
  }


  /* QUEUE */

  .seen-on-queue-section {
    padding:
      58px 0;

    background:
      #ece6dc;
  }


  .seen-on-queue-grid {
    display:
      grid;

    grid-template-columns:
      .85fr 1.15fr;

    gap:
      70px;
  }


  .seen-on-queue-grid h2 {
    max-width:
      520px;

    margin:
      8px 0 0;

    font-size:
      clamp(
        40px,
        4vw,
        55px
