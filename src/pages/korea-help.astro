/* =========================================================
   CALL KOREA — SIMPLIFIED UX
   ========================================================= */

.call-korea-page{
  --ck-bg:#f5f1ea;
  --ck-paper:#fffdfa;
  --ck-soft:#ece6dd;
  --ck-line:#d4cec5;
  --ck-ink:#111;
  --ck-muted:#67615a;
  --ck-accent:#ff4d00;
  --ck-green:#17a957;

  background:var(--ck-bg);
  color:var(--ck-ink);
}


.call-korea-page *{
  box-sizing:border-box;
}


.call-korea-page section{
  border-bottom:1px solid var(--ck-line);
}


.call-korea-page .eyebrow{
  color:var(--ck-accent);
  font-size:10px;
  font-weight:900;
  letter-spacing:.08em;
}


/* =========================================================
   EMERGENCY
   ========================================================= */

.call-emergency{
  background:#111;
  color:#fff;
}


.call-emergency-inner{
  min-height:42px;
  display:flex;
  align-items:center;
  gap:18px;
  font-size:10px;
}


.call-emergency-inner strong{
  color:#ff6a33;
}


.call-emergency-inner small{
  margin-left:auto;
  color:#aaa;
}


/* =========================================================
   HERO
   ========================================================= */

.call-hero{
  padding:58px 0 52px;

  background:
    radial-gradient(
      circle at 84% 15%,
      rgba(255,77,0,.12),
      transparent 25%
    ),
    linear-gradient(
      135deg,
      #f8f4ee,
      #ece6dd
    );
}


.call-hero-grid{
  display:grid;
  grid-template-columns:
    minmax(0,1.2fr)
    minmax(300px,.62fr);

  gap:56px;
  align-items:center;
}


.call-hero-copy h1{
  max-width:820px;
  margin:12px 0 20px;

  font-size:clamp(
    62px,
    7.3vw,
    102px
  );

  line-height:.86;
  letter-spacing:-.07em;
}


.call-hero-copy h1 span{
  color:var(--ck-accent);
}


.call-hero-copy > p{
  max-width:660px;
  margin:0;

  color:#37332f;

  font-size:18px;
  line-height:1.5;
}


.call-hero-actions{
  display:flex;
  flex-wrap:wrap;

  gap:10px;
  margin-top:27px;
}


/* =========================================================
   HERO ACTIONS
   ========================================================= */

.call-action{
  min-height:58px;
  min-width:220px;

  padding:10px 18px;

  display:flex;
  flex-direction:column;
  align-items:flex-start;
  justify-content:center;

  border:1px solid #111;

  font-size:11px;
  font-weight:900;
  line-height:1.15;
}


.call-action small{
  margin-top:4px;

  font-size:9px;
  font-weight:700;

  opacity:.72;
}


.call-action-free{
  border-color:var(--ck-green);

  background:var(--ck-green);
  color:#fff;
}


.call-action-paid{
  background:#111;
  color:#fff;
}


.call-trust{
  display:flex;
  flex-wrap:wrap;

  gap:10px 22px;

  margin-top:20px;
  padding-top:16px;

  border-top:1px solid var(--ck-line);

  color:var(--ck-muted);

  font-size:10px;
  font-weight:800;
}


.call-trust span::before{
  content:'✓';

  margin-right:6px;

  color:var(--ck-accent);
}


/* =========================================================
   DESKTOP SUMMARY
   ========================================================= */

.call-hero-summary{
  padding:26px;

  background:#111;
  color:#fff;

  box-shadow:
    0 20px 50px
    rgba(0,0,0,.12);
}


.call-summary-top{
  display:flex;
  align-items:center;
  justify-content:space-between;

  gap:12px;

  padding-bottom:16px;

  border-bottom:1px solid #333;
}


.call-summary-top strong{
  font-size:12px;
  letter-spacing:.05em;
}


.call-summary-top span{
  padding:4px 7px;

  border-radius:999px;

  background:var(--ck-accent);

  font-size:8px;
  font-weight:900;
}


.call-hero-summary h2{
  margin:20px 0 16px;

  font-size:26px;
  line-height:1.03;
  letter-spacing:-.04em;
}


.call-hero-summary ol{
  margin:0;
  padding:0;

  list-style:none;

  border-top:1px solid #333;
}


.call-hero-summary li{
  padding:10px 0;

  border-bottom:1px solid #333;

  color:#ddd;

  font-size:11px;
}


.call-hero-summary li::before{
  content:'→';

  margin-right:8px;

  color:var(--ck-accent);
}


.call-summary-price{
  padding:18px 0 5px;
}


.call-summary-price span{
  display:block;

  color:#aaa;

  font-size:9px;
  font-weight:900;
}


.call-summary-price strong{
  display:block;

  margin-top:4px;

  font-size:46px;
  line-height:.95;
  letter-spacing:-.05em;
}


.call-summary-price small{
  display:block;

  margin-top:7px;

  color:#999;

  font-size:9px;
  line-height:1.4;
}


.call-hero-summary > a{
  min-height:48px;

  margin-top:16px;

  display:flex;
  align-items:center;
  justify-content:center;

  background:var(--ck-accent);
  color:#fff;

  font-size:10px;
  font-weight:900;
}


/* =========================================================
   SHARED SECTION
   ========================================================= */

.call-section{
  padding:54px 0;
}


.call-section-head{
  margin-bottom:24px;

  display:grid;

  grid-template-columns:
    1fr
    minmax(240px,420px);

  gap:30px;

  align-items:end;
}


.call-section-head h2{
  margin:8px 0 0;

  font-size:44px;
  line-height:.95;
  letter-spacing:-.055em;
}


.call-section-head > p{
  margin:0;

  color:var(--ck-muted);

  font-size:12px;
  line-height:1.5;
}


/* =========================================================
   SITUATIONS
   ========================================================= */

.call-situations{
  background:#fbf8f3;
}


.call-situation-list{
  display:grid;

  grid-template-columns:
    repeat(3,1fr);

  gap:10px;
}


.call-situation{
  min-height:160px;

  padding:18px;

  display:grid;

  grid-template-columns:
    38px
    minmax(0,1fr)
    auto;

  gap:13px;

  align-items:start;

  background:var(--ck-paper);

  border:
    1px solid
    var(--ck-line);

  transition:
    transform .15s ease,
    border-color .15s ease;
}


.call-situation:hover{
  transform:translateY(-2px);

  border-color:
    var(--ck-accent);
}


.call-situation-icon{
  width:34px;
  height:34px;

  display:grid;
  place-items:center;

  border-radius:50%;

  background:#f0ebe4;

  font-size:15px;
  font-weight:900;
}


.call-situation h3{
  margin:3px 0 7px;

  font-size:20px;
  line-height:1;
  letter-spacing:-.035em;
}


.call-situation p{
  margin:0;

  color:var(--ck-muted);

  font-size:11px;
  line-height:1.45;
}


.call-situation > strong{
  margin-top:8px;

  color:var(--ck-accent);

  font-size:14px;
}


/* =========================================================
   SEND WHAT YOU HAVE
   ========================================================= */

.call-send-box{
  margin-top:14px;

  padding:22px;

  display:grid;

  grid-template-columns:
    220px
    1fr
    1.1fr;

  gap:22px;

  align-items:center;

  background:#eaf2fb;

  border:
    1px solid
    #d5e3f3;
}


.call-send-box h3{
  margin:6px 0 0;

  font-size:24px;
  letter-spacing:-.04em;
}


.call-send-options{
  display:flex;
  flex-wrap:wrap;

  gap:7px;
}


.call-send-options span{
  padding:7px 9px;

  border:
    1px solid
    #b7cee8;

  border-radius:999px;

  background:#fff;
  color:#255b91;

  font-size:8px;
  font-weight:900;
}


.call-send-box > p{
  margin:0;

  color:#35516d;

  font-size:11px;
  line-height:1.5;
}


/* =========================================================
   HOW IT WORKS
   ========================================================= */

.call-how{
  background:#efe9e0;
}


.call-step-list{
  display:grid;

  grid-template-columns:
    repeat(3,1fr);

  border-top:
    2px solid #111;

  border-bottom:
    1px solid
    var(--ck-line);
}


.call-step-list article{
  min-height:155px;

  padding:22px;

  display:grid;

  grid-template-columns:
    34px
    1fr;

  gap:14px;

  border-right:
    1px solid
    var(--ck-line);
}


.call-step-list article:last-child{
  border-right:0;
}


.call-step-list article > span{
  color:var(--ck-accent);

  font-size:11px;
  font-weight:900;
}


.call-step-list h3{
  margin:0 0 7px;

  font-size:20px;
  line-height:1.05;
  letter-spacing:-.035em;
}


.call-step-list p{
  margin:0;

  color:var(--ck-muted);

  font-size:11px;
  line-height:1.45;
}


/* =========================================================
   START
   ========================================================= */

.call-start{
  background:#fbf8f3;
}


.call-start-grid{
  max-width:900px;

  margin:0 auto;

  display:grid;

  grid-template-columns:
    1fr
    1fr;

  gap:12px;
}


.call-start-card{
  min-height:360px;

  padding:28px;

  display:flex;
  flex-direction:column;

  border:
    1px solid
    var(--ck-line);
}


.call-start-free{
  background:
    var(--ck-paper);
}


.call-start-paid{
  border-color:#111;

  background:#111;
  color:#fff;
}


.call-start-label{
  color:var(--ck-accent);

  font-size:9px;
  font-weight:900;
  letter-spacing:.08em;
}


.call-start-card h3{
  margin:14px 0 7px;

  font-size:34px;
  line-height:1;
  letter-spacing:-.05em;
}


.call-start-card div > strong{
  display:block;

  font-size:50px;
  line-height:.95;
  letter-spacing:-.055em;
}


.call-start-card div > small{
  display:block;

  margin-top:6px;

  color:#aaa;

  font-size:9px;
}


.call-start-card > p{
  margin:20px 0;

  color:var(--ck-muted);

  font-size:12px;
  line-height:1.5;
}


.call-start-paid > p{
  color:#bbb;
}


.call-start-card > a,
.call-payment-button{
  min-height:50px;

  margin-top:auto;

  display:flex;
  align-items:center;
  justify-content:center;

  border:0;

  font:inherit;

  font-size:10px;
  font-weight:900;

  cursor:pointer;
}


.call-start-free > a{
  background:var(--ck-green);
  color:#fff;
}


.call-payment-button{
  width:100%;

  background:var(--ck-accent);
  color:#fff;
}


.call-payment-note{
  margin-top:9px;

  color:#888;

  font-size:8px;
  line-height:1.4;

  text-align:center;
}


/* =========================================================
   COMPACT NOTES
   ========================================================= */

.call-compact-notes{
  max-width:900px;

  margin:12px auto 0;

  display:grid;

  grid-template-columns:
    repeat(3,1fr);

  gap:8px;
}


.call-compact-notes > div{
  padding:14px;

  background:#f0ebe4;

  border:
    1px solid
    var(--ck-line);
}


.call-compact-notes strong{
  display:block;

  margin-bottom:5px;

  font-size:10px;
}


.call-compact-notes p{
  margin:0;

  color:var(--ck-muted);

  font-size:9px;
  line-height:1.4;
}


/* =========================================================
   OFFICIAL HELP
   ========================================================= */

.call-official{
  padding:18px 0;

  border:0 !important;

  background:#111;
  color:#fff;
}


.call-official .wrap{
  display:flex;
  align-items:center;

  gap:24px;
}


.call-official span{
  margin-right:auto;

  color:var(--ck-accent);

  font-size:9px;
  font-weight:900;
  letter-spacing:.07em;
}


.call-official strong{
  font-size:10px;
}


/* =========================================================
   MOBILE ACTION BAR
   ========================================================= */

.call-mobile-actions{
  display:none;
}


/* =========================================================
   MOBILE
   ========================================================= */

@media(max-width:850px){

  .call-korea-page{
    padding-bottom:64px;
  }


  /* Emergency */

  .call-emergency-inner{
    min-height:36px;

    padding-top:7px;
    padding-bottom:7px;

    display:grid;

    grid-template-columns:
      auto
      1fr;

    gap:2px 8px;

    font-size:9px;
  }


  .call-emergency-inner small{
    grid-column:
      1 / -1;

    margin:0;

    font-size:7px;
  }


  /* Hero */

  .call-hero{
    padding:
      30px 0
      24px;
  }


  .call-hero-grid{
    display:block;
  }


  .call-hero-summary{
    display:none;
  }


  .call-hero-copy h1{
    margin:
      9px 0
      14px;

    font-size:
      clamp(
        42px,
        12.5vw,
        59px
      );

    line-height:.9;
  }


  .call-hero-copy > p{
    max-width:none;

    font-size:14px;
    line-height:1.45;
  }


  .call-hero-actions{
    margin-top:20px;

    display:grid;

    grid-template-columns:
      1fr;

    gap:8px;
  }


  .call-action{
    min-width:0;
    width:100%;

    min-height:54px;

    padding:
      9px
      15px;
  }


  .call-trust{
    display:grid;

    grid-template-columns:
      repeat(3,1fr);

    gap:4px;

    margin-top:14px;
    padding-top:12px;

    text-align:center;

    font-size:8px;
  }


  .call-trust span::before{
    display:block;

    margin:
      0 0
      3px;
  }


  /* Sections */

  .call-section{
    padding:
      34px 0;
  }


  .call-section-head{
    margin-bottom:15px;

    display:block;
  }


  .call-section-head h2{
    font-size:31px;
  }


  .call-section-head > p{
    margin-top:8px;

    font-size:10px;
  }


  /* Situations */

  .call-situation-list{
    grid-template-columns:
      1fr;

    gap:7px;
  }


  .call-situation{
    min-height:0;

    padding:
      12px 13px;

    grid-template-columns:
      36px
      minmax(0,1fr)
      20px;

    gap:10px;

    align-items:center;

    border-radius:4px;
  }


  .call-situation-icon{
    width:32px;
    height:32px;

    font-size:13px;
  }


  .call-situation h3{
    margin:0;

    font-size:15px;
  }


  .call-situation p{
    display:none;
  }


  .call-situation > strong{
    margin:0;

    justify-self:end;

    font-size:13px;
  }


  /* Send box */

  .call-send-box{
    margin-top:10px;

    padding:16px;

    display:block;
  }


  .call-send-box h3{
    font-size:21px;
  }


  .call-send-options{
    margin:
      14px 0
      12px;
  }


  .call-send-options span{
    padding:
      6px 8px;

    font-size:7px;
  }


  .call-send-box > p{
    font-size:10px;
  }


  /* How */

  .call-step-list{
    grid-template-columns:
      1fr;
  }


  .call-step-list article{
    min-height:0;

    padding:
      15px 4px;

    grid-template-columns:
      28px
      1fr;

    border-right:0;

    border-bottom:
      1px solid
      var(--ck-line);
  }


  .call-step-list article:last-child{
    border-bottom:0;
  }


  .call-step-list h3{
    font-size:16px;
  }


  .call-step-list p{
    font-size:10px;
  }


  /* Start */

  .call-start-grid{
    grid-template-columns:
      1fr;

    gap:8px;
  }


  .call-start-card{
    min-height:0;

    padding:18px;
  }


  .call-start-card h3{
    margin:
      9px 0
      5px;

    font-size:25px;
  }


  .call-start-card div > strong{
    font-size:37px;
  }


  .call-start-card > p{
    margin:
      12px 0
      15px;

    font-size:10px;
  }


  .call-start-card > a,
  .call-payment-button{
    min-height:46px;
  }


  .call-compact-notes{
    grid-template-columns:
      1fr 1fr;

    gap:7px;
  }


  .call-compact-notes > div:first-child{
    grid-column:
      1 / -1;

    background:#fff0ee;
  }


  .call-compact-notes > div{
    padding:11px;
  }


  /* Official */

  .call-official{
    padding:
      14px 0;
  }


  .call-official .wrap{
    display:grid;

    grid-template-columns:
      1fr 1fr;

    gap:
      5px 10px;
  }


  .call-official span{
    grid-column:
      1 / -1;

    margin:
      0 0 2px;
  }


  .call-official strong{
    font-size:8px;
  }


  /* Fixed CTA */

  .call-mobile-actions{
    position:fixed;

    z-index:120;

    left:0;
    right:0;
    bottom:0;

    display:grid;

    grid-template-columns:
      1fr
      1.15fr;

    gap:6px;

    padding:
      7px
      max(
        10px,
        env(safe-area-inset-right)
      )
      calc(
        7px +
        env(safe-area-inset-bottom)
      )
      max(
        10px,
        env(safe-area-inset-left)
      );

    background:
      rgba(
        255,
        253,
        250,
        .95
      );

    border-top:
      1px solid
      rgba(0,0,0,.1);

    backdrop-filter:
      blur(12px);

    transition:
      transform .2s ease,
      opacity .2s ease;
  }


  .call-mobile-actions.is-hidden{
    transform:
      translateY(
        calc(
          100% +
          12px
        )
      );

    opacity:0;

    pointer-events:none;
  }


  .call-mobile-actions a{
    min-height:42px;

    display:flex;
    align-items:center;
    justify-content:center;

    border-radius:4px;

    font-size:9px;
    font-weight:900;

    text-align:center;
  }


  .call-mobile-free{
    background:var(--ck-green);
    color:#fff;
  }


  .call-mobile-paid{
    background:#111;
    color:#fff;
  }

}


/* =========================================================
   SMALL PHONES
   ========================================================= */

@media(max-width:420px){

  .call-hero-copy h1{
    font-size:
      clamp(
        39px,
        12vw,
        50px
      );
  }


  .call-trust{
    font-size:7px;
  }


  .call-compact-notes{
    grid-template-columns:
      1fr;
  }


  .call-compact-notes > div:first-child{
    grid-column:auto;
  }

}
