    const missionPlans={
      travel:{title:'Use Korean before you arrive',copy:'Open a Korean restaurant menu. Read 3 items aloud, choose one, and say “이거 주세요” without looking at a translation.'},
      life:{title:'Solve one daily-life task in Korean',copy:'Write or say one short request for an appointment, delivery, store or service you actually use.'},
      work:{title:'Give a 30-second work introduction',copy:'Introduce yourself, your role and one thing you need from a coworker. Say it once without reading.'},
      social:{title:'Answer 3 casual questions aloud',copy:'Practice your name, where you are from, what you do and what you like — without building the answer in English first.'},
      topik:{title:'Do 10 official-style questions',copy:'Complete 10 questions, then write down the 3 mistakes that repeated. Those mistakes decide what you study next.'},
      culture:{title:'Watch 30 seconds without subtitles',copy:'Choose a short Korean clip. Watch once without subtitles and write down 3 words or expressions you recognize.'}
    };

    function track(name,params={}){
      if(typeof window!=='undefined'&&typeof window.gtag==='function')window.gtag('event',name,params);
    }

    const recommendedEventKeys=new Set();

    function verificationStatus(value,{creatorLabel=false}={}){
      if(value===true)return'✓';
      if(value===false)return creatorLabel?'Creator':'No';
      return'Limited';
    }

    function confidenceLabel(value){return`${String(value||'low').toUpperCase()} CONFIDENCE`;}

    function setText(id,value){const element=document.getElementById(id);if(element)element.textContent=value||'';}

    function updateProgress(step){
      const index=Math.max(0,stepOrder.indexOf(step));
      setText('learn-progress-text',`${index+1} / ${stepOrder.length}`);
      const bar=document.getElementById('learn-progress-bar');
      if(bar)bar.style.width=`${((index+1)/stepOrder.length)*100}%`;
    }

    function currentOpenStep(){
      return stepOrder.find((step)=>document.querySelector(`[data-plan-step="${step}"]`)?.classList.contains('is-open'))||'context';
    }
    function getContextConfig(){return contextConfig[selections.goal]||contextConfig.travel;}
    function getContextLabel(value=selections.context){const option=getContextConfig().options.find(([key])=>key===value);return option?option[1]:'';}

    function renderContextQuestion(){
      const config=getContextConfig();
      setText('learn-context-title',config.title);
      setText('learn-context-help',config.help);
      const container=document.getElementById('learn-context-options');
      if(!container)return;
      container.innerHTML=config.options.map(([value,label])=>`<button type="button" data-plan-option data-step="context" data-value="${value}">${label}</button>`).join('');
    }

    function summaryLabel(step,value){if(step==='context')return getContextLabel(value);return labels[step]?.[value]||value;}

    function resetStepsAfter(step){
      const currentIndex=stepOrder.indexOf(step);
      stepOrder.forEach((name,index)=>{
        if(index<=currentIndex)return;
        selections[name]=null;
        const stepElement=document.querySelector(`[data-plan-step="${name}"]`);
        const options=document.querySelector(`[data-options="${name}"]`);
        const complete=document.querySelector(`[data-complete="${name}"]`);
        stepElement?.setAttribute('hidden','');
        stepElement?.classList.remove('is-open','is-complete');
        options?.removeAttribute('hidden');
        complete?.setAttribute('hidden','');
        stepElement?.querySelectorAll('[data-plan-option]').forEach((button)=>button.classList.remove('is-selected'));
      });
      document.getElementById('learn-plan-action')?.setAttribute('hidden','');
      document.getElementById('korean-plan-result')?.setAttribute('hidden','');
    }

    function revealNextStep(step){
      const index=stepOrder.indexOf(step);
      const nextStep=stepOrder[index+1];
      if(!nextStep){document.getElementById('learn-plan-action')?.removeAttribute('hidden');updateProgress(step);return;}
      if(nextStep==='context')renderContextQuestion();
      const nextElement=document.querySelector(`[data-plan-step="${nextStep}"]`);
      nextElement?.removeAttribute('hidden');
      nextElement?.classList.add('is-open');
      updateProgress(nextStep);
      if(!restoringPlan)setTimeout(()=>nextElement?.scrollIntoView({behavior:'smooth',block:'center'}),120);
    }

    function completeStep(step,value){
      selections[step]=value;
      if(step==='goal')selections.context=null;
      resetStepsAfter(step);
      const stepElement=document.querySelector(`[data-plan-step="${step}"]`);
      const options=document.querySelector(`[data-options="${step}"]`);
      const complete=document.querySelector(`[data-complete="${step}"]`);
      const summary=document.querySelector(`[data-summary="${step}"]`);
      stepElement?.querySelectorAll('[data-plan-option]').forEach((button)=>button.classList.toggle('is-selected',button.dataset.value===value));
      if(summary)summary.textContent=summaryLabel(step,value);
      options?.setAttribute('hidden','');
      complete?.removeAttribute('hidden');
      stepElement?.classList.remove('is-open');
      stepElement?.classList.add('is-complete');
      revealNextStep(step);
    }

    document.addEventListener('click',(event)=>{
      const optionButton=event.target.closest('[data-plan-option]');
      if(!optionButton)return;
      const step=optionButton.dataset.step;
      const value=optionButton.dataset.value;
      if(!step||!value)return;
      if(!selections.goal)track('plan_started');
      const hadCompletePlan=allSelected();
      if(hadCompletePlan){completedPhases.one=false;completedPhases.two=false;completedPhases.three=false;resourceProfileKey='';}
      completeStep(step,value);
    });

    document.querySelectorAll('[data-change-step]').forEach((button)=>{
      button.addEventListener('click',()=>{
        const step=button.dataset.changeStep;
        resetStepsAfter(step);
        selections[step]=null;
        if(step==='context')renderContextQuestion();
        const stepElement=document.querySelector(`[data-plan-step="${step}"]`);
        const options=document.querySelector(`[data-options="${step}"]`);
        const complete=document.querySelector(`[data-complete="${step}"]`);
        stepElement?.classList.remove('is-complete');
        stepElement?.classList.add('is-open');
        updateProgress(step);
        options?.removeAttribute('hidden');
        complete?.setAttribute('hidden','');
        stepElement?.scrollIntoView({behavior:'smooth',block:'center'});
      });
    });

    function allSelected(){return stepOrder.every((step)=>selections[step]);}

    function planLength(){
      if(selections.goal==='travel'&&selections.context==='urgent')return'14-Day Korea Survival Plan';
      if(selections.goal==='travel'&&selections.context==='month')return'30-Day Korea Travel Plan';
      if(selections.goal==='topik'&&selections.context==='urgent')return'30-Day TOPIK Sprint';
      if(selections.goal==='travel')return'Travel Korean Path';
      if(selections.goal==='topik')return'TOPIK Preparation Path';
      if(selections.goal==='work')return'Workplace Korean Path';
      if(selections.goal==='life')return'Everyday Korean Path';
      if(selections.goal==='social')return'Social Korean Path';
      if(selections.goal==='culture')return'Korean Listening & Culture Path';
      return'Korean Starter Path';
    }

    function whyNow(){
      const context=getContextLabel();
      if(selections.level==='unsure')return`You’re not sure about your level, so we’re starting with a safer option and adjusting after your feedback.`;
      if(selections.goal==='travel'&&selections.context==='urgent')return`You’re travelling soon, so we’re focusing on real situations you’re likely to use.`;
      if(selections.goal==='topik'&&selections.context==='urgent')return`Your test is soon, so we’re prioritizing official-style practice and repeat mistakes.`;
      return`This fits your ${labels.level[selections.level].toLowerCase()} level and your current priority: ${context}.`;
    }

    function useUtilityFirst(){return selections.context==='urgent'&&selections.goal==='travel';}

    function levelEligible(resource){
      if(selections.level==='unsure')return resource.safeForUnsure===true;
      return resource.levels.includes(selections.level);
    }

    function goalEligible(resource){return resource.goals.includes(selections.goal)||resource.goals.includes('all');}

    function verificationEligible(resource){
      const verification=resource.verification||{};
      if(verification.freeAccessChecked===false)return false;
      if(verification.levelFitChecked===false)return false;
      if(verification.practicalFitChecked===false)return false;
      if(verification.confidence==='low')return false;
      return true;
    }

    function isResourceEligible(resource,role){
      if(!resource.roles.includes(role))return false;
      if(!levelEligible(resource))return false;
      if(!goalEligible(resource))return false;
      if(!verificationEligible(resource))return false;
      return true;
    }

    function scoreResource(resource,role){
      if(!isResourceEligible(resource,role))return-9999;
      const verification=resource.verification||{};
      let score=Math.round((resource.priority||0)/10);
      if(resource.goals.includes(selections.goal))score+=24;else if(resource.goals.includes('all'))score+=7;
      if(resource.contexts?.includes(selections.context))score+=38;else if(resource.contexts?.includes('all'))score+=8;
      if(resource.skills.includes(selections.focus))score+=18;else if(resource.skills.includes('all'))score+=6;
      if(selections.time==='10'&&resource.shortFriendly)score+=8;
      if(selections.context==='urgent'&&resource.urgentFriendly)score+=12;
      if(verification.practicalFitChecked===true)score+=5;
      if(verification.officialChecked===true)score+=2;
      if(verification.confidence==='high')score+=8;else if(verification.confidence==='medium')score+=4;
      if(verification.freeAccessChecked==='unknown')score-=4;
      if(verification.levelFitChecked==='unknown')score-=4;
      return score;
    }

    function rankResources(role,excludeIds=[]){
      return resources
        .filter((resource)=>!excludeIds.includes(resource.id))
        .filter((resource)=>isResourceEligible(resource,role))
        .map((resource)=>({resource,score:scoreResource(resource,role)}))
        .sort((a,b)=>b.score-a.score)
        .map((item)=>item.resource);
    }

    function rankWithFallback(role,excludeIds=[]){
      const unique=rankResources(role,excludeIds);
      return unique.length?unique:rankResources(role);
    }

    function getResourceProfileKey(){return stepOrder.map((step)=>selections[step]||'').join('|');}

    function buildResourceState({force=false}={}){
      const nextKey=getResourceProfileKey();
      if(!force&&resourceProfileKey===nextKey&&resourceState.one.length&&resourceState.two.length&&resourceState.three.length)return;
      const utilityFirst=useUtilityFirst();
      const phaseOneRole=utilityFirst?'goal':'foundation';
      const phaseTwoRole=utilityFirst?'foundation':'goal';
      resourceState.one=rankWithFallback(phaseOneRole);
      const oneId=resourceState.one[0]?.id;
      resourceState.two=rankWithFallback(phaseTwoRole,oneId?[oneId]:[]);
      const twoId=resourceState.two[0]?.id;
      resourceState.three=rankWithFallback('practice',[oneId,twoId].filter(Boolean));
      currentResourceIndex.one=0;currentResourceIndex.two=0;currentResourceIndex.three=0;
      resourceProfileKey=nextKey;
    }

    function currentResource(phase){const list=resourceState[phase]||[];return list[currentResourceIndex[phase]%Math.max(list.length,1)];}

    function resourceReason(resource){
      let reason=resource.reason;
      if(resource.contexts?.includes(selections.context))reason+=` It directly matches your selected context: ${getContextLabel()}.`;
      if(selections.time==='10'&&resource.shortFriendly)reason+=' It also works well when your daily study window is short.';
      if(selections.context==='urgent'&&resource.urgentFriendly)reason+=' It is especially useful when you need practical results quickly.';
      if(selections.level==='unsure')reason+=' We selected only resources marked safe for learners who are unsure of their level.';
      return reason;
    }

    function resourceCta(resource){if(resource.type==='video'||resource.type==='video course')return'WATCH FREE →';if(resource.type==='official practice')return'OPEN OFFICIAL PRACTICE →';return'OPEN FREE RESOURCE →';}

    function renderResource(phase){
      const resource=currentResource(phase);if(!resource)return;
      const verification=resource.verification||{};
      setText(`phase-${phase}-provider`,resource.provider);
      setText(`phase-${phase}-resource-title`,resource.title);
      setText(`phase-${phase}-resource-reason`,resourceReason(resource));
      setText(`phase-${phase}-best-for`,`Best for: ${resource.bestFor}`);
      setText(`phase-${phase}-checked`,verification.lastChecked?`Last checked: ${verification.lastChecked}`:'');
      setText(`phase-${phase}-not-for`,resource.notFor);
      setText(`phase-${phase}-confidence`,confidenceLabel(verification.confidence));
      setText(`phase-${phase}-check-official`,verificationStatus(verification.officialChecked,{creatorLabel:true}));
      setText(`phase-${phase}-check-free`,verificationStatus(verification.freeAccessChecked));
      setText(`phase-${phase}-check-level`,verificationStatus(verification.levelFitChecked));
      setText(`phase-${phase}-check-independent`,String(verification.independentEvidence||'unknown').replace(/^./,(char)=>char.toUpperCase()));
      setText(`phase-${phase}-last-checked`,verification.lastChecked?`Last checked ${verification.lastChecked}`:'');
      const link=document.getElementById(`phase-${phase}-resource-link`);
      if(link){link.href=resource.url;link.textContent=resourceCta(resource);link.dataset.resourceId=resource.id;}
      const alt=document.querySelector(`[data-alt-resource="${phase}"]`);
      if(alt)alt.hidden=resourceState[phase].length<2;
      const recommendationKey=`${phase}:${resource.id}:${selections.goal}:${selections.level}:${selections.context}`;
      if(!recommendedEventKeys.has(recommendationKey)){
        recommendedEventKeys.add(recommendationKey);
        track('resource_recommended',{phase,resource_id:resource.id,goal:selections.goal,level:selections.level,context:selections.context,confidence:verification.confidence||'unknown'});
      }
    }

    function todaySteps(resource){
      const focusPractice=focusPlans[selections.focus].practice;
      if(resource?.id==='go-billy-hangul'){
        if(selections.time==='10')return['Watch only 0:00–6:55 today.','Write the first consonants and vowels once.','Read 5 syllable blocks aloud without romanization.'];
        if(selections.time==='30')return['Watch 0:00–26:00.','Pause and write each new letter once.','Read 10 syllable blocks aloud without romanization.'];
        return['Work through the lesson in one focused block or two shorter blocks.','Write unfamiliar letters and sound changes as you go.','Finish by reading 10 Korean words without romanization.'];
      }
      if(resource?.id==='small-talk-travel'){
        if(selections.time==='10')return['Watch the first airport conversation in slow and normal speed.','Choose 3 phrases you would actually use.','Say those 3 phrases once without looking.'];
        return['Watch one or two travel situations.','Repeat 5 useful lines aloud.','Replay one section at normal speed without subtitles.'];
      }
      return[selections.time==='10'?'Complete one short section only.':'Complete one focused lesson or section.',focusPractice,'Stop when your planned study time is finished — do not open another resource.'];
    }

    function renderToday(){
      const resource=currentResource('one');if(!resource)return;
      setText('learn-today-title',resource.title);
      setText('learn-today-provider',resource.provider);
      setText('learn-today-duration',timePlans[selections.time].today);
      const steps=todaySteps(resource);
      setText('learn-today-step-one',steps[0]);setText('learn-today-step-two',steps[1]);setText('learn-today-step-three',steps[2]);
      const link=document.getElementById('learn-today-link');if(link){link.href=resource.url;link.dataset.resourceId=resource.id;}
      const sticky=document.getElementById('learn-mobile-sticky');if(sticky){sticky.href=resource.url;sticky.dataset.resourceId=resource.id;}
      setText('learn-mobile-sticky-time',timePlans[selections.time].today);
    }

    function renderPhaseCopy(){
      const utilityFirst=useUtilityFirst();
      const level=levelPlans[selections.level];
      const goal=goalPlans[selections.goal];
      if(utilityFirst){
        setText('phase-one-purpose','SURVIVAL FIRST');setText('phase-one-title',goal.goalTitle);setText('phase-one-copy',goal.goalCopy);
        setText('phase-two-purpose','FOUNDATION');setText('phase-two-title',level.foundationTitle);setText('phase-two-copy',level.foundationCopy);
      }else{
        setText('phase-one-purpose','FOUNDATION');setText('phase-one-title',level.foundationTitle);setText('phase-one-copy',level.foundationCopy);
        setText('phase-two-purpose','YOUR GOAL');setText('phase-two-title',goal.goalTitle);setText('phase-two-copy',goal.goalCopy);
      }
      setText('phase-three-title',goal.practiceTitle);
      setText('phase-three-copy',`${goal.practiceCopy} ${focusPlans[selections.focus].practice}`);
      ['one','two','three'].forEach((phase)=>setText(`phase-${phase}-time`,timePlans[selections.time].pace));
    }


    function phaseLabel(phase){
      if(phase==='one')return selections.goal==='travel'&&selections.context==='urgent'?'SURVIVAL FIRST':'FOUNDATION';
      if(phase==='two')return selections.goal==='travel'&&selections.context==='urgent'?'FOUNDATION':'YOUR GOAL';
      return'PRACTICE';
    }

    function updatePhaseStates(){
      const phases=['one','two','three'];
      const firstIncomplete=phases.find((phase)=>!completedPhases[phase])||null;
      phases.forEach((phase)=>{
        const isDone=completedPhases[phase];
        const status=isDone?'COMPLETED':phase===firstIncomplete?'CURRENT':'NEXT';
        setText(`phase-${phase}-status`,`${status} · ${phaseLabel(phase)}`);
        const details=document.querySelector(`[data-phase-details="${phase}"]`);
        if(details)details.classList.toggle('is-completed',isDone);
      });
    }

    function openPhase(phase){
      document.querySelectorAll('[data-phase-details]').forEach((details)=>{details.open=details.dataset.phaseDetails===phase;});
      document.querySelector(`[data-phase-details="${phase}"]`)?.scrollIntoView({behavior:'smooth',block:'center'});
    }

    document.querySelectorAll('[data-phase-details]').forEach((details)=>{
      details.addEventListener('toggle',()=>{
        if(!details.open)return;
        document.querySelectorAll('[data-phase-details]').forEach((other)=>{if(other!==details)other.open=false;});
      });
    });

    function renderMission(){const mission=missionPlans[selections.goal];setText('learn-mission-title',mission.title);setText('learn-mission-copy',mission.copy);setText('learn-mission-status','');}

    function renderFinal(){
      const finalLink=document.getElementById('learn-final-link');
      if(selections.goal==='topik'){
        setText('learn-final-purpose','OFFICIAL PRACTICE CHECK');
        setText('learn-final-title','Test your current TOPIK level.');
        setText('learn-final-copy','Use official TOPIK practice, review what you missed, and let those mistakes decide the next study block.');
        if(finalLink){finalLink.href='https://www.topik.go.kr/';finalLink.target='_blank';finalLink.rel='noopener noreferrer';finalLink.textContent='OPEN OFFICIAL TOPIK PRACTICE →';}
      }else{
        setText('learn-final-purpose','REAL-LIFE TEST');
        setText('learn-final-title','See if you can actually use it.');
        setText('learn-final-copy','Practice the situations you studied with a Korean tutor and get feedback on speaking, listening and response speed.');
        if(finalLink){finalLink.href='#tutor';finalLink.removeAttribute('target');finalLink.removeAttribute('rel');finalLink.textContent='TAKE MY REAL-LIFE TEST →';}
      }
    }

    function renderPlan({scroll=true}={}){
      if(!allSelected()){setText('learn-plan-message','Please complete all five steps first.');return false;}
      buildResourceState();
      setText('learn-result-title',planLength());
      setText('learn-result-profile',`${labels.goal[selections.goal]} · ${labels.level[selections.level]} · ${labels.time[selections.time]}`);
      setText('learn-plan-target',goalPlans[selections.goal].target);
      setText('learn-plan-commitment',timePlans[selections.time].commitment);
      setText('learn-plan-focus',focusPlans[selections.focus].strategy);
      setText('learn-plan-skip',goalPlans[selections.goal].skip);
      setText('learn-why-now-copy',whyNow());
      renderPhaseCopy();['one','two','three'].forEach(renderResource);renderToday();renderMission();renderFinal();updatePhaseStates();
      document.getElementById('korean-plan-result')?.removeAttribute('hidden');
      setText('learn-plan-message','');
      saveState(false);
      track('plan_completed',{goal:selections.goal,level:selections.level,time:selections.time,focus:selections.focus,context:selections.context});
      if(scroll)document.getElementById('korean-plan-result')?.scrollIntoView({behavior:'smooth',block:'start'});
      return true;
    }

    document.getElementById('generate-korean-plan')?.addEventListener('click',()=>{
      if(!allSelected()){setText('learn-plan-message','Please complete all five steps first.');return;}
      setText('learn-plan-message','Finding your next lesson...');
      setTimeout(()=>renderPlan(),350);
    });

    document.querySelectorAll('[data-alt-resource]').forEach((button)=>{
      button.addEventListener('click',()=>{
        const phase=button.dataset.altResource;const list=resourceState[phase]||[];if(list.length<2)return;
        currentResourceIndex[phase]=(currentResourceIndex[phase]+1)%list.length;renderResource(phase);if(phase==='one')renderToday();
        saveState(false);
        const resource=currentResource(phase);track('resource_alternative_selected',{phase,resource_id:resource?.id||''});
      });
    });

    document.querySelectorAll('[data-resource-complete]').forEach((button)=>{
      button.addEventListener('click',()=>{
        const phase=button.dataset.resourceComplete;document.querySelector(`[data-difficulty-panel="${phase}"]`)?.removeAttribute('hidden');
        const resource=currentResource(phase);track('resource_completed',{phase,resource_id:resource?.id||''});
      });
    });

    function adaptNextResource(phase,value){
      const nextPhase=phase==='one'?'two':phase==='two'?'three':null;
      if(!nextPhase||value==='right')return false;
      const list=resourceState[nextPhase]||[];
      const current=currentResource(nextPhase);
      if(!current||!list.length)return false;
      const desired=value==='easy'
        ? list.findIndex((item)=>item.difficulty>current.difficulty)
        : list.findIndex((item)=>item.difficulty<current.difficulty);
      if(desired<0)return false;
      currentResourceIndex[nextPhase]=desired;
      renderResource(nextPhase);
      return true;
    }

    document.querySelectorAll('[data-difficulty]').forEach((button)=>{
      button.addEventListener('click',()=>{
        const phase=button.dataset.phase;const value=button.dataset.difficulty;const resource=currentResource(phase);
        feedback[phase]={resourceId:resource?.id||'',difficulty:value};
        const adjusted=adaptNextResource(phase,value);
        const note=document.querySelector(`[data-adaptation-note="${phase}"]`);
        if(note){
          note.textContent=value==='easy'
            ? adjusted?'Got it. We made the next recommendation more challenging.':'Got it. We saved this feedback for your next recommendation.'
            : value==='hard'
              ? adjusted?'Got it. We made the next recommendation simpler.':'Got it. We saved this feedback for your next recommendation.'
              : 'Good. We’ll keep the next recommendation around this difficulty.';
        }
        completedPhases[phase]=true;
        updatePhaseStates();
        const nextPhase=phase==='one'?'two':phase==='two'?'three':null;
        saveState(false);
        if(nextPhase)setTimeout(()=>openPhase(nextPhase),220);
        track(value==='easy'?'resource_too_easy':value==='hard'?'resource_too_hard':'resource_just_right',{phase,resource_id:resource?.id||'',adjusted});
      });
    });

    document.querySelectorAll('[data-resource-link]').forEach((link)=>{
      link.addEventListener('click',()=>{
        const phase=link.dataset.resourceLink;const resource=phase==='today'?currentResource('one'):currentResource(phase);
        track('resource_clicked',{phase,resource_id:resource?.id||'',provider:resource?.provider||''});
      });
    });

    document.getElementById('complete-mission')?.addEventListener('click',()=>{
      setText('learn-mission-status','Mission complete. Your next step is the final test or practice check.');saveState(false);track('mission_completed',{goal:selections.goal});
    });

    function saveState(showMessage=true){
      localStorage.setItem(STORAGE_KEY,JSON.stringify({selections,feedback,completedPhases,currentResourceIndex}));
      if(showMessage)setText('learn-plan-message','Saved.');
    }

    document.getElementById('save-korean-plan')?.addEventListener('click',()=>{if(!renderPlan({scroll:false}))return;saveState(true);});

    document.getElementById('share-korean-plan')?.addEventListener('click',async()=>{
      if(!renderPlan({scroll:false}))return;
      const url=new URL(window.location.href);stepOrder.forEach((step)=>url.searchParams.set(step,selections[step]));url.hash='korean-plan-result';
      const shareData={title:'My Korean Study Path — Seen in Korea',text:'Here is my personalized Korean study path.',url:url.toString()};
      try{if(navigator.share){await navigator.share(shareData);}else if(navigator.clipboard){await navigator.clipboard.writeText(url.toString());setText('learn-plan-message','Share link copied.');}else{window.prompt('Copy this link:',url.toString());}}catch(error){if(error?.name!=='AbortError')setText('learn-plan-message','Could not share automatically.');}
    });

    document.getElementById('print-korean-plan')?.addEventListener('click',()=>{if(!renderPlan({scroll:false}))return;window.print();});
    document.querySelectorAll('[data-test-booking]').forEach((link)=>link.addEventListener('click',()=>track('real_life_test_clicked',{goal:selections.goal||''})));

    function restorePlan(values,{source='unknown'}={}){
      if(!values?.goal||!labels.goal[values.goal])return false;
      selections.goal=values.goal;renderContextQuestion();
      const valid=stepOrder.every((step)=>step==='context'?contextConfig[values.goal]?.options.some(([key])=>key===values[step]):Boolean(labels[step]?.[values[step]]));
      if(!valid){selections.goal=null;return false;}
      restoringPlan=true;stepOrder.forEach((step)=>{if(step==='context')renderContextQuestion();completeStep(step,values[step]);});restoringPlan=false;renderPlan({scroll:false});
      track('plan_restored',{source,goal:values.goal,level:values.level||'',context:values.context||''});
      return true;
    }

    function restoreLegacyPartial(values){
      const required=['goal','level','time','focus'];
      const valid=required.every((step)=>Boolean(labels[step]?.[values?.[step]]));
      if(!valid)return false;
      restoringPlan=true;
      required.forEach((step)=>completeStep(step,values[step]));
      restoringPlan=false;
      selections.context=null;
      renderContextQuestion();
      const contextStep=document.querySelector('[data-plan-step="context"]');
      contextStep?.removeAttribute('hidden');
      contextStep?.classList.add('is-open');
      setText('learn-plan-message','Your saved answers were restored. Choose one final context to rebuild your path.');
      track('plan_restored',{source:'legacy_partial',goal:values.goal,level:values.level});
      return true;
    }

    document.getElementById('learn-return-continue')?.addEventListener('click',()=>{
      const firstIncomplete=['one','two','three'].find((phase)=>!completedPhases[phase]);
      if(firstIncomplete)openPhase(firstIncomplete);
      else document.getElementById('learn-today-card')?.scrollIntoView({behavior:'smooth',block:'start'});
    });

    updateProgress('goal');

    const params=new URLSearchParams(window.location.search);const queryValues={};stepOrder.forEach((step)=>{queryValues[step]=params.get(step);});
    const restoredFromUrl=restorePlan(queryValues,{source:'url'});
    let restoredFromStorage=false;
    if(!restoredFromUrl){
      try{
        const saved=JSON.parse(localStorage.getItem(STORAGE_KEY)||'null');
        if(saved?.selections){
          Object.assign(feedback,saved.feedback||{});
          Object.assign(completedPhases,saved.completedPhases||{});
          restoredFromStorage=restorePlan(saved.selections,{source:'localStorage'});
          if(restoredFromStorage){
            if(saved.currentResourceIndex)Object.assign(currentResourceIndex,saved.currentResourceIndex);
            ['one','two','three'].forEach(renderResource);renderToday();updatePhaseStates();
            const banner=document.getElementById('learn-return-banner');
            banner?.removeAttribute('hidden');
          }
        }
      }catch(error){localStorage.removeItem(STORAGE_KEY);}
    }
    if(!restoredFromUrl&&!restoredFromStorage){
      try{
        const legacy=JSON.parse(localStorage.getItem('sik-korean-plan-v1')||'null');
        if(legacy)restoreLegacyPartial(legacy.selections||legacy);
      }catch(error){}
    }
  </script>

</BaseLayout>
