---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Learn Korean for Real Life | SEEN IN KOREA"
  description="Get a personalized Korean study plan, curated free learning resources, and real-life speaking practice with a Korean tutor."
>
  <main class="learn-page">

    <!-- HERO -->
    <section class="learn-hero">
      <div class="wrap learn-hero-grid">

        <div class="learn-hero-copy">
          <div class="eyebrow">LEARN KOREAN</div>

          <h1>
            Korean for<br />
            real life.
          </h1>

          <p class="learn-hero-dek">
            Get a personalized study plan, curated free resources
            and live speaking practice — so you can actually use
            Korean in everyday life.
          </p>

          <div class="learn-hero-actions">
            <a href="#study-plan" class="learn-btn learn-btn-primary">
              BUILD MY FREE STUDY PLAN →
            </a>

            <a href="#tutor" class="learn-btn learn-btn-secondary">
              TRY A 1:1 LESSON →
            </a>
          </div>

          <div class="learn-trust-row">
            <span>Personalized for your goals</span>
            <span>Curated free resources</span>
            <span>Real conversation practice</span>
          </div>
        </div>

        <div class="learn-phrase-card">
          <div class="learn-phrase-label">USE THIS TODAY</div>

          <strong class="learn-phrase-ko">
            이거 주세요.
          </strong>

          <div class="learn-phrase-roman">
            I-geo ju-se-yo.
          </div>

          <div class="learn-phrase-en">
            “This one, please.”
          </div>

          <div class="learn-phrase-rule"></div>

          <p>
            Use it when pointing to something you want
            to order or buy.
          </p>
        </div>

      </div>
    </section>


    <!-- PERSONALIZED STUDY PLAN -->
    <section
      id="study-plan"
      class="learn-plan-section"
    >
      <div class="wrap">

        <div class="section-head">
          <div>
            <div class="eyebrow">FREE KOREAN STUDY PLAN</div>
            <h2>Tell us about you.</h2>
          </div>

          <p>
            Answer one question at a time.
            We’ll build a starting plan around your goal,
            level, available time and learning priority.
          </p>
        </div>


        <div class="learn-plan-builder learn-plan-progressive">

          <!-- STEP 1 -->
          <div
            class="learn-question is-open"
            data-plan-step="goal"
          >
            <div class="learn-question-top">
              <div class="learn-question-number">01</div>

              <div>
                <h3>Your goal</h3>
                <p>Why do you want to learn Korean?</p>
              </div>
            </div>

            <div
              class="learn-question-options"
              data-options="goal"
            >
              <div class="learn-option-grid">

                <button type="button" data-goal="travel">
                  Travel
                </button>

                <button type="button" data-goal="life">
                  Live in Korea
                </button>

                <button type="button" data-goal="work">
                  Work / Business
                </button>

                <button type="button" data-goal="social">
                  Friends / Dating
                </button>

                <button type="button" data-goal="topik">
                  TOPIK
                </button>

                <button type="button" data-goal="culture">
                  K-pop / Drama
                </button>

              </div>
            </div>

            <div
              class="learn-step-complete"
              data-complete="goal"
              hidden
            >
              <span>
                ✓ <strong data-summary="goal"></strong>
              </span>

              <button
                type="button"
                data-change-step="goal"
              >
                CHANGE
              </button>
            </div>
          </div>


          <!-- STEP 2 -->
          <div
            class="learn-question"
            data-plan-step="level"
            hidden
          >
            <div class="learn-question-top">
              <div class="learn-question-number">02</div>

              <div>
                <h3>Your level</h3>
                <p>What’s your current Korean level?</p>
              </div>
            </div>

            <div
              class="learn-question-options"
              data-options="level"
            >
              <div class="learn-option-grid">

                <button type="button" data-level="zero">
                  Complete beginner
                </button>

                <button type="button" data-level="beginner">
                  Beginner
                </button>

                <button type="button" data-level="intermediate">
                  Intermediate
                </button>

                <button type="button" data-level="advanced">
                  Advanced
                </button>

              </div>
            </div>

            <div
              class="learn-step-complete"
              data-complete="level"
              hidden
            >
              <span>
                ✓ <strong data-summary="level"></strong>
              </span>

              <button
                type="button"
                data-change-step="level"
              >
                CHANGE
              </button>
            </div>
          </div>


          <!-- STEP 3 -->
          <div
            class="learn-question"
            data-plan-step="time"
            hidden
          >
            <div class="learn-question-top">
              <div class="learn-question-number">03</div>

              <div>
                <h3>Your time</h3>
                <p>How much time can you realistically study?</p>
              </div>
            </div>

            <div
              class="learn-question-options"
              data-options="time"
            >
              <div class="learn-option-grid">

                <button type="button" data-time="10">
                  10 min / day
                </button>

                <button type="button" data-time="30">
                  30 min / day
                </button>

                <button type="button" data-time="60">
                  1 hour / day
                </button>

                <button type="button" data-time="weekend">
                  A few hours / week
                </button>

              </div>
            </div>

            <div
              class="learn-step-complete"
              data-complete="time"
              hidden
            >
              <span>
                ✓ <strong data-summary="time"></strong>
              </span>

              <button
                type="button"
                data-change-step="time"
              >
                CHANGE
              </button>
            </div>
          </div>


          <!-- STEP 4 -->
          <div
            class="learn-question"
            data-plan-step="focus"
            hidden
          >
            <div class="learn-question-top">
              <div class="learn-question-number">04</div>

              <div>
                <h3>Your priority</h3>
                <p>What do you want the most help with?</p>
              </div>
            </div>

            <div
              class="learn-question-options"
              data-options="focus"
            >
              <div class="learn-option-grid">

                <button type="button" data-focus="speaking">
                  Speaking
                </button>

                <button type="button" data-focus="listening">
                  Listening
                </button>

                <button type="button" data-focus="reading">
                  Reading
                </button>

                <button type="button" data-focus="writing">
                  Writing
                </button>

                <button type="button" data-focus="unsure">
                  I’m not sure
                </button>

              </div>
            </div>

            <div
              class="learn-step-complete"
              data-complete="focus"
              hidden
            >
              <span>
                ✓ <strong data-summary="focus"></strong>
              </span>

              <button
                type="button"
                data-change-step="focus"
              >
                CHANGE
              </button>
            </div>
          </div>

        </div>


        <div
          class="learn-plan-action"
          id="learn-plan-action"
          hidden
        >
          <button
            id="generate-korean-plan"
            type="button"
            class="learn-btn learn-btn-primary"
          >
            BUILD MY KOREAN PLAN →
          </button>

          <p id="learn-plan-message">
            Your answers are ready.
          </p>
        </div>


        <!-- GENERATED RESULT -->
        <div
          id="korean-plan-result"
          class="learn-plan-result"
          hidden
        >
          <div class="learn-result-head">
            <div>
              <div class="eyebrow">YOUR PERSONALIZED PLAN</div>
              <h2>Your first 4 weeks.</h2>
            </div>

            <span id="learn-result-profile"></span>
          </div>


          <div
            class="learn-result-actions"
            aria-label="Plan actions"
          >
            <button
              type="button"
              id="save-korean-plan"
            >
              SAVE PLAN
            </button>

            <button
              type="button"
              id="share-korean-plan"
            >
              SHARE PLAN
            </button>

            <button
              type="button"
              id="print-korean-plan"
            >
              PRINT / PDF
            </button>
          </div>


          <div class="learn-plan-summary">

            <div class="learn-plan-summary-item">
              <small>YOUR TARGET</small>
              <strong id="learn-plan-target"></strong>
            </div>

            <div class="learn-plan-summary-item">
              <small>STUDY COMMITMENT</small>
              <strong id="learn-plan-commitment"></strong>
            </div>

            <div class="learn-plan-summary-item">
              <small>PRIMARY FOCUS</small>
              <strong id="learn-plan-focus"></strong>
            </div>

            <div class="learn-plan-summary-item">
              <small>SKIP FOR NOW</small>
              <strong id="learn-plan-skip"></strong>
            </div>

          </div>


          <div class="learn-week-list">

            <article class="learn-week">
              <span>WEEK 1</span>

              <div>
                <div class="learn-week-purpose">
                  FOUNDATION
                </div>

                <h3 id="week-one-title"></h3>

                <p id="week-one-copy"></p>

                <div class="learn-week-time">
                  Recommended pace:
                  <strong id="week-one-time"></strong>
                </div>
              </div>
            </article>


            <article class="learn-week">
              <span>WEEK 2</span>

              <div>
                <div class="learn-week-purpose">
                  YOUR GOAL
                </div>

                <h3 id="week-two-title"></h3>

                <p id="week-two-copy"></p>

                <div class="learn-week-time">
                  Recommended pace:
                  <strong id="week-two-time"></strong>
                </div>
              </div>
            </article>


            <article class="learn-week">
              <span>WEEK 3</span>

              <div>
                <div class="learn-week-purpose">
                  PRACTICE
                </div>

                <h3 id="week-three-title"></h3>

                <p id="week-three-copy"></p>

                <div class="learn-week-time">
                  Recommended pace:
                  <strong id="week-three-time"></strong>
                </div>
              </div>
            </article>


            <article
              class="learn-week learn-week-highlight"
            >
              <span>WEEK 4</span>

              <div>
                <div class="learn-week-purpose">
                  REAL-LIFE TEST
                </div>

                <h3>
                  See if you can actually use it.
                </h3>

                <p id="week-four-copy">
                  Put your Korean into practice in realistic situations
                  with a Korean tutor. This session focuses on using what
                  you learned — not learning another grammar lesson.
                </p>

                <a href="#tutor">
                  TAKE MY REAL-LIFE TEST →
                </a>
              </div>
            </article>

          </div>

        </div>

      </div>
    </section>


    <!-- CURATED RESOURCES -->
    <section
      id="resources"
      class="learn-resources"
    >
      <div class="wrap">

        <div class="section-head">
          <div>
            <div class="eyebrow">
              THE BEST FREE RESOURCES
            </div>

            <h2>
              Curated, not overwhelming.
            </h2>
          </div>

          <p>
            You don't need another list of 100 Korean resources.
            You need to know which one to use next.
          </p>
        </div>


        <div class="learn-resource-grid">

          <article class="learn-resource-card">

            <div class="learn-resource-type">
              STRUCTURED COURSE
            </div>

            <h3>
              King Sejong Institute
            </h3>

            <p>
              Structured Korean lessons for learners who need
              a clear foundation and progression.
            </p>

            <div class="learn-resource-tags">
              <span>FREE</span>
              <span>BEGINNER → ADVANCED</span>
            </div>

            <a
              href="https://www.iksi.or.kr/"
              target="_blank"
              rel="noopener noreferrer"
            >
              VISIT RESOURCE →
            </a>

          </article>


          <article class="learn-resource-card">

            <div class="learn-resource-type">
              LISTENING & SPEAKING
            </div>

            <h3>
              Selected YouTube Lessons
            </h3>

            <p>
              We select useful videos for pronunciation,
              listening and natural everyday Korean.
            </p>

            <div class="learn-resource-tags">
              <span>FREE</span>
              <span>CURATED</span>
            </div>

            <a href="#study-plan">
              GET RECOMMENDATIONS →
            </a>

          </article>


          <article class="learn-resource-card">

            <div class="learn-resource-type">
              REAL-LIFE KOREAN
            </div>

            <h3>
              Seen in Korea Guides
            </h3>

            <p>
              Situation-based phrases for restaurants,
              shopping, transport, booking and daily life.
            </p>

            <div class="learn-resource-tags">
              <span>FREE</span>
              <span>PRACTICAL</span>
            </div>

            <a href="#situations">
              EXPLORE GUIDES →
            </a>

          </article>

        </div>

      </div>
    </section>


    <!-- SITUATIONS -->
    <section
      id="situations"
      class="learn-situations"
    >
      <div class="wrap">

        <div class="section-head">
          <div>
            <div class="eyebrow">
              PRACTICE BEFORE REAL LIFE
            </div>

            <h2>
              Learn by situation.
            </h2>
          </div>

          <p>
            Study the phrases first.
            Then practice the same situation with a real person.
          </p>
        </div>


        <div class="learn-situation-grid">

          <article>
            <span>01</span>
            <h3>Restaurant</h3>
            <p>
              Order food, ask questions and pay.
            </p>
          </article>

          <article>
            <span>02</span>
            <h3>Shopping</h3>
            <p>
              Ask about products, sizes and prices.
            </p>
          </article>

          <article>
            <span>03</span>
            <h3>Taxi & Transport</h3>
            <p>
              Explain destinations and understand directions.
            </p>
          </article>

          <article>
            <span>04</span>
            <h3>Bookings</h3>
            <p>
              Make and change reservations or appointments.
            </p>
          </article>

          <article>
            <span>05</span>
            <h3>Daily Life</h3>
            <p>
              Handle the small conversations that happen every day.
            </p>
          </article>

          <article>
            <span>06</span>
            <h3>Work</h3>
            <p>
              Practice useful workplace and business Korean.
            </p>
          </article>

        </div>

      </div>
    </section>


    <!-- TUTOR -->
    <section
      id="tutor"
      class="learn-tutor-section"
    >
      <div class="wrap">

        <div class="section-head">
          <div>
            <div class="eyebrow">
              REAL CONVERSATION
            </div>

            <h2>
              Put your Korean to the test.
            </h2>
          </div>

          <p>
            This isn't another lecture.
            Use the Korean you've studied in realistic conversations.
          </p>
        </div>


        <div class="learn-tutor-card">

          <div class="learn-tutor-placeholder">
            TUTOR PROFILE
          </div>


          <div class="learn-tutor-copy">

            <div class="learn-resource-type">
              1:1 KOREAN PRACTICE
            </div>

            <h3>
              Practice with a Korean tutor
            </h3>

            <p>
              Your tutor follows your study plan and recreates
              real situations — ordering food, shopping,
              booking appointments, workplace conversations and more.
            </p>

            <div class="learn-resource-tags">
              <span>1:1 ONLINE</span>
              <span>REAL-LIFE ROLE PLAY</span>
              <span>FEEDBACK</span>
            </div>

            <a
              href="mailto:seeninkorea@gmail.com?subject=Korean%20Trial%20Lesson"
              class="learn-btn learn-btn-primary"
            >
              ASK ABOUT A TRIAL LESSON →
            </a>

            <small>
              One tutor is currently available.
              Additional tutors will be added as the program grows.
            </small>

          </div>

        </div>

      </div>
    </section>


    <!-- FINAL CTA -->
    <section class="learn-final-section">
      <div class="wrap">

        <div class="learn-final-cta">

          <div>
            <div class="eyebrow">
              START HERE
            </div>

            <h2>
              Learn it.<br />
              Then use it.
            </h2>

            <p>
              Start with a free personalized Korean study plan.
              When you're ready, test it in a real conversation.
            </p>
          </div>


          <div class="learn-final-actions">

            <a
              href="#study-plan"
              class="learn-btn learn-btn-dark"
            >
              BUILD MY STUDY PLAN →
            </a>

            <a
              href="#tutor"
              class="learn-btn learn-btn-light"
            >
              TRY A 1:1 LESSON →
            </a>

          </div>

        </div>

      </div>
    </section>

  </main>


  <style is:global>

    .learn-result-actions{
      display:flex;
      flex-wrap:wrap;
      gap:8px;
      margin:-4px 0 24px;
    }

    .learn-result-actions button{
      min-height:36px;
      padding:0 12px;
      border:1px solid var(--line);
      background:#f8f5ef;
      color:#111;
      font:inherit;
      font-size:9px;
      font-weight:900;
      letter-spacing:.06em;
      cursor:pointer;
    }

    .learn-result-actions button:hover{
      border-color:var(--accent);
    }


    .learn-plan-summary{
      display:grid;
      grid-template-columns:repeat(2,minmax(0,1fr));
      gap:1px;
      margin-bottom:28px;
      background:var(--line);
      border:1px solid var(--line);
    }

    .learn-plan-summary-item{
      min-height:112px;
      padding:18px;
      background:#f8f5ef;
    }

    .learn-plan-summary-item small{
      display:block;
      margin-bottom:10px;
      color:var(--accent);
      font-size:8px;
      font-weight:900;
      letter-spacing:.09em;
    }

    .learn-plan-summary-item strong{
      display:block;
      font-size:15px;
      line-height:1.35;
      letter-spacing:-.02em;
    }


    .learn-week-purpose{
      margin-bottom:6px;
      color:var(--accent);
      font-size:8px;
      font-weight:900;
      letter-spacing:.1em;
    }

    .learn-week-time{
      margin-top:12px;
      color:var(--muted);
      font-size:10px;
    }

    .learn-week-time strong{
      color:#111;
    }


    @media (max-width:850px){

      .learn-plan-summary{
        grid-template-columns:1fr;
      }

      .learn-plan-summary-item{
        min-height:0;
      }

      .learn-result-actions{
        display:grid;
        grid-template-columns:repeat(3,1fr);
      }

      .learn-result-actions button{
        padding:8px 6px;
      }

    }


    @media print{

      body *{
        visibility:hidden !important;
      }

      #korean-plan-result,
      #korean-plan-result *{
        visibility:visible !important;
      }

      #korean-plan-result{
        position:absolute;
        inset:0 auto auto 0;
        width:100%;
        margin:0;
        border:0;
        box-shadow:none;
      }

      .learn-result-actions{
        display:none !important;
      }

    }

  </style>


  <script is:inline>

    const STORAGE_KEY = 'sik-korean-plan-v1';


    const selections = {
      goal: null,
      level: null,
      time: null,
      focus: null
    };


    const stepOrder = [
      'goal',
      'level',
      'time',
      'focus'
    ];


    const labels = {

      goal: {
        travel: 'Travel',
        life: 'Live in Korea',
        work: 'Work / Business',
        social: 'Friends / Dating',
        topik: 'TOPIK',
        culture: 'K-pop / Drama'
      },

      level: {
        zero: 'Complete beginner',
        beginner: 'Beginner',
        intermediate: 'Intermediate',
        advanced: 'Advanced'
      },

      time: {
        '10': '10 min / day',
        '30': '30 min / day',
        '60': '1 hour / day',
        weekend: 'A few hours / week'
      },

      focus: {
        speaking: 'Speaking',
