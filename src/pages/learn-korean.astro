      const shareData={title:'My Korean Study Path — Seen in Korea',text:'Here is my personalized Korean study path.',url:url.toString()};
      try{if(navigator.share){await navigator.share(shareData);}else if(navigator.clipboard){await navigator.clipboard.writeText(url.toString());setText('learn-plan-message','Share link copied.');}else{window.prompt('Copy this link:',url.toString());}}catch(error){if(error?.name!=='AbortError')setText('learn-plan-message','Could not share automatically.');}
    });

    document.getElementById('print-korean-plan')?.addEventListener('click',()=>{if(!renderPlan({scroll:false}))return;window.print();});
    document.querySelectorAll('[data-test-booking]').forEach((link)=>link.addEventListener('click',()=>track('real_life_test_clicked',{goal:selections.goal||''})));

    function restorePlan(values,{source='unknown'}={}){
      if(!values?.goal||!labels.goal[values.goal])return false;
      selections.goal=values.goal;renderContextQuestion();
      const valid=stepOrder.every((step)=>step==='context'?contextConfig[values.goal]?.options.some(([key])=>key===values[step]):Boolean(labels[step]?.[values[step]]));
      if(!valid){selections.goal=null;return false;}
      restoringPlan=true;stepOrder.forEach((step)=>{if(step==='context')renderContextQuestion();completeStep(step,values[step]);});restoringPlan=false;renderPlan({scroll:false});
      track('plan_restored',{source,goal:values.goal,level:values.level||'',context:values.context||''});
      return true;
    }

    function restoreLegacyPartial(values){
      const required=['goal','level','time','focus'];
      const valid=required.every((step)=>Boolean(labels[step]?.[values?.[step]]));
      if(!valid)return false;
      restoringPlan=true;
      required.forEach((step)=>completeStep(step,values[step]));
      restoringPlan=false;
      selections.context=null;
      renderContextQuestion();
      const contextStep=document.querySelector('[data-plan-step="context"]');
      contextStep?.removeAttribute('hidden');
      contextStep?.classList.add('is-open');
      setText('learn-plan-message','Your saved answers were restored. Choose one final context to rebuild your path.');
      track('plan_restored',{source:'legacy_partial',goal:values.goal,level:values.level});
      return true;
    }

    document.getElementById('learn-return-continue')?.addEventListener('click',()=>{
      const firstIncomplete=['one','two','three'].find((phase)=>!completedPhases[phase]);
      if(firstIncomplete)openPhase(firstIncomplete);
      else document.getElementById('learn-today-card')?.scrollIntoView({behavior:'smooth',block:'start'});
    });


    // v3.6: show the mobile sticky CTA only when the generated path is on screen
    // and the primary START THIS LESSON button is no longer visible.
    let stickyResultVisible=false;
    let stickyPrimaryVisible=false;

    function syncMobileSticky(){
      const sticky=document.getElementById('learn-mobile-sticky');
      const result=document.getElementById('korean-plan-result');
      if(!sticky||!result)return;
      const shouldShow=!result.hasAttribute('hidden')&&stickyResultVisible&&!stickyPrimaryVisible;
      if(shouldShow)sticky.removeAttribute('hidden');
      else sticky.setAttribute('hidden','');
    }

    if('IntersectionObserver' in window){
      const result=document.getElementById('korean-plan-result');
      const primary=document.getElementById('learn-today-link');

      if(result){
        new IntersectionObserver((entries)=>{
          stickyResultVisible=Boolean(entries[0]?.isIntersecting);
          syncMobileSticky();
        },{threshold:.01}).observe(result);
      }

      if(primary){
        new IntersectionObserver((entries)=>{
          stickyPrimaryVisible=Boolean(entries[0]?.isIntersecting);
          syncMobileSticky();
        },{threshold:.15}).observe(primary);
      }
    }

    updateProgress('goal');

    const params=new URLSearchParams(window.location.search);const queryValues={};stepOrder.forEach((step)=>{queryValues[step]=params.get(step);});
    const restoredFromUrl=restorePlan(queryValues,{source:'url'});
    let restoredFromStorage=false;
    if(!restoredFromUrl){
      try{
        const saved=JSON.parse(localStorage.getItem(STORAGE_KEY)||'null');
        if(saved?.selections){
          Object.assign(feedback,saved.feedback||{});
          Object.assign(completedPhases,saved.completedPhases||{});
          restoredFromStorage=restorePlan(saved.selections,{source:'localStorage'});
          if(restoredFromStorage){
            if(saved.currentResourceIndex)Object.assign(currentResourceIndex,saved.currentResourceIndex);
            if(Number.isInteger(saved.practiceScenarioIndex))practiceScenarioIndex=saved.practiceScenarioIndex;
            ['one','two'].forEach(renderResource);renderToday();renderPractice();updatePhaseStates();
            const banner=document.getElementById('learn-return-banner');
            banner?.removeAttribute('hidden');
          }
        }
      }catch(error){localStorage.removeItem(STORAGE_KEY);}
    }
    if(!restoredFromUrl&&!restoredFromStorage){
      try{
        const legacy=JSON.parse(localStorage.getItem('sik-korean-plan-v1')||'null');
        if(legacy)restoreLegacyPartial(legacy.selections||legacy);
      }catch(error){}
    }
  </script>

</BaseLayout>
