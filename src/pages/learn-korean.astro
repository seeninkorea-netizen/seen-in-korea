      const sticky=document.getElementById('learn-mobile-sticky');if(sticky){sticky.href=resource.url;sticky.dataset.resourceId=resource.id;}
      setText('learn-mobile-sticky-time',timePlans[selections.time].today);
      const thumb=document.getElementById('learn-today-thumb');
