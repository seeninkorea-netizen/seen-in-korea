    function phaseLabel(phase){
      if(phase==='one')return selections.goal==='travel'&&selections.context==='urgent'?'SURVIVAL FIRST':'FOUNDATION';
      if(phase==='two'){
        if(selections.goal==='travel'&&selections.context==='urgent')return'FOUNDATION';
        return phaseTwoIsFoundationBridge()?'FOUNDATION BRIDGE':'YOUR GOAL';
      }
      return'SIK PRACTICE';
    }

    function updatePhaseStates(){
      const phases=['one','two','three'];
      const firstIncomplete=phases.find((phase)=>!completedPhases[phase])||null;
      phases.forEach((phase)=>{
        const isDone=completedPhases[phase];
        const status=isDone?'COMPLETED':phase===firstIncomplete?'CURRENT':'NEXT';
        setText(`phase-${phase}-status`,`${status} · ${phaseLabel(phase)}`);
        const details=document.querySelector(`[data-phase-details="${phase}"]`);
        if(details)details.classList.toggle('is-completed',isDone);
      });
    }

    function openPhase(phase){
      document.querySelectorAll('[data-phase-details]').forEach((details)=>{details.open=details.dataset.phaseDetails===phase;});
      document.querySelector(`[data-phase-details="${phase}"]`)?.scrollIntoView({behavior:'smooth',block:'center'});
    }

    document.querySelectorAll('[data-phase-details]').forEach((details)=>{
      details.addEventListener('toggle',()=>{
        if(!details.open)return;
        document.querySelectorAll('[data-phase-details]').forEach((other)=>{if(other!==details)other.open=false;});
      });
    });

    function practiceDifficultyTarget(){
      return({zero:1,beginner:2,intermediate:3,advanced:4,unsure:2})[selections.level]||2;
    }

    function currentPracticeScenarios(){
      let scenarios=[];
      if(selections.goal==='travel')scenarios=practiceScenarioBank.travel||[];
      else if(selections.goal==='topik')scenarios=practiceScenarioBank.topik[selections.focus]||practiceScenarioBank.topik.unsure||[];
      else{
        const group=practiceScenarioBank[selections.goal];
        scenarios=group?.[selections.context]||[];
      }

      const target=practiceDifficultyTarget();
      const close=scenarios.filter((scenario)=>Math.abs((scenario.difficulty||2)-target)<=1);
      const pool=close.length>=2?close:scenarios;

      return [...pool].sort((a,b)=>{
        const aGap=Math.abs((a.difficulty||2)-target);
        const bGap=Math.abs((b.difficulty||2)-target);
        if(aGap!==bGap)return aGap-bGap;
        return(a.difficulty||2)-(b.difficulty||2);
      });
    }

    function currentPracticeScenario(){
      const scenarios=currentPracticeScenarios();
      if(!scenarios.length)return null;
      return scenarios[practiceScenarioIndex%scenarios.length];
    }

    function practiceSteps(){
      if(selections.goal==='topik'){
        return[
          'Do the task once without checking the model response.',
          'Mark what you were unsure about — vocabulary, grammar, speed or organization.',
          'Check one natural response, then do the task once more from memory.'
        ];
      }

      const steps={
        speaking:[
          'Read the situation and Korean prompt once, then look away.',
          'Answer aloud before opening the model response.',
          'Check one natural response, then answer again in your own words.'
        ],
        listening:[
          'Read the Korean prompt once as if you heard it in real life, then hide it.',
          'Say what you understood and respond without checking English.',
          'Check the meaning and model response, then repeat at normal speed.'
        ],
        reading:[
          'Read the Korean prompt without romanization or translation first.',
          'Say or write what it means and how you would respond.',
          'Check one natural response, then read your final answer aloud.'
        ],
        writing:[
          'Write a short response without using a translator.',
          'Open the model response only after you finish.',
          'Rewrite your answer using one useful phrase from the example.'
        ],
        unsure:[
          'Read the Korean prompt once and identify any words you already know.',
          'Give one short Korean response before checking the example.',
          'Use the key phrase once more in your own sentence.'
        ]
      };

      return steps[selections.focus]||steps.unsure;
    }

    function renderPractice({keepOpen=false}={}){
      const mission=missionPlans[selections.goal];
      const steps=practiceSteps();
      const scenario=currentPracticeScenario();

      setText('phase-three-practice-title',scenario?.title||mission?.title||goalPlans[selections.goal].practiceTitle);
      const scenarioSituation=scenario?.situation||'Use what you learned in one realistic situation.';
      setText(
        'phase-three-practice-scenario',
        selections.goal==='topik'
          ? `SIK-created practice — not an official TOPIK question. ${scenarioSituation}`
          : scenarioSituation
      );
      setText('phase-three-prompt-ko',scenario?.promptKo||'');
      setText('phase-three-prompt-en',scenario?.promptEn||'');
      setText('phase-three-level-target',practiceLevelTargets[selections.level]||practiceLevelTargets.unsure);
      setText('phase-three-step-one',steps[0]);
      setText('phase-three-step-two',steps[1]);
      setText('phase-three-step-three',steps[2]);
      setText('phase-three-answer-ko',scenario?.answerKo||'');
      setText('phase-three-answer-en',scenario?.answerEn||'');
      setText('phase-three-keyphrase-ko',scenario?.keyKo||'');
      setText('phase-three-keyphrase-en',scenario?.keyEn||'');

      const panel=document.getElementById('sik-practice-panel');
      const answer=document.getElementById('sik-practice-answer');
      const feedbackPanel=document.getElementById('sik-practice-feedback');
      const start=document.getElementById('start-sik-practice');
      const another=document.getElementById('next-sik-practice-scenario');

      if(keepOpen)panel?.removeAttribute('hidden');
      else panel?.setAttribute('hidden','');

      answer?.setAttribute('hidden','');
      feedbackPanel?.setAttribute('hidden','');

      if(start){
        start.textContent=completedPhases.three?'REPEAT PRACTICE →':'START MY PRACTICE →';
      }

      const scenarioCount=currentPracticeScenarios().length;
      if(another)another.hidden=scenarioCount<2;

      setText(
        'sik-practice-status',
        completedPhases.three?'COMPLETED ✓ · Try another scenario anytime.':''
      );
    }

    function renderFinal(){
      const finalLink=document.getElementById('learn-final-link');
      if(selections.goal==='topik'){
        setText('learn-final-purpose','OFFICIAL PRACTICE CHECK');
        setText('learn-final-title','Test your current TOPIK level.');
        setText('learn-final-copy','Use official TOPIK practice, review what you missed, and let those mistakes decide the next study block.');
        if(finalLink){finalLink.href='https://www.topik.go.kr/';finalLink.target='_blank';finalLink.rel='noopener noreferrer';finalLink.textContent='OPEN OFFICIAL TOPIK PRACTICE →';}
      }else{
        setText('learn-final-purpose','REAL-LIFE TEST');
        setText('learn-final-title','See if you can actually use it.');
        setText('learn-final-copy','Practice the situations you studied with a Korean tutor and get feedback on speaking, listening and response speed.');
        if(finalLink){finalLink.href='#tutor';finalLink.removeAttribute('target');finalLink.removeAttribute('rel');finalLink.textContent='TAKE MY REAL-LIFE TEST →';}
      }
