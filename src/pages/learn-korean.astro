---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Learn Korean | SEEN IN KOREA"
  description="Practical Korean for real life in Korea — everyday expressions, travel, work, shopping and situations you actually face."
>
  <main>

    <section class="listing-hero dark">
      <div class="wrap">
        <div class="eyebrow">LEARN KOREAN</div>

        <h1>
          Korean you can<br />
          actually use.
        </h1>

        <p>
          Practical Korean for the situations you actually face in Korea —
          restaurants, shopping, transport, work, appointments and everyday life.
        </p>
      </div>
    </section>

    <section>
      <div class="wrap">

        <div class="section-head">
          <div>
            <div class="eyebrow">START HERE</div>
            <h2>Learn by situation, not by textbook chapter.</h2>
          </div>

          <p>
            Short, useful Korean built around real moments in Korea.
          </p>
        </div>

        <div class="grid-3">

          <article class="shop-card">
            <span class="tag">DAILY LIFE</span>
            <h3>Everyday Korean</h3>
            <p>
              Ordering food, asking questions, shopping, cafés,
              convenience stores and conversations you hear every day.
            </p>
          </article>

          <article class="shop-card">
            <span class="tag">SURVIVAL</span>
            <h3>Korean for getting things done</h3>
            <p>
              Taxis, hospitals, bookings, deliveries, phone calls,
              addresses and situations where one sentence can solve the problem.
            </p>
          </article>

          <article class="shop-card">
            <span class="tag">REAL KOREA</span>
            <h3>What Koreans actually say</h3>
            <p>
              Natural expressions, tone and context that are often different
              from literal textbook Korean.
            </p>
          </article>

        </div>
      </div>
    </section>

    <section>
      <div class="wrap">

        <div class="section-head">
          <div>
            <div class="eyebrow">COMING NEXT</div>
            <h2>Learn from real situations.</h2>
          </div>
        </div>

        <div class="grid-3">

          <article class="voice">
            <span class="tag">01</span>
            <div class="quote">“Can I get this to go?”</div>
            <div class="voice-foot">
              Café & restaurant Korean
            </div>
          </article>

          <article class="voice">
            <span class="tag">02</span>
            <div class="quote">“Can you help me make a reservation?”</div>
            <div class="voice-foot">
              Booking & phone Korean
            </div>
          </article>

          <article class="voice">
            <span class="tag">03</span>
            <div class="quote">“Where can I find this?”</div>
            <div class="voice-foot">
              Shopping & everyday Korean
            </div>
          </article>

        </div>
      </div>
    </section>

    <section>
      <div class="wrap">
        <div class="cta">
          <div>
            <div class="eyebrow">LEARN KOREAN</div>
            <h2>
              Less memorizing.<br />
              More using.
            </h2>
            <p>
              Practical Korean lessons and real-life expressions are coming to Seen in Korea.
            </p>
          </div>

          <div class="cta-actions">
            <a href="mailto:seeninkorea@gmail.com">
              CONTACT US
            </a>
          </div>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>
