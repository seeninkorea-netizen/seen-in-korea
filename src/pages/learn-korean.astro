---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Learn Korean for Real Life | SEEN IN KOREA"
  description="Get a personalized Korean study plan, curated free learning resources, and real-life speaking practice with a Korean tutor."
>
  <main class="learn-page">

    <!-- HERO -->
    <section class="learn-hero">
      <div class="wrap learn-hero-grid">

        <div class="learn-hero-copy">
          <div class="eyebrow">LEARN KOREAN</div>

          <h1>
            Korean for<br />
            real life.
          </h1>

          <p class="learn-hero-dek">
            Get a personalized study plan, curated free resources
            and live speaking practice — so you can actually use
            Korean in everyday life.
          </p>

          <div class="learn-hero-actions">
            <a href="#study-plan" class="learn-btn learn-btn-primary">
              BUILD MY FREE STUDY PLAN →
            </a>

            <a href="#tutor" class="learn-btn learn-btn-secondary">
              TRY A 1:1 LESSON →
            </a>
          </div>

          <div class="learn-trust-row">
            <span>Personalized for your goals</span>
            <span>Curated free resources</span>
            <span>Real conversation practice</span>
          </div>
        </div>

        <div class="learn-phrase-card">
          <div class="learn-phrase-label">USE THIS TODAY</div>

          <strong class="learn-phrase-ko">
            이거 주세요.
          </strong>

          <div class="learn-phrase-roman">
            I-geo ju-se-yo.
          </div>

          <div class="learn-phrase-en">
            “This one, please.”
          </div>

          <div class="learn-phrase-rule"></div>

          <p>
            Use it when pointing to something you want
            to order or buy.
          </p>
        </div>

      </div>
    </section>


   <!-- PERSONALIZED STUDY PLAN -->
<section
  id="study-plan"
  class="learn-plan-section"
>
  <div class="wrap">

    <div class="section-head">
      <div>
        <div class="eyebrow">FREE KOREAN STUDY PLAN</div>
        <h2>Tell us about you.</h2>
      </div>

      <p>
        Answer one question at a time.
        We’ll build a starting plan around your goal,
        level, available time and learning priority.
      </p>
    </div>


    <div class="learn-plan-builder learn-plan-progressive">

      <!-- STEP 1 -->
      <div
        class="learn-question is-open"
        data-plan-step="goal"
      >
        <div class="learn-question-top">
          <div class="learn-question-number">01</div>

          <div>
            <h3>Your goal</h3>
            <p>Why do you want to learn Korean?</p>
          </div>
        </div>

        <div
          class="learn-question-options"
          data-options="goal"
        >
          <div class="learn-option-grid">
            <button type="button" data-goal="travel">
              Travel
            </button>

            <button type="button" data-goal="life">
              Live in Korea
            </button>

            <button type="button" data-goal="work">
              Work / Business
            </button>

            <button type="button" data-goal="social">
              Friends / Dating
            </button>

            <button type="button" data-goal="topik">
              TOPIK
            </button>

            <button type="button" data-goal="culture">
              K-pop / Drama
            </button>
          </div>
        </div>

        <div
          class="learn-step-complete"
          data-complete="goal"
          hidden
        >
          <span>
            ✓ <strong data-summary="goal"></strong>
          </span>

          <button
            type="button"
            data-change-step="goal"
          >
            CHANGE
          </button>
        </div>
      </div>


      <!-- STEP 2 -->
      <div
        class="learn-question"
        data-plan-step="level"
        hidden
      >
        <div class="learn-question-top">
          <div class="learn-question-number">02</div>

          <div>
            <h3>Your level</h3>
            <p>What’s your current Korean level?</p>
          </div>
        </div>

        <div
          class="learn-question-options"
          data-options="level"
        >
          <div class="learn-option-grid">
            <button type="button" data-level="zero">
              Complete beginner
            </button>

            <button type="button" data-level="beginner">
              Beginner
            </button>

            <button type="button" data-level="intermediate">
              Intermediate
            </button>

            <button type="button" data-level="advanced">
              Advanced
            </button>
          </div>
        </div>

        <div
          class="learn-step-complete"
          data-complete="level"
          hidden
        >
          <span>
            ✓ <strong data-summary="level"></strong>
          </span>

          <button
            type="button"
            data-change-step="level"
          >
            CHANGE
          </button>
        </div>
      </div>


      <!-- STEP 3 -->
      <div
        class="learn-question"
        data-plan-step="time"
        hidden
      >
        <div class="learn-question-top">
          <div class="learn-question-number">03</div>

          <div>
            <h3>Your time</h3>
            <p>How much time can you realistically study?</p>
          </div>
        </div>

        <div
          class="learn-question-options"
          data-options="time"
        >
          <div class="learn-option-grid">
            <button type="button" data-time="10">
              10 min / day
            </button>

            <button type="button" data-time="30">
              30 min / day
            </button>

            <button type="button" data-time="60">
              1 hour / day
            </button>

            <button type="button" data-time="weekend">
              A few hours / week
            </button>
          </div>
        </div>

        <div
          class="learn-step-complete"
          data-complete="time"
          hidden
        >
          <span>
            ✓ <strong data-summary="time"></strong>
          </span>

          <button
            type="button"
            data-change-step="time"
          >
            CHANGE
          </button>
        </div>
      </div>


      <!-- STEP 4 -->
      <div
        class="learn-question"
        data-plan-step="focus"
        hidden
      >
        <div class="learn-question-top">
          <div class="learn-question-number">04</div>

          <div>
            <h3>Your priority</h3>
            <p>What do you want the most help with?</p>
          </div>
        </div>

        <div
          class="learn-question-options"
          data-options="focus"
        >
          <div class="learn-option-grid">
            <button type="button" data-focus="speaking">
              Speaking
            </button>

            <button type="button" data-focus="listening">
              Listening
            </button>

            <button type="button" data-focus="reading">
              Reading
            </button>

            <button type="button" data-focus="writing">
              Writing
            </button>

            <button type="button" data-focus="unsure">
              I’m not sure
            </button>
          </div>
        </div>

        <div
          class="learn-step-complete"
          data-complete="focus"
          hidden
        >
          <span>
            ✓ <strong data-summary="focus"></strong>
          </span>

          <button
            type="button"
            data-change-step="focus"
          >
            CHANGE
          </button>
        </div>
      </div>

    </div>


    <div
      class="learn-plan-action"
      id="learn-plan-action"
      hidden
    >
      <button
        id="generate-korean-plan"
        type="button"
        class="learn-btn learn-btn-primary"
      >
        BUILD MY KOREAN PLAN →
      </button>

      <p id="learn-plan-message">
        Your answers are ready.
      </p>
    </div>


        <!-- GENERATED RESULT -->
        <div
          id="korean-plan-result"
          class="learn-plan-result"
          hidden
        >
          <div class="learn-result-head">
            <div>
              <div class="eyebrow">YOUR PERSONALIZED PLAN</div>
              <h2>Your first 4 weeks.</h2>
            </div>

            <span id="learn-result-profile"></span>
          </div>

          <div class="learn-week-list">

            <article class="learn-week">
              <span>WEEK 1</span>
              <div>
                <h3 id="week-one-title">Build your foundation</h3>
                <p id="week-one-copy"></p>
              </div>
            </article>

            <article class="learn-week">
              <span>WEEK 2</span>
              <div>
                <h3 id="week-two-title">Useful Korean</h3>
                <p id="week-two-copy"></p>
              </div>
            </article>

            <article class="learn-week">
              <span>WEEK 3</span>
              <div>
                <h3 id="week-three-title">Listen and respond</h3>
                <p id="week-three-copy"></p>
              </div>
            </article>

            <article class="learn-week learn-week-highlight">
              <span>WEEK 4</span>
              <div>
                <h3>Real-life simulation</h3>
                <p>
                  Practice the situations you studied with a Korean tutor.
                  Use role-play to test what you can actually understand and say.
                </p>

                <a href="#tutor">
                  PRACTICE WITH A TUTOR →
                </a>
              </div>
            </article>

          </div>
        </div>

      </div>
    </section>


    <!-- CURATED RESOURCES -->
    <section id="resources" class="learn-resources">
      <div class="wrap">

        <div class="section-head">
          <div>
            <div class="eyebrow">THE BEST FREE RESOURCES</div>
            <h2>Curated, not overwhelming.</h2>
          </div>

          <p>
            You don't need another list of 100 Korean resources.
            You need to know which one to use next.
          </p>
        </div>


        <div class="learn-resource-grid">

          <article class="learn-resource-card">
            <div class="learn-resource-type">
              STRUCTURED COURSE
            </div>

            <h3>King Sejong Institute</h3>

            <p>
              Structured Korean lessons for learners who need
              a clear foundation and progression.
            </p>

            <div class="learn-resource-tags">
              <span>FREE</span>
              <span>BEGINNER → ADVANCED</span>
            </div>

            <a
              href="https://www.iksi.or.kr/"
              target="_blank"
              rel="noopener noreferrer"
            >
              VISIT RESOURCE →
            </a>
          </article>


          <article class="learn-resource-card">
            <div class="learn-resource-type">
              LISTENING & SPEAKING
            </div>

            <h3>Selected YouTube Lessons</h3>

            <p>
              We select useful videos for pronunciation,
              listening and natural everyday Korean.
            </p>

            <div class="learn-resource-tags">
              <span>FREE</span>
              <span>CURATED</span>
            </div>

            <a href="#study-plan">
              GET RECOMMENDATIONS →
            </a>
          </article>


          <article class="learn-resource-card">
            <div class="learn-resource-type">
              REAL-LIFE KOREAN
            </div>

            <h3>Seen in Korea Guides</h3>

            <p>
              Situation-based phrases for restaurants,
              shopping, transport, booking and daily life.
            </p>

            <div class="learn-resource-tags">
              <span>FREE</span>
              <span>PRACTICAL</span>
            </div>

            <a href="#situations">
              EXPLORE GUIDES →
            </a>
          </article>

        </div>

      </div>
    </section>


    <!-- SITUATIONS -->
    <section id="situations" class="learn-situations">
      <div class="wrap">

        <div class="section-head">
          <div>
            <div class="eyebrow">PRACTICE BEFORE REAL LIFE</div>
            <h2>Learn by situation.</h2>
          </div>

          <p>
            Study the phrases first.
            Then practice the same situation with a real person.
          </p>
        </div>


        <div class="learn-situation-grid">

          <article>
            <span>01</span>
            <h3>Restaurant</h3>
            <p>Order food, ask questions and pay.</p>
          </article>

          <article>
            <span>02</span>
            <h3>Shopping</h3>
            <p>Ask about products, sizes and prices.</p>
          </article>

          <article>
            <span>03</span>
            <h3>Taxi & Transport</h3>
            <p>Explain destinations and understand directions.</p>
          </article>

          <article>
            <span>04</span>
            <h3>Bookings</h3>
            <p>Make and change reservations or appointments.</p>
          </article>

          <article>
            <span>05</span>
            <h3>Daily Life</h3>
            <p>Handle the small conversations that happen every day.</p>
          </article>

          <article>
            <span>06</span>
            <h3>Work</h3>
            <p>Practice useful workplace and business Korean.</p>
          </article>

        </div>

      </div>
    </section>


    <!-- TUTOR -->
    <section id="tutor" class="learn-tutor-section">
      <div class="wrap">

        <div class="section-head">
          <div>
            <div class="eyebrow">REAL CONVERSATION</div>
            <h2>Put your Korean to the test.</h2>
          </div>

          <p>
            This isn't another lecture.
            Use the Korean you've studied in realistic conversations.
          </p>
        </div>


        <div class="learn-tutor-card">

          <div class="learn-tutor-placeholder">
            TUTOR PROFILE
          </div>

          <div class="learn-tutor-copy">
            <div class="learn-resource-type">
              1:1 KOREAN PRACTICE
            </div>

            <h3>Practice with a Korean tutor</h3>

            <p>
              Your tutor follows your study plan and recreates
              real situations — ordering food, shopping,
              booking appointments, workplace conversations and more.
            </p>

            <div class="learn-resource-tags">
              <span>1:1 ONLINE</span>
              <span>REAL-LIFE ROLE PLAY</span>
              <span>FEEDBACK</span>
            </div>

            <a
              href="mailto:seeninkorea@gmail.com?subject=Korean%20Trial%20Lesson"
              class="learn-btn learn-btn-primary"
            >
              ASK ABOUT A TRIAL LESSON →
            </a>

            <small>
              One tutor is currently available.
              Additional tutors will be added as the program grows.
            </small>
          </div>

        </div>

      </div>
    </section>


    <!-- FINAL CTA -->
    <section class="learn-final-section">
      <div class="wrap">

        <div class="learn-final-cta">
          <div>
            <div class="eyebrow">START HERE</div>

            <h2>
              Learn it.<br />
              Then use it.
            </h2>

            <p>
              Start with a free personalized Korean study plan.
              When you're ready, test it in a real conversation.
            </p>
          </div>

          <div class="learn-final-actions">
            <a
              href="#study-plan"
              class="learn-btn learn-btn-dark"
            >
              BUILD MY STUDY PLAN →
            </a>

            <a
              href="#tutor"
              class="learn-btn learn-btn-light"
            >
              TRY A 1:1 LESSON →
            </a>
          </div>
        </div>

      </div>
    </section>

  </main>


  <script is:inline>
  const selections = {
    goal: null,
    level: null,
    time: null,
    focus: null
  };

  const stepOrder = [
    'goal',
    'level',
    'time',
    'focus'
  ];

  const labels = {
    goal: {
      travel: 'Travel',
      life: 'Live in Korea',
      work: 'Work / Business',
      social: 'Friends / Dating',
      topik: 'TOPIK',
      culture: 'K-pop / Drama'
    },

    level: {
      zero: 'Complete beginner',
      beginner: 'Beginner',
      intermediate: 'Intermediate',
      advanced: 'Advanced'
    },

    time: {
      '10': '10 min / day',
      '30': '30 min / day',
      '60': '1 hour / day',
      weekend: 'A few hours / week'
    },

    focus: {
      speaking: 'Speaking',
      listening: 'Listening',
      reading: 'Reading',
      writing: 'Writing',
      unsure: 'Not sure yet'
    }
  };


  function getButtonValue(button, step) {
    return button.dataset[step];
  }


  function resetStepsAfter(step) {
    const currentIndex = stepOrder.indexOf(step);

    stepOrder.forEach((name, index) => {
      if (index <= currentIndex) return;

      selections[name] = null;

      const stepElement =
        document.querySelector(`[data-plan-step="${name}"]`);

      const options =
        document.querySelector(`[data-options="${name}"]`);

      const complete =
        document.querySelector(`[data-complete="${name}"]`);

      stepElement?.setAttribute('hidden', '');

      stepElement?.classList.remove(
        'is-open',
        'is-complete'
      );

      options?.removeAttribute('hidden');
      complete?.setAttribute('hidden', '');

      document
        .querySelectorAll(`[data-${name}]`)
        .forEach((button) => {
          button.classList.remove('is-selected');
        });
    });

    document
      .getElementById('learn-plan-action')
      ?.setAttribute('hidden', '');

    document
      .getElementById('korean-plan-result')
      ?.setAttribute('hidden', '');
  }


  function revealNextStep(step) {
    const index = stepOrder.indexOf(step);
    const nextStep = stepOrder[index + 1];

    if (!nextStep) {
      document
        .getElementById('learn-plan-action')
        ?.removeAttribute('hidden');

      return;
    }

    const nextElement =
      document.querySelector(
        `[data-plan-step="${nextStep}"]`
      );

    nextElement?.removeAttribute('hidden');
    nextElement?.classList.add('is-open');

    setTimeout(() => {
      nextElement?.scrollIntoView({
        behavior: 'smooth',
        block: 'center'
      });
    }, 120);
  }


  function completeStep(step, value) {
    selections[step] = value;

    resetStepsAfter(step);

    const stepElement =
      document.querySelector(
        `[data-plan-step="${step}"]`
      );

    const options =
      document.querySelector(
        `[data-options="${step}"]`
      );

    const complete =
      document.querySelector(
        `[data-complete="${step}"]`
      );

    const summary =
      document.querySelector(
        `[data-summary="${step}"]`
      );

    document
      .querySelectorAll(`[data-${step}]`)
      .forEach((button) => {
        button.classList.toggle(
          'is-selected',
          getButtonValue(button, step) === value
        );
      });

    if (summary) {
      summary.textContent =
        labels[step]?.[value] || value;
    }

    options?.setAttribute('hidden', '');
    complete?.removeAttribute('hidden');

    stepElement?.classList.remove('is-open');
    stepElement?.classList.add('is-complete');

    revealNextStep(step);
  }


  stepOrder.forEach((step) => {
    document
      .querySelectorAll(`[data-${step}]`)
      .forEach((button) => {
        button.addEventListener('click', () => {
          const value =
            getButtonValue(button, step);

          completeStep(step, value);
        });
      });
  });


  document
    .querySelectorAll('[data-change-step]')
    .forEach((button) => {

      button.addEventListener('click', () => {
        const step =
          button.dataset.changeStep;

        resetStepsAfter(step);

        selections[step] = null;

        const stepElement =
          document.querySelector(
            `[data-plan-step="${step}"]`
          );

        const options =
          document.querySelector(
            `[data-options="${step}"]`
          );

        const complete =
          document.querySelector(
            `[data-complete="${step}"]`
          );

        stepElement?.classList.remove(
          'is-complete'
        );

        stepElement?.classList.add('is-open');

        options?.removeAttribute('hidden');
        complete?.setAttribute('hidden', '');

        stepElement?.scrollIntoView({
          behavior: 'smooth',
          block: 'center'
        });
      });
    });


  const goalPlans = {
    travel: {
      label: 'Travel',
      week2:
        'Focus on restaurant, café, shopping, transport and direction phrases you can use during a trip.',
      week3:
        'Train your listening and response speed for common situations you are likely to encounter while travelling.'
    },

    life: {
      label: 'Living in Korea',
      week2:
        'Focus on delivery, shopping, appointments, transport and everyday service interactions.',
      week3:
        'Practice recurring conversations you are likely to face while living in Korea.'
    },

    work: {
      label: 'Work / Business',
      week2:
        'Build workplace vocabulary, introductions, polite requests and practical business expressions.',
      week3:
        'Practice responding naturally during workplace conversations, meetings and professional situations.'
    },

    social: {
      label: 'Friends / Dating',
      week2:
        'Learn casual conversation, introductions, reactions and expressions used in social situations.',
      week3:
        'Practice following natural conversational Korean without translating every sentence.'
    },

    topik: {
      label: 'TOPIK',
      week2:
        'Strengthen vocabulary and grammar patterns appropriate for your current level.',
      week3:
        'Combine structured study with focused listening and reading practice.'
    },

    culture: {
      label: 'K-pop / Drama',
      week2:
        'Learn expressions and vocabulary frequently heard in Korean entertainment and everyday conversation.',
      week3:
        'Use short clips and listening exercises to recognize natural speech patterns.'
    }
  };


  const levelPlans = {
    zero: {
      label: 'Complete beginner',
      week1:
        'Start with Hangul, pronunciation and a small set of survival expressions before expanding your vocabulary.'
    },

    beginner: {
      label: 'Beginner',
      week1:
        'Review essential sentence patterns and build practical vocabulary around situations you actually face.'
    },

    intermediate: {
      label: 'Intermediate',
      week1:
        'Identify your speaking and comprehension gaps and turn vocabulary you already know into usable Korean.'
    },

    advanced: {
      label: 'Advanced',
      week1:
        'Focus on natural phrasing, nuance, speed and the difference between technically correct Korean and everyday Korean.'
    }
  };


  const focusPlans = {
    speaking:
      'Your plan will emphasize active speaking, role-play and producing Korean without translating first.',

    listening:
      'Your plan will emphasize listening comprehension, natural speed and recognizing common spoken patterns.',

    reading:
      'Your plan will emphasize Hangul fluency, practical reading and understanding Korean you encounter in real life.',

    writing:
      'Your plan will emphasize useful sentence construction, messaging and practical written Korean.',

    unsure:
      'Your plan will balance speaking, listening, reading and core vocabulary until your strongest priority becomes clearer.'
  };


  const generateButton =
    document.getElementById(
      'generate-korean-plan'
    );

  const result =
    document.getElementById(
      'korean-plan-result'
    );

  const message =
    document.getElementById(
      'learn-plan-message'
    );


  generateButton?.addEventListener('click', () => {

    if (
      !selections.goal ||
      !selections.level ||
      !selections.time ||
      !selections.focus
    ) {
      if (message) {
        message.textContent =
          'Please complete all four steps first.';
      }

      return;
    }

    const goal =
      goalPlans[selections.goal];

    const level =
      levelPlans[selections.level];

    const timeLabel =
      labels.time[selections.time];

    const focusLabel =
      labels.focus[selections.focus];


    const profile =
      document.getElementById(
        'learn-result-profile'
      );

    const week1 =
      document.getElementById(
        'week-one-copy'
      );

    const week2 =
      document.getElementById(
        'week-two-copy'
      );

    const week3 =
      document.getElementById(
        'week-three-copy'
      );


    if (profile) {
      profile.textContent =
        `${goal.label} · ${level.label} · ${timeLabel} · ${focusLabel}`;
    }

    if (week1) {
      week1.textContent =
        `${level.week1} ${focusPlans[selections.focus]}`;
    }

    if (week2) {
      week2.textContent =
        goal.week2;
    }

    if (week3) {
      week3.textContent =
        goal.week3;
    }


    if (message) {
      message.textContent =
        'Building your personalized plan...';
    }


    setTimeout(() => {
      result?.removeAttribute('hidden');

      if (message) {
        message.textContent =
          'Your Korean plan is ready.';
      }

      result?.scrollIntoView({
        behavior: 'smooth',
        block: 'start'
      });
    }, 450);

  });
</script>

</BaseLayout>
