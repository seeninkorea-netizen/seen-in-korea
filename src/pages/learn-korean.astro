    function phaseTwoIsFoundationBridge(){
      const resource=currentResource('two');
      if(!resource||useUtilityFirst())return false;
      return !resource.goals.includes(selections.goal);
    }

    function renderPhaseCopy(){
      const utilityFirst=useUtilityFirst();
      const level=levelPlans[selections.level];
      const goal=goalPlans[selections.goal];

      if(utilityFirst){
        setText('phase-one-purpose','SURVIVAL FIRST');
