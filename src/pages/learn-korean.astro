---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Learn Korean for Real Life | SEEN IN KOREA"
  description="Get a personalized Korean study path, curated free resources, practical missions, and real-life Korean practice."
>
  <main class="learn-page">

    <!-- HERO -->
    <section class="learn-hero">
      <div class="wrap learn-hero-grid">
        <div class="learn-hero-copy">
          <div class="eyebrow">LEARN KOREAN</div>
          <h1>Find your next<br /><span class="learn-accent-text">Korean lesson.</span></h1>
          <p class="learn-hero-dek">
            Tell us your goal and situation.
            We’ll show you what to learn next.
          </p>
          <div class="learn-hero-actions">
            <a href="#study-plan" class="learn-btn learn-btn-primary">FIND MY NEXT KOREAN LESSON →</a>
          </div>
          <div class="learn-trust-row">
            <span>Only 5 questions</span>
            <span>Personalized to you</span>
            <span>Free verified resources</span>
          </div>
          <div class="learn-hero-time">About 30 seconds</div>

          <div class="learn-hero-visual" aria-label="Korean city and traditional architecture">
            <img
              src="data:image/jpeg;base64,"
              alt="Korean city and traditional architecture"
              loading="eager"
            />
            <span>Korean for real life.</span>
          </div>
        </div>

        <div class="learn-phrase-card">
          <div class="learn-phrase-label">USE THIS TODAY</div>
          <strong class="learn-phrase-ko">이거 주세요.</strong>
          <div class="learn-phrase-roman">I-geo ju-se-yo.</div>
          <div class="learn-phrase-en">“This one, please.”</div>
          <div class="learn-phrase-rule"></div>
          <p>Use it when pointing to something you want to order or buy.</p>
        </div>
      </div>
    </section>

    <!-- PERSONALIZED STUDY PLAN -->
    <section id="study-plan" class="learn-plan-section">
      <div class="wrap">
        <div class="learn-planner-label">KOREAN LESSON NAVIGATOR</div>

        <div class="learn-progress-box" aria-live="polite">
          <div class="learn-progress-meta">
            <strong id="learn-progress-text">1 / 5</strong>
            <span>About 30 seconds total</span>
          </div>
          <div class="learn-progress-track" aria-hidden="true">
            <span id="learn-progress-bar"></span>
          </div>
        </div>

        <div class="learn-plan-builder learn-plan-progressive">

          <div class="learn-question is-open" data-plan-step="goal">
            <div class="learn-question-top">
              <div class="learn-question-number">01</div>
              <div>
                <h3>Why are you learning Korean?</h3>
                <p>Choose your main goal.</p>
              </div>
            </div>
            <div class="learn-question-options" data-options="goal">
              <div class="learn-option-grid">
                <button type="button" data-plan-option data-step="goal" data-value="travel">Travel</button>
                <button type="button" data-plan-option data-step="goal" data-value="life">Live in Korea</button>
                <button type="button" data-plan-option data-step="goal" data-value="work">Work / Business</button>
                <button type="button" data-plan-option data-step="goal" data-value="social">Friends / Dating</button>
                <button type="button" data-plan-option data-step="goal" data-value="topik">TOPIK</button>
                <button type="button" data-plan-option data-step="goal" data-value="culture">K-pop / Drama</button>
              </div>
            </div>
            <div class="learn-step-complete" data-complete="goal" hidden>
              <span>✓ <strong data-summary="goal"></strong></span>
              <button type="button" data-change-step="goal">CHANGE</button>
            </div>
          </div>

          <div class="learn-question" data-plan-step="level" hidden>
            <div class="learn-question-top">
              <div class="learn-question-number">02</div>
              <div>
                <h3>What’s your current level?</h3>
                <p>Choose the option that fits you best.</p>
              </div>
            </div>
            <div class="learn-question-options" data-options="level">
              <div class="learn-option-grid learn-level-grid">
                <button class="learn-level-option" type="button" data-plan-option data-step="level" data-value="zero">
                  <strong>Complete beginner</strong>
                  <small>I can’t read Hangul yet.</small>
                </button>
                <button class="learn-level-option" type="button" data-plan-option data-step="level" data-value="beginner">
                  <strong>Beginner</strong>
                  <small>I can read Hangul and make basic sentences.</small>
                </button>
                <button class="learn-level-option" type="button" data-plan-option data-step="level" data-value="intermediate">
                  <strong>Intermediate</strong>
                  <small>I can handle simple conversations but struggle at natural speed.</small>
                </button>
                <button class="learn-level-option" type="button" data-plan-option data-step="level" data-value="advanced">
                  <strong>Advanced</strong>
                  <small>I can discuss most topics but want more natural Korean.</small>
                </button>
                <button class="learn-level-option" type="button" data-plan-option data-step="level" data-value="unsure">
                  <strong>I’m not sure</strong>
                  <small>We’ll suggest a safe starting point.</small>
                </button>
              </div>
            </div>
            <div class="learn-step-complete" data-complete="level" hidden>
              <span>✓ <strong data-summary="level"></strong></span>
              <button type="button" data-change-step="level">CHANGE</button>
            </div>
          </div>

          <div class="learn-question" data-plan-step="time" hidden>
            <div class="learn-question-top">
              <div class="learn-question-number">03</div>
              <div>
                <h3>How much time can you study?</h3>
                <p>Choose what you can actually keep up.</p>
              </div>
            </div>
            <div class="learn-question-options" data-options="time">
              <div class="learn-option-grid">
                <button type="button" data-plan-option data-step="time" data-value="10">10 min / day</button>
                <button type="button" data-plan-option data-step="time" data-value="30">30 min / day</button>
                <button type="button" data-plan-option data-step="time" data-value="60">1 hour / day</button>
                <button type="button" data-plan-option data-step="time" data-value="weekend">A few hours / week</button>
              </div>
            </div>
            <div class="learn-step-complete" data-complete="time" hidden>
              <span>✓ <strong data-summary="time"></strong></span>
              <button type="button" data-change-step="time">CHANGE</button>
            </div>
          </div>

          <div class="learn-question" data-plan-step="focus" hidden>
            <div class="learn-question-top">
              <div class="learn-question-number">04</div>
              <div>
                <h3>What feels hardest?</h3>
                <p>Choose the problem that sounds most like you.</p>
              </div>
            </div>
            <div class="learn-question-options" data-options="focus">
              <div class="learn-option-grid">
                <button type="button" data-plan-option data-step="focus" data-value="speaking">I know words but can’t speak</button>
                <button type="button" data-plan-option data-step="focus" data-value="listening">Koreans speak too fast</button>
                <button type="button" data-plan-option data-step="focus" data-value="reading">Reading Korean is slow</button>
                <button type="button" data-plan-option data-step="focus" data-value="writing">Writing messages is difficult</button>
                <button type="button" data-plan-option data-step="focus" data-value="unsure">I’m not sure yet</button>
              </div>
            </div>
            <div class="learn-step-complete" data-complete="focus" hidden>
              <span>✓ <strong data-summary="focus"></strong></span>
              <button type="button" data-change-step="focus">CHANGE</button>
            </div>
          </div>

          <div class="learn-question" data-plan-step="context" hidden>
            <div class="learn-question-top">
              <div class="learn-question-number">05</div>
              <div>
                <h3 id="learn-context-title">One last question</h3>
                <p id="learn-context-help">This helps us choose what matters most right now.</p>
              </div>
            </div>
            <div class="learn-question-options" data-options="context">
              <div class="learn-option-grid" id="learn-context-options"></div>
            </div>
            <div class="learn-step-complete" data-complete="context" hidden>
              <span>✓ <strong data-summary="context"></strong></span>
              <button type="button" data-change-step="context">CHANGE</button>
            </div>
          </div>
        </div>

        <div class="learn-plan-action" id="learn-plan-action" hidden>
          <button id="generate-korean-plan" type="button" class="learn-btn learn-btn-primary">
            SHOW ME WHAT TO LEARN NEXT →
          </button>
          <p id="learn-plan-message"></p>
        </div>

        <!-- GENERATED RESULT -->
        <div id="korean-plan-result" class="learn-plan-result" hidden>
          <div id="learn-return-banner" class="learn-return-banner" hidden>
            <div>
              <strong>WELCOME BACK</strong>
              <span>Continue where you left off.</span>
            </div>
            <button type="button" id="learn-return-continue">CONTINUE →</button>
          </div>

          <div class="learn-result-head">
            <div class="learn-result-main">
              <div class="eyebrow">YOUR KOREAN PATH</div>
              <h2>YOUR KOREAN PATH</h2>
              <div id="learn-result-profile" class="learn-result-profile"></div>
              <div class="learn-result-plan-row">
                <span id="learn-result-title" class="learn-plan-chip">Korean Path</span>
                <a class="learn-change-plan" href="#study-plan">CHANGE</a>
              </div>
            </div>
          </div>

          <div class="learn-result-actions" aria-label="Plan actions">
            <button type="button" id="save-korean-plan">SAVE</button>
            <button type="button" id="share-korean-plan">SHARE</button>
            <button type="button" id="print-korean-plan">PRINT</button>
          </div>

          <details class="learn-path-details">
            <summary>VIEW MY PATH DETAILS <span>+</span></summary>
            <div class="learn-plan-summary">
              <div class="learn-plan-summary-item">
                <small>YOUR TARGET</small>
                <strong id="learn-plan-target"></strong>
              </div>
              <div class="learn-plan-summary-item">
                <small>STUDY COMMITMENT</small>
                <strong id="learn-plan-commitment"></strong>
              </div>
              <div class="learn-plan-summary-item">
                <small>PRIMARY FOCUS</small>
                <strong id="learn-plan-focus"></strong>
              </div>
              <div class="learn-plan-summary-item">
                <small>SKIP FOR NOW</small>
                <strong id="learn-plan-skip"></strong>
              </div>
            </div>
          </details>

          <!-- TODAY -->
          <section class="learn-today-card" id="learn-today-card">
            <div class="learn-today-label-row">
              <div class="learn-week-resource-label">YOUR NEXT LESSON</div>
              <span class="learn-day-badge">DAY 1</span>
            </div>

            <div class="learn-today-resource-row">
              <div class="learn-today-thumb">
                <img id="learn-today-thumb" alt="" loading="lazy" hidden />
                <div id="learn-today-thumb-fallback" class="learn-today-thumb-fallback">
                  <strong>KOREAN</strong>
                  <span>LESSON</span>
                </div>
              </div>
              <div class="learn-today-top">
                <div>
                  <h3 id="learn-today-title"></h3>
                  <small id="learn-today-provider" class="learn-today-provider"></small>
                </div>
                <strong id="learn-today-duration"></strong>
              </div>
            </div>

            <div class="learn-today-why">
              <div class="learn-week-resource-label">WHY THIS NOW</div>
              <p id="learn-why-now-copy"></p>
            </div>

            <a
              id="learn-today-link"
              class="learn-btn learn-btn-primary"
              href="#"
              target="_blank"
              rel="noopener noreferrer"
              data-resource-link="today"
            >
              START THIS LESSON →
            </a>

            <details class="learn-today-steps">
              <summary>3-STEP PLAN <span>+</span></summary>
              <ol>
                <li id="learn-today-step-one"></li>
                <li id="learn-today-step-two"></li>
                <li id="learn-today-step-three"></li>
              </ol>
            </details>
          </section>

          <!-- PHASES -->
          <div class="learn-path-heading">
            <h3>YOUR PATH</h3>
            <span>3 phases</span>
          </div>
          <div class="learn-week-list learn-phase-list">

            <details class="learn-phase-accordion" data-phase-details="one">
              <summary>
                <span class="learn-phase-number">1</span>
                <span class="learn-phase-summary-copy">
                  <small id="phase-one-status">CURRENT · FOUNDATION</small>
                  <strong id="phase-one-title"></strong>
                </span>
                <span class="learn-phase-toggle">+</span>
              </summary>
              <div class="learn-phase-body">
                <div class="learn-week-purpose" id="phase-one-purpose">FOUNDATION</div>
                <p id="phase-one-copy"></p>
                <div class="learn-week-time">Recommended pace: <strong id="phase-one-time"></strong></div>
                <div class="learn-week-resource" data-resource-card="one">
                  <div class="learn-week-resource-label">NEXT LESSON</div>
                  <div class="learn-week-resource-provider"><span id="phase-one-provider"></span><span class="learn-free-badge">FREE</span></div>
                  <h4 id="phase-one-resource-title"></h4>
                  <p id="phase-one-resource-reason"></p>

                  <details class="learn-why-picked">
                    <summary>WHY WE PICKED THIS <span>+</span></summary>
                    <div class="learn-why-picked-body">
                      <div class="learn-resource-meta"><span id="phase-one-best-for"></span><span id="phase-one-checked"></span></div>
                      <p class="learn-not-ideal"><strong>Not ideal for:</strong> <span id="phase-one-not-for"></span></p>
                      <details class="learn-sik-check" aria-label="Seen in Korea verification summary">
                        <summary class="learn-sik-check-head"><span>SIK CHECK</span><strong id="phase-one-confidence"></strong><b>+</b></summary>
                        <div class="learn-sik-check-grid">
                          <span>Official source</span><strong id="phase-one-check-official"></strong>
                          <span>Free access</span><strong id="phase-one-check-free"></strong>
                          <span>Level fit</span><strong id="phase-one-check-level"></strong>
                          <span>Independent evidence</span><strong id="phase-one-check-independent"></strong>
                        </div>
                        <small id="phase-one-last-checked"></small>
                      </details>
                    </div>
                  </details>

                  <div class="learn-resource-actions">
                    <a id="phase-one-resource-link" href="#" target="_blank" rel="noopener noreferrer" data-resource-link="one">START LESSON →</a>
                    <button type="button" data-alt-resource="one">TRY ANOTHER</button>
                    <button type="button" data-resource-complete="one">I FINISHED THIS</button>
                  </div>
                  <div class="learn-difficulty" data-difficulty-panel="one" hidden>
                    <strong>How did it feel?</strong>
                    <div>
                      <button type="button" data-difficulty="easy" data-phase="one">TOO EASY</button>
                      <button type="button" data-difficulty="right" data-phase="one">JUST RIGHT</button>
                      <button type="button" data-difficulty="hard" data-phase="one">TOO HARD</button>
                    </div>
                    <p data-adaptation-note="one"></p>
                  </div>
                </div>
              </div>
            </details>

            <details class="learn-phase-accordion" data-phase-details="two">
              <summary>
                <span class="learn-phase-number">2</span>
                <span class="learn-phase-summary-copy">
                  <small id="phase-two-status">NEXT · YOUR GOAL</small>
                  <strong id="phase-two-title"></strong>
                </span>
                <span class="learn-phase-toggle">+</span>
              </summary>
              <div class="learn-phase-body">
                <div class="learn-week-purpose" id="phase-two-purpose">YOUR GOAL</div>
                <p id="phase-two-copy"></p>
                <div class="learn-week-time">Recommended pace: <strong id="phase-two-time"></strong></div>
                <div class="learn-week-resource" data-resource-card="two">
                  <div class="learn-week-resource-label">NEXT LESSON</div>
                  <div class="learn-week-resource-provider"><span id="phase-two-provider"></span><span class="learn-free-badge">FREE</span></div>
                  <h4 id="phase-two-resource-title"></h4>
                  <p id="phase-two-resource-reason"></p>
                  <details class="learn-why-picked">
                    <summary>WHY WE PICKED THIS <span>+</span></summary>
                    <div class="learn-why-picked-body">
                      <div class="learn-resource-meta"><span id="phase-two-best-for"></span><span id="phase-two-checked"></span></div>
                      <p class="learn-not-ideal"><strong>Not ideal for:</strong> <span id="phase-two-not-for"></span></p>
                      <details class="learn-sik-check" aria-label="Seen in Korea verification summary">
                        <summary class="learn-sik-check-head"><span>SIK CHECK</span><strong id="phase-two-confidence"></strong><b>+</b></summary>
                        <div class="learn-sik-check-grid">
                          <span>Official source</span><strong id="phase-two-check-official"></strong>
                          <span>Free access</span><strong id="phase-two-check-free"></strong>
                          <span>Level fit</span><strong id="phase-two-check-level"></strong>
                          <span>Independent evidence</span><strong id="phase-two-check-independent"></strong>
                        </div>
                        <small id="phase-two-last-checked"></small>
                      </details>
                    </div>
                  </details>
                  <div class="learn-resource-actions">
                    <a id="phase-two-resource-link" href="#" target="_blank" rel="noopener noreferrer" data-resource-link="two">START LESSON →</a>
                    <button type="button" data-alt-resource="two">TRY ANOTHER</button>
                    <button type="button" data-resource-complete="two">I FINISHED THIS</button>
                  </div>
                  <div class="learn-difficulty" data-difficulty-panel="two" hidden>
                    <strong>How did it feel?</strong>
                    <div>
                      <button type="button" data-difficulty="easy" data-phase="two">TOO EASY</button>
                      <button type="button" data-difficulty="right" data-phase="two">JUST RIGHT</button>
                      <button type="button" data-difficulty="hard" data-phase="two">TOO HARD</button>
                    </div>
                    <p data-adaptation-note="two"></p>
                  </div>
                </div>
              </div>
            </details>

            <details class="learn-phase-accordion learn-sik-practice-phase" data-phase-details="three">
              <summary>
                <span class="learn-phase-number">3</span>
                <span class="learn-phase-summary-copy">
                  <small id="phase-three-status">NEXT · PRACTICE</small>
                  <strong id="phase-three-title"></strong>
                </span>
                <span class="learn-phase-toggle">+</span>
              </summary>

              <div class="learn-phase-body">
                <div class="learn-week-purpose">SIK PRACTICE</div>
                <p id="phase-three-copy"></p>

                <div class="learn-week-time">
                  Suggested practice: <strong id="phase-three-time"></strong>
                </div>

                <div class="learn-practice-card">
                  <div class="learn-week-resource-label">YOUR PRACTICE</div>
                  <h4 id="phase-three-practice-title"></h4>
                  <p id="phase-three-practice-scenario"></p>

                  <button
                    type="button"
                    id="start-sik-practice"
                    class="learn-practice-start"
                  >
                    START MY PRACTICE →
                  </button>

                  <div id="sik-practice-panel" class="learn-practice-panel" hidden>
                    <div class="learn-practice-prompt">
                      <div class="learn-week-resource-label">REAL-LIFE PROMPT</div>
                      <strong id="phase-three-prompt-ko" lang="ko"></strong>
                      <p id="phase-three-prompt-en"></p>
                    </div>

                    <div class="learn-practice-target">
                      <span>YOUR TARGET</span>
                      <p id="phase-three-level-target"></p>
                    </div>

                    <ol class="learn-practice-steps">
                      <li>
                        <span>1</span>
                        <p id="phase-three-step-one"></p>
                      </li>
                      <li>
                        <span>2</span>
                        <p id="phase-three-step-two"></p>
                      </li>
                      <li>
                        <span>3</span>
                        <p id="phase-three-step-three"></p>
                      </li>
                    </ol>

                    <button
                      type="button"
                      id="show-sik-practice-answer"
                      class="learn-practice-answer-toggle"
                    >
                      SHOW ONE NATURAL RESPONSE →
                    </button>

                    <div id="sik-practice-answer" class="learn-practice-answer" hidden>
                      <small>ONE NATURAL RESPONSE</small>
                      <strong id="phase-three-answer-ko" lang="ko"></strong>
                      <p id="phase-three-answer-en"></p>

                      <div class="learn-practice-keyphrase">
                        <span>KEY PHRASE</span>
                        <strong id="phase-three-keyphrase-ko" lang="ko"></strong>
                        <small id="phase-three-keyphrase-en"></small>
                      </div>
                    </div>

                    <div class="learn-practice-actions">
                      <button
                        type="button"
                        id="next-sik-practice-scenario"
                        class="learn-practice-another"
                      >
                        TRY ANOTHER SCENARIO
                      </button>

                      <button
                        type="button"
                        id="complete-sik-practice"
                        class="learn-practice-complete"
                      >
                        I FINISHED THIS
                      </button>
                    </div>

                    <div id="sik-practice-feedback" class="learn-difficulty learn-practice-feedback" hidden>
                      <strong>How did it feel?</strong>
                      <div>
                        <button type="button" data-practice-difficulty="easy">TOO EASY</button>
                        <button type="button" data-practice-difficulty="right">JUST RIGHT</button>
                        <button type="button" data-practice-difficulty="hard">TOO HARD</button>
                      </div>
                    </div>

                    <p id="sik-practice-status" class="learn-practice-status"></p>
                  </div>
                </div>
              </div>
            </details>

            <!-- FINAL TEST -->
            <details class="learn-phase-accordion learn-support-accordion learn-final-accordion">
              <summary>
                <span class="learn-phase-number">★</span>
                <span class="learn-phase-summary-copy">
                  <small id="learn-final-purpose">REAL-LIFE TEST</small>
                  <strong id="learn-final-title">See if you can actually use it.</strong>
                </span>
                <span class="learn-phase-toggle">+</span>
              </summary>
              <div class="learn-phase-body">
                <p id="learn-final-copy"></p>
                <a id="learn-final-link" href="#tutor" class="learn-inline-action">TAKE MY REAL-LIFE TEST →</a>
              </div>
            </details>
          </div>
        </div>
          <a id="learn-mobile-sticky" class="learn-mobile-sticky" href="#" target="_blank" rel="noopener noreferrer" data-resource-link="today" hidden>
            START TODAY · <span id="learn-mobile-sticky-time">10 MIN</span> →
          </a>
      </div>
    </section>

    <!-- HOW WE CURATE -->
    <section id="resources" class="learn-resources" hidden>
      <div class="wrap">
        <div class="section-head">
          <div>
            <div class="eyebrow">HOW WE PICK RESOURCES</div>
            <h2>One next step, not 50 links.</h2>
          </div>
          <p>
            We check level fit, current access, practical value
            and where each resource falls short.
          </p>
        </div>

        <div class="learn-methodology-strip learn-methodology-strip-simple">
          <span>Level fit</span>
          <span>Free access</span>
          <span>Practical use</span>
          <span>Clear limits</span>
        </div>

        <p class="learn-methodology-note">
          Recommendations are filtered for eligibility first, then ranked for your goal and situation.
          SIK Practice uses original real-life prompts and prioritizes scenarios close to your current level.
        </p>
      </div>
    </section>

    <!-- SITUATIONS -->
    <section id="situations" class="learn-situations" hidden>
      <div class="wrap">
        <div class="section-head">
          <div>
            <div class="eyebrow">PRACTICE BEFORE REAL LIFE</div>
            <h2>Learn by situation.</h2>
          </div>
          <p>Learn it. Then use it in a real situation.</p>
        </div>

        <div class="learn-situation-grid">
          <article><span>01</span><h3>Restaurant</h3><p>Order food, ask questions and pay.</p></article>
          <article><span>02</span><h3>Shopping</h3><p>Ask about products, sizes and prices.</p></article>
          <article><span>03</span><h3>Taxi & Transport</h3><p>Explain destinations and understand directions.</p></article>
          <article><span>04</span><h3>Bookings</h3><p>Make and change reservations or appointments.</p></article>
