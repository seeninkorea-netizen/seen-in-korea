        week2:
          'Learn expressions, reactions and vocabulary that repeatedly appear in Korean entertainment and everyday speech.',

        week3Title:
          'Listen without subtitles first',

        week3:
          'Use short clips and repeated listening to recognize natural pronunciation, speed and common speech patterns.',

        skip:
          'Formal business language and advanced writing'
      }

    };


    const levelPlans = {

      zero: {
        label: 'Complete beginner',

        week1Title:
          'Hangul + essential survival Korean',

        week1:
          'Start with Hangul, pronunciation and a very small group of expressions you can use immediately. Avoid large vocabulary lists for now.'
      },


      beginner: {
        label: 'Beginner',

        week1Title:
          'Turn basic Korean into usable Korean',

        week1:
          'Strengthen essential sentence patterns and practical vocabulary around situations you are actually likely to face.'
      },


      intermediate: {
        label: 'Intermediate',

        week1Title:
          'Find the gaps in your Korean',

        week1:
          'Identify where your listening or speaking breaks down and begin turning vocabulary you already know into faster, more natural responses.'
      },


      advanced: {
        label: 'Advanced',

        week1Title:
          'Make your Korean sound more natural',

        week1:
          'Focus on nuance, natural phrasing, response speed and the difference between grammatically correct Korean and Korean people actually use.'
      }

    };


    const focusPlans = {

      speaking: {
        label: 'Speaking',

        strategy:
          'Speaking-first',

        description:
          'Your plan emphasizes producing Korean, role-play and answering without translating first.'
      },


      listening: {
        label: 'Listening',

        strategy:
          'Listening-first',

        description:
          'Your plan emphasizes understanding natural speed, recognizing spoken patterns and responding to what you hear.'
      },


      reading: {
        label: 'Reading',

        strategy:
          'Reading-first',

        description:
          'Your plan emphasizes Hangul fluency and understanding practical Korean you encounter in real life.'
      },


      writing: {
        label: 'Writing',

        strategy:
          'Writing-first',

        description:
          'Your plan emphasizes practical sentence construction, messaging and useful written Korean.'
      },


      unsure: {
        label: 'Balanced',

        strategy:
          'Balanced foundation',

        description:
          'Your plan balances speaking, listening, reading and vocabulary until your strongest learning need becomes clearer.'
      }

    };


    const timePlans = {

      '10': {
        commitment:
          '10 min/day · about 50 min/week',

        week:
          '10 minutes a day, 5 days'
      },


      '30': {
        commitment:
          '30 min/day · about 2.5 hours/week',

        week:
          '30 minutes a day, 5 days'
      },


      '60': {
        commitment:
          '1 hour/day · about 5 hours/week',

        week:
          '1 hour a day, 5 days'
      },


      weekend: {
        commitment:
          'A few focused hours each week',

        week:
          '2–3 focused study sessions'
      }

    };


    let restoringPlan = false;


    function getButtonValue(button, step) {
      return button.dataset[step];
    }


    function isValidSelection(step, value) {
      return Boolean(
        value &&
        labels[step]?.[value]
      );
    }


    function resetStepsAfter(step) {

      const currentIndex =
        stepOrder.indexOf(step);


      stepOrder.forEach(
        (name, index) => {

          if (index <= currentIndex) return;


          selections[name] = null;


          const stepElement =
            document.querySelector(
              `[data-plan-step="${name}"]`
            );


          const options =
            document.querySelector(
              `[data-options="${name}"]`
            );


          const complete =
            document.querySelector(
              `[data-complete="${name}"]`
            );


          stepElement?.setAttribute(
            'hidden',
            ''
          );


          stepElement?.classList.remove(
            'is-open',
            'is-complete'
          );


          options?.removeAttribute(
            'hidden'
          );


          complete?.setAttribute(
            'hidden',
            ''
          );


          document
            .querySelectorAll(
              `[data-${name}]`
            )
            .forEach(
              (button) => {
                button.classList.remove(
                  'is-selected'
                );
              }
            );

        }
      );


      document
        .getElementById(
          'learn-plan-action'
        )
        ?.setAttribute(
          'hidden',
          ''
        );


      document
        .getElementById(
          'korean-plan-result'
        )
        ?.setAttribute(
          'hidden',
          ''
        );

    }


    function revealNextStep(step) {

      const index =
        stepOrder.indexOf(step);


      const nextStep =
        stepOrder[index + 1];


      if (!nextStep) {

        document
          .getElementById(
            'learn-plan-action'
          )
          ?.removeAttribute(
            'hidden'
          );

        return;
      }


      const nextElement =
        document.querySelector(
          `[data-plan-step="${nextStep}"]`
        );


      nextElement?.removeAttribute(
        'hidden'
      );


      nextElement?.classList.add(
        'is-open'
      );


      if (!restoringPlan) {

        setTimeout(() => {

          nextElement?.scrollIntoView({
            behavior: 'smooth',
            block: 'center'
          });

        }, 120);

      }

    }


    function completeStep(
      step,
      value
    ) {

      selections[step] = value;


      resetStepsAfter(step);


      const stepElement =
        document.querySelector(
          `[data-plan-step="${step}"]`
        );


      const options =
        document.querySelector(
          `[data-options="${step}"]`
        );


      const complete =
        document.querySelector(
          `[data-complete="${step}"]`
        );


      const summary =
        document.querySelector(
          `[data-summary="${step}"]`
        );


      document
        .querySelectorAll(
          `[data-${step}]`
        )
        .forEach(
          (button) => {

            button.classList.toggle(
              'is-selected',
              getButtonValue(
                button,
                step
              ) === value
            );

          }
        );


      if (summary) {

        summary.textContent =
          labels[step]?.[value] ||
          value;

      }


      options?.setAttribute(
        'hidden',
        ''
      );


      complete?.removeAttribute(
        'hidden'
      );


      stepElement?.classList.remove(
        'is-open'
      );


      stepElement?.classList.add(
        'is-complete'
      );


      revealNextStep(step);

    }


    stepOrder.forEach(
      (step) => {

        document
          .querySelectorAll(
            `[data-${step}]`
          )
          .forEach(
            (button) => {

              button.addEventListener(
                'click',
                () => {

                  const value =
                    getButtonValue(
                      button,
                      step
                    );


                  completeStep(
                    step,
                    value
                  );

                }
              );

            }
          );

      }
    );


    document
      .querySelectorAll(
        '[data-change-step]'
      )
      .forEach(
        (button) => {

          button.addEventListener(
            'click',
            () => {

              const step =
                button.dataset.changeStep;


              resetStepsAfter(step);


              selections[step] = null;


              const stepElement =
                document.querySelector(
                  `[data-plan-step="${step}"]`
                );


              const options =
                document.querySelector(
                  `[data-options="${step}"]`
                );


              const complete =
                document.querySelector(
                  `[data-complete="${step}"]`
                );


              stepElement?.classList.remove(
                'is-complete'
              );


              stepElement?.classList.add(
                'is-open'
              );


              options?.removeAttribute(
                'hidden'
              );


              complete?.setAttribute(
                'hidden',
                ''
              );


              stepElement?.scrollIntoView({
                behavior: 'smooth',
                block: 'center'
              });

            }
          );

        }
      );


    const generateButton =
      document.getElementById(
        'generate-korean-plan'
      );


    const result =
      document.getElementById(
        'korean-plan-result'
      );


    const message =
      document.getElementById(
        'learn-plan-message'
      );


    function setText(
      id,
      value
    ) {

      const element =
        document.getElementById(id);


      if (element) {
        element.textContent = value;
      }

    }


    function renderPlan(
      { scroll = true } = {}
    ) {

      if (
        !selections.goal ||
        !selections.level ||
        !selections.time ||
        !selections.focus
      ) {

        if (message) {

          message.textContent =
            'Please complete all four steps first.';

        }


        return false;
      }


      const goal =
        goalPlans[
          selections.goal
        ];


      const level =
        levelPlans[
          selections.level
        ];


      const focus =
        focusPlans[
          selections.focus
        ];


      const time =
        timePlans[
          selections.time
        ];


      const timeLabel =
        labels.time[
          selections.time
        ];


      const focusLabel =
        labels.focus[
          selections.focus
        ];


      setText(
        'learn-result-profile',
        `${goal.label} · ${level.label} · ${timeLabel} · ${focusLabel}`
      );


      setText(
        'learn-plan-target',
        goal.target
      );


      setText(
        'learn-plan-commitment',
        time.commitment
      );


      setText(
        'learn-plan-focus',
        focus.strategy
      );


      setText(
        'learn-plan-skip',
        goal.skip
      );


      setText(
        'week-one-title',
        level.week1Title
      );


      setText(
        'week-one-copy',
        `${level.week1} ${focus.description}`
      );


      setText(
        'week-two-title',
        goal.week2Title
      );


      setText(
        'week-two-copy',
        goal.week2
      );


      setText(
        'week-three-title',
        goal.week3Title
      );


      setText(
        'week-three-copy',
        goal.week3
      );


      [
        'week-one-time',
        'week-two-time',
        'week-three-time'
      ].forEach(
        (id) => {

          setText(
            id,
            time.week
          );

        }
      );


      result?.removeAttribute(
        'hidden'
      );


      if (message) {

        message.textContent =
          'Your Korean plan is ready.';

      }


      if (scroll) {

        result?.scrollIntoView({
          behavior: 'smooth',
          block: 'start'
        });

      }


      return true;

    }


    generateButton?.addEventListener(
      'click',
      () => {

        if (
          !selections.goal ||
          !selections.level ||
          !selections.time ||
          !selections.focus
        ) {

          if (message) {

            message.textContent =
              'Please complete all four steps first.';

          }


          return;
        }


        if (message) {

          message.textContent =
            'Building your personalized plan...';

        }


        setTimeout(
          () => {
            renderPlan();
          },
          450
        );

      }
    );


    document
      .getElementById(
        'save-korean-plan'
      )
      ?.addEventListener(
        'click',
        () => {

          if (
            !renderPlan({
              scroll: false
            })
          ) {
            return;
          }


          localStorage.setItem(
            STORAGE_KEY,
            JSON.stringify(
              selections
            )
          );


          if (message) {

            message.textContent =
              'Plan saved on this device.';

          }

        }
      );


    document
      .getElementById(
        'share-korean-plan'
      )
      ?.addEventListener(
        'click',
        async () => {

          if (
            !renderPlan({
              scroll: false
            })
          ) {
            return;
          }


          const url =
            new URL(
              window.location.href
            );


          stepOrder.forEach(
            (step) => {

              url.searchParams.set(
                step,
                selections[step]
              );

            }
          );


          url.hash =
            'korean-plan-result';


          const shareData = {

            title:
              'My Korean Study Plan — Seen in Korea',

            text:
              'Here is my personalized Korean study plan.',

            url:
              url.toString()

          };


          try {

            if (navigator.share) {

              await navigator.share(
                shareData
              );

            } else {

              await navigator.clipboard.writeText(
                url.toString()
              );


              if (message) {

                message.textContent =
                  'Share link copied.';

              }

            }

          } catch (error) {

            if (
              error?.name !==
                'AbortError' &&
              message
            ) {

              message.textContent =
                'Could not share automatically. Copy the page URL and try again.';

            }

          }

        }
      );


    document
      .getElementById(
        'print-korean-plan'
      )
      ?.addEventListener(
        'click',
        () => {

          if (
            !renderPlan({
              scroll: false
            })
          ) {
            return;
          }


          window.print();

        }
      );


    function restorePlan(values) {

      const valid =
        stepOrder.every(
          (step) =>
            isValidSelection(
              step,
              values?.[step]
            )
        );


      if (!valid) {
        return false;
      }


      restoringPlan = true;


      stepOrder.forEach(
        (step) => {

          completeStep(
            step,
            values[step]
          );

        }
      );


      restoringPlan = false;


      renderPlan({
        scroll: false
      });


      return true;

    }


    const queryValues = {};


    const params =
      new URLSearchParams(
        window.location.search
      );


    stepOrder.forEach(
      (step) => {

        queryValues[step] =
          params.get(step);

      }
    );


    const restoredFromUrl =
      restorePlan(
        queryValues
      );


    if (!restoredFromUrl) {

      try {

        const savedPlan =
          JSON.parse(
            localStorage.getItem(
              STORAGE_KEY
            ) || 'null'
          );


        if (savedPlan) {

          restorePlan(
            savedPlan
          );

        }

      } catch (error) {

        localStorage.removeItem(
          STORAGE_KEY
        );

      }

    }

  </script>

</BaseLayout>
