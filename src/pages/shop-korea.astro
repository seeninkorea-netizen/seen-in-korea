---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getArticlesBySection, getProducts } from '../lib/content';

const [articles, products] = await Promise.all([
  getArticlesBySection('shop-korea'),
  getProducts(60)
]);
---
<BaseLayout title="Shop Korea — Seen in Korea" description="Verified Korean shopping stories, product discovery, pricing and retailer intelligence.">
  <main>
    <section class="listing-hero">
      <div class="wrap">
        <div class="eyebrow">SHOPPING · PRODUCT INTELLIGENCE</div>
        <h1>SHOP KOREA</h1>
        <p>Discover first. Verify second. Compare price third. Buy only when the numbers make sense.</p>
      </div>
    </section>

    <section>
      <div class="wrap">
        <div class="section-head archive-section-head"><div><div class="eyebrow">SHOPPING STORIES</div><h2>What people are actually buying</h2></div><a class="link" href="/articles">ALL STORIES →</a></div>
        <div class="listing-grid">{articles.length ? articles.map(article => <ArticleCard article={article} />) : <p>No published Shop Korea stories yet.</p>}</div>
      </div>
    </section>

    <section class="archive-subsection">
      <div class="wrap">
        <div class="section-head"><div><div class="eyebrow">PRODUCT DATABASE</div><h2>Verified products</h2></div><p>Product records, market prices and retailer intelligence live here separately from editorial stories.</p></div>
        <div class="shop-grid">{products.length ? products.map(product => <article class="shop-card"><div class="product-art">{product.imageUrl ? <img src={product.imageUrl} alt={`${product.brand} ${product.name}`} /> : '◒'}</div><div class="meta"><span>{product.brand}</span><span>{product.category || 'K-Product'}</span></div><h3>{product.name}</h3><p>{product.summary}</p>{product.celebrity && <p><strong>Related:</strong> {product.celebrity} · {product.verification}</p>}<div class="price-pair"><span>KR {product.koreaPrice || '—'}</span><span>GLOBAL {product.globalPrice || '—'}</span></div><div class="verify">{product.exportCandidate ? 'Won Global candidate' : 'Affiliate / intelligence test'}</div></article>) : <p>No product records yet.</p>}</div>
      </div>
    </section>
  </main>
</BaseLayout>
