---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getArticlesBySection } from '../../lib/content';

const { slug } = Astro.params;
const sectionMap = {
  'trending': {
    title: 'Trending',
    eyebrow: 'WHAT’S MOVING NOW',
    description: 'Fast-moving Korea stories with a reason to care — culture, markets, products and distribution shifts.'
  },
  'seen-on': {
    title: 'Seen On',
    eyebrow: 'VERIFY BEFORE YOU BUY',
    description: 'Celebrity attention, campaign evidence and product intelligence — with official confirmation separated from fan speculation.'
  }
};

const section = slug ? sectionMap[slug] : undefined;
if (!section) return Astro.redirect('/404');
const articles = await getArticlesBySection(slug!);
---
<BaseLayout title={`${section.title} — Seen in Korea`} description={section.description}>
  <main>
    <section class="listing-hero">
      <div class="wrap">
        <div class="eyebrow">{section.eyebrow}</div>
        <h1>{section.title.toUpperCase()}</h1>
        <p>{section.description}</p>
      </div>
    </section>
    <section>
      <div class="wrap">
        <div class="archive-topline"><span>{articles.length} PUBLISHED STORIES</span><a href="/articles">VIEW ALL STORIES →</a></div>
        <div class="listing-grid">{articles.length ? articles.map(article => <ArticleCard article={article} />) : <p>No published stories yet.</p>}</div>
      </div>
    </section>
  </main>
</BaseLayout>
