---
import BaseLayout from '../layouts/BaseLayout.astro';

const levels = [
  {
    number: '01',
    key: 'confirmed',
    title: 'CONFIRMED USE',
    short: 'Actual use is supported by attributable evidence.',
    description:
      'We found public evidence showing the person actually using, wearing or directly referring to the exact product.',
    examples:
      'Examples: attributable photo or video, first-party interview, direct statement.',
    buyRule:
      'Buying links may be shown after the exact product and current offer are checked.'
  },
  {
    number: '02',
    key: 'campaign',
    title: 'OFFICIAL CAMPAIGN',
    short: 'A commercial relationship is confirmed.',
    description:
      'The brand officially confirms an ambassador relationship, advertisement, campaign or sponsored collaboration.',
    examples:
      'This proves the campaign relationship. It does not automatically prove private everyday use.',
    buyRule:
      'Buying links may be shown, but the page must remain labeled Official Campaign.'
  },
  {
    number: '03',
    key: 'reported',
    title: 'REPORTED',
    short: 'A credible source connects the person and product.',
    description:
      'The claim is supported by credible reporting or attributable public material, but we do not have enough primary evidence to call it confirmed personal use.',
    examples:
      'Reported does not mean false. It means the evidence is weaker or more indirect.',
    buyRule:
      'Buying links are added cautiously and the evidence source should remain visible.'
  },
  {
    number: '04',
    key: 'unconfirmed',
    title: 'UNCONFIRMED',
    short: 'The claim is not strong enough to recommend as fact.',
    description:
      'The product identification relies mainly on fan speculation, reposts, vague images or sources that cannot be reliably traced.',
    examples:
      'We may show the claim for context, but we do not present it as verified.',
    buyRule:
      'No purchase recommendation should be attached solely to an unconfirmed claim.'
  }
];

const process = [
  {
    number: '01',
    title: 'Identify the exact claim',
    description:
      'What exactly are we trying to verify — the person, the product, the shade, the campaign, the price or actual personal use?'
  },
  {
    number: '02',
    title: 'Find the strongest source',
    description:
      'We prioritize original brand announcements, first-party statements, attributable photos or videos and official product information.'
  },
  {
    number: '03',
    title: 'Separate relationship from use',
    description:
      'Being a model or ambassador does not prove that someone personally uses the product outside the campaign.'
  },
  {
    number: '04',
    title: 'Identify the exact product',
    description:
      'A similar-looking item is not enough. Model, product name, variant and relevant details must match where possible.'
  },
  {
    number: '05',
    title: 'Check current price and availability',
    description:
      'Prices and buying options are checked separately from the celebrity or campaign evidence.'
  },
  {
    number: '06',
    title: 'Publish the limitation',
    description:
      'If something cannot be established, we say what remains unknown instead of filling the gap with an assumption.'
  }
];

const sourcePriority = [
  {
    level: 'STRONGEST',
    title: 'Primary evidence',
    copy:
      'Official documents, brand announcements, direct interviews, attributable first-party statements, original photos or videos and official product pages.'
  },
  {
    level: 'SUPPORTING',
    title: 'Independent reporting',
    copy:
      'Established reporting, reputable media coverage and other attributable secondary sources.'
  },
  {
    level: 'CONTEXT',
    title: 'Community evidence',
    copy:
      'Social posts, community discussions, blogs and reviews may help identify a lead but generally do not prove a claim on their own.'
  },
  {
    level: 'NOT ENOUGH',
    title: 'Untraceable claims',
    copy:
      'Reposts without an original source, anonymous claims, vague screenshots and fan speculation are not treated as verification.'
  }
];
---

<BaseLayout
  title="How We Verify — SEEN IN KOREA"
  description="How SEEN IN KOREA verifies celebrity-product claims, campaigns, reported sightings, prices and buying recommendations."
>

  <main class="verify-page">


    <!-- HERO -->
    <section class="verify-hero">

      <div class="wrap verify-hero-grid">


        <div>

          <div class="eyebrow">
            KOREA, VERIFIED.
          </div>

          <h1>
            HOW WE<br />
            VERIFY
          </h1>

        </div>


        <div class="verify-intro">

          <p class="verify-intro-lead">
            A campaign is not the same as personal use.
            A viral post is not automatically evidence.
            A buying link should come after the claim is checked.
          </p>

          <p>
            SEEN IN KOREA separates what we know,
            what the evidence actually proves,
            and what still remains uncertain.
          </p>

          <a href="/seen-on">
            SEE VERIFIED PRODUCTS →
          </a>

        </div>


      </div>

    </section>



    <!-- CORE RULE -->
    <section class="verify-rule-section">

      <div class="wrap">

        <div class="verify-rule">

          <div class="verify-rule-label">
            THE CORE RULE
          </div>

          <blockquote>
            We verify the claim first.
            We classify the evidence second.
            We add the buying option last.
          </blockquote>

        </div>

      </div>

    </section>



    <!-- EVIDENCE LEVELS -->
    <section class="verify-levels-section">

      <div class="wrap">


        <div class="verify-section-head">

          <div>

            <div class="eyebrow">
              SEEN ON · EVIDENCE LEVELS
            </div>

            <h2>
              Four labels.<br />
              Four different meanings.
            </h2>

          </div>


          <p>
            These labels describe the strength
            and type of evidence behind a claim.
            They are not product-quality scores.
          </p>

        </div>



        <div class="verify-level-grid">

          {
            levels.map(
              item => (

                <article
                  class:list={[
                    'verify-level-card',
                    item.key
                  ]}
                >

                  <div class="verify-level-top">

                    <span>
                      {item.number}
                    </span>

                    <span
                      class:list={[
                        'verify-dot',
                        item.key
                      ]}
                    ></span>

                  </div>


                  <h3>
                    {item.title}
                  </h3>


                  <strong>
                    {item.short}
                  </strong>


                  <p>
                    {item.description}
                  </p>


                  <div class="verify-example">
                    {item.examples}
                  </div>


                  <div class="verify-buy-rule">

                    <span>
                      BUYING RULE
                    </span>

                    <p>
                      {item.buyRule}
                    </p>

                  </div>

                </article>

              )
            )
          }

        </div>


        <div class="verify-warning">

          <strong>
            Important:
          </strong>

          An official campaign confirms a commercial relationship.
          It does <b>not</b> automatically mean the celebrity
          privately uses that product in everyday life.

        </div>


      </div>

    </section>



    <!-- PROCESS -->
    <section class="verify-process-section">

      <div class="wrap">


        <div class="verify-section-head">

          <div>

            <div class="eyebrow">
              THE PROCESS
            </div>

            <h2>
              From viral claim<br />
              to verified page.
            </h2>

          </div>


          <p>
            The amount of research can vary,
            but the order should stay the same.
          </p>

        </div>



        <div class="verify-process-list">

          {
            process.map(
              item => (

                <div class="verify-process-row">

                  <span class="verify-process-number">
                    {item.number}
                  </span>


                  <strong>
                    {item.title}
                  </strong>


                  <p>
                    {item.description}
                  </p>

                </div>

              )
            )
          }

        </div>


      </div>

    </section>



    <!-- SOURCE HIERARCHY -->
    <section class="verify-source-section">

      <div class="wrap verify-source-grid">


        <div>

          <div class="eyebrow">
            SOURCE PRIORITY
          </div>

          <h2>
            Not every source
            carries the same weight.
          </h2>

        </div>



        <div class="verify-source-list">

          {
            sourcePriority.map(
              item => (

                <div class="verify-source-row">

                  <span>
                    {item.level}
                  </span>


                  <div>

                    <strong>
                      {item.title}
                    </strong>

                    <p>
                      {item.copy}
                    </p>

                  </div>

                </div>

              )
            )
          }

        </div>


      </div>

    </section>



    <!-- PRODUCT ID -->
    <section class="verify-detail-section">

      <div class="wrap verify-detail-grid">


        <div>

          <div class="eyebrow">
            EXACT PRODUCT MATTERS
          </div>

          <h2>
            “Looks similar”
            is not verification.
          </h2>

        </div>


        <div>

          <p>
            A celebrity may appear with a lipstick,
            bag, skincare product or food item
            that resembles several products.
          </p>

          <p>
            We should not identify the product solely
            because it looks similar.
            Where possible, we verify the exact brand,
            product name, model, shade, size or variant.
          </p>

          <p>
            If the exact item cannot be established,
            the uncertainty should remain visible.
          </p>

        </div>


      </div>

    </section>



    <!-- PRICE -->
    <section class="verify-detail-section price-section">

      <div class="wrap verify-detail-grid">


        <div>

          <div class="eyebrow">
            PRICE VERIFICATION
          </div>

          <h2>
            Evidence and price
            are checked separately.
          </h2>

        </div>


        <div>

          <p>
            Confirming that someone appeared in a campaign
            does not tell us whether the product is
            fairly priced or where readers should buy it.
          </p>

          <p>
            We may separately check official Korea pricing,
            overseas pricing, retailer availability,
            shipping and other relevant buying conditions.
          </p>

          <p>
            Where useful, Seen in Korea can compare
            multiple buying options instead of automatically
            linking to the first store we find.
          </p>

        </div>


      </div>

    </section>



    <!-- COMMERCE -->
    <section class="verify-commerce-section">

      <div class="wrap verify-commerce-grid">


        <div>

          <div class="eyebrow">
            EDITORIAL × COMMERCE
          </div>

          <h2>
            Verification
            is not for sale.
          </h2>

        </div>



        <div class="verify-commerce-copy">

          <p>
            SEEN IN KOREA may earn revenue through
            affiliate links, advertising,
            retailer partnerships,
            sponsored offers or other commercial services.
          </p>

          <p>
            Commercial relationships do not change
            the evidence classification.
          </p>


          <div class="verify-commerce-rule">

            <span>
              OFFICIAL CAMPAIGN
            </span>

            <b>
              ≠
            </b>

            <span>
              CONFIRMED USE
            </span>

          </div>


          <p>
            A commission cannot convert
            “Reported” into “Confirmed Use.”
            A sponsorship cannot convert
            an unverified claim into a verified one.
          </p>

          <p>
            When affiliate relationships are active,
            they should be disclosed.
          </p>

        </div>


      </div>

    </section>



    <!-- UPDATES -->
    <section class="verify-update-section">

      <div class="wrap verify-update-grid">


        <div>

          <div class="eyebrow">
            INFORMATION CHANGES
          </div>

          <h2>
            Verification is
            a timestamp, not eternity.
          </h2>

        </div>


        <div>

          <p>
            Prices change.
            Campaigns end.
            Products are discontinued.
            New evidence can appear.
          </p>

          <p>
            Where relevant,
            Seen in Korea records when information
            was checked and updates a page
            when material new evidence changes the conclusion.
          </p>

          <p>
            Significant corrections should be explained
            rather than silently changing the meaning
            of the original conclusion.
          </p>

        </div>


      </div>

    </section>



    <!-- BROADER VERIFICATION -->
    <section class="verify-broader-section">

      <div class="wrap">


        <div class="verify-section-head">

          <div>

            <div class="eyebrow">
              BEYOND SEEN ON
            </div>

            <h2>
              The same principle applies
              across Seen in Korea.
            </h2>

          </div>

        </div>



        <div class="verify-broader-grid">


          <article>

            <span>
              TRAVEL & PLACES
            </span>

            <h3>
              Check the facts that affect the visit.
            </h3>

            <p>
              Hours, prices, access rules,
              reservation requirements and other
              practical information can change quickly.
            </p>

          </article>


          <article>

            <span>
              PRODUCTS
            </span>

            <h3>
              Marketing claims are not conclusions.
            </h3>

            <p>
              Specifications, ingredients,
              official claims, pricing and
              independent evidence should be separated.
            </p>

          </article>


          <article>

            <span>
              REAL KOREA
            </span>

            <h3>
              Individual experiences need context.
            </h3>

            <p>
              Interviews and first-hand experiences
              are valuable evidence,
              but one person does not automatically
              represent everyone.
            </p>

          </article>


          <article>

            <span>
              HIGH-STAKES INFORMATION
            </span>

            <h3>
              Higher impact requires stronger caution.
            </h3>

            <p>
              Medical, legal, visa,
              housing and financial decisions
              require stronger sourcing and
              clearer limits than ordinary shopping content.
            </p>

          </article>


        </div>


      </div>

    </section>



    <!-- CHALLENGE -->
    <section class="verify-challenge-section">

      <div class="wrap verify-challenge-grid">


        <div>

          <div class="eyebrow">
            CHALLENGE OUR EVIDENCE
          </div>

          <h2>
            Found something
            we missed?
          </h2>

        </div>


        <div>

          <p>
            Readers, brands and organizations
            can send newer evidence,
            corrections or missing context.
          </p>

          <p>
            A company statement may be useful context,
            but it is not automatically treated
            as independent verification.
          </p>


          <a
            href="mailto:seeninkorea@gmail.com"
            class="verify-contact"
          >
            seeninkorea@gmail.com →
          </a>


          <a
            href="/editorial-standards"
            class="verify-editorial"
          >
            READ EDITORIAL STANDARDS →
          </a>

        </div>


      </div>

    </section>


  </main>

</BaseLayout>



<style>

  .verify-page {
    background:
      #f3f0ea;
  }


  /* HERO */

  .verify-hero {
    padding:
      64px 0 48px;

    border-bottom:
      1px solid
      var(--line);
  }


  .verify-hero-grid {
    display:
      grid;

    grid-template-columns:
      1.08fr .92fr;

    gap:
      70px;

    align-items:
      end;
  }


  .verify-hero h1 {
    margin:
      11px 0 0;

    font-size:
      clamp(
        64px,
        8vw,
        108px
      );

    line-height:
      .82;

    letter-spacing:
      -.075em;
  }


  .verify-intro {
    padding-left:
      30px;

    border-left:
      1px solid
      var(--line);
  }


  .verify-intro-lead {
    margin:
      0 0 16px;

    color:
      #111 !important;

    font-size:
      21px !important;

    font-weight:
      800;

    line-height:
      1.25 !important;

    letter-spacing:
      -.025em;
  }


  .verify-intro p {
    max-width:
      560px;

    margin:
      0 0 17px;

    color:
      var(--muted);

    font-size:
      13px;

    line-height:
      1.55;
  }


  .verify-intro a {
    color:
      var(--accent);

    font-size:
      9px;

    font-weight:
      900;

    letter-spacing:
      .07em;
  }


  /* CORE RULE */

  .verify-rule-section {
    padding:
      22px 0;

    background:
      #111;

    color:
      #fff;
  }


  .verify-rule {
    display:
      grid;

    grid-template-columns:
      170px 1fr;

    gap:
      30px;

    align-items:
      center;
  }


  .verify-rule-label {
    color:
      var(--accent);

    font-size:
      8px;

    font-weight:
      900;

    letter-spacing:
      .1em;
  }


  .verify-rule blockquote {
    margin:
      0;

    font-size:
      clamp(
        18px,
        2.3vw,
        28px
      );

    font-weight:
      800;

    line-height:
      1.15;

    letter-spacing:
      -.035em;
  }


  /* SECTION HEAD */

  .verify-section-head {
    display:
      flex;

    justify-content:
      space-between;

    align-items:
      end;

    gap:
      40px;

    margin-bottom:
      26px;
  }


  .verify-section-head h2,
  .verify-source-grid h2,
  .verify-detail-grid h2,
  .verify-commerce-grid h2,
  .verify-update-grid h2,
  .verify-challenge-grid h2 {
    max-width:
      650px;

    margin:
      8px 0 0;

    font-size:
      clamp(
        40px,
        4.8vw,
        62px
      );

    line-height:
      .93;

    letter-spacing:
      -.06em;
  }


  .verify-section-head > p {
    max-width:
      430px;

    margin:
      0;

    color:
      var(--muted);

    font-size:
      12px;

    line-height:
      1.5;
  }


  /* LEVELS */

  .verify-levels-section {
    padding:
      60px 0;
  }


  .verify-level-grid {
    display:
      grid;

    grid-template-columns:
      repeat(
        4,
        minmax(0, 1fr)
      );

    gap:
      10px;
  }


  .verify-level-card {
    padding:
      22px 18px;

    background:
      #fffdfa;

    border:
      1px solid
      var(--line);
  }


  .verify-level-top {
    display:
      flex;

    justify-content:
      space-between;

    align-items:
      center;

    margin-bottom:
      44px;
  }


  .verify-level-top > span:first-child {
    color:
      var(--muted);

    font-size:
      10px;

    font-weight:
      900;
  }


  .verify-dot {
    width:
      10px;

    height:
      10px;

    border-radius:
      999px;

    background:
      #aaa;
  }


  .verify-dot.confirmed {
    background:
      #167629;
  }


  .verify-dot.campaign {
    background:
      #2768ce;
  }


  .verify-dot.reported {
    background:
      var(--accent);
  }


  .verify-level-card h3 {
    min-height:
      42px;

    margin:
      0 0 10px;

    font-size:
      20px;

    line-height:
      1;

    letter-spacing:
      -.04em;
  }


  .verify-level-card > strong {
    display:
      block;

    min-height:
      46px;

    margin-bottom:
      12px;

    font-size:
      11px;

    line-height:
      1.4;
  }


  .verify-level-card > p,
  .verify-example {
    color:
      var(--muted);

    font-size:
      10px;

    line-height:
      1.5;
  }


  .verify-example {
    min-height:
      78px;

    margin-top:
      13px;

    padding-top:
      13px;

    border-top:
      1px solid
      var(--line);
  }


  .verify-buy-rule {
    margin-top:
      15px;

    padding:
      12px;

    background:
      #f0ebe3;
  }


  .verify-buy-rule > span {
    display:
      block;

    margin-bottom:
      5px;

    color:
      var(--accent);

    font-size:
      7px;

    font-weight:
      900;

    letter-spacing:
      .08em;
  }


  .verify-buy-rule p {
    margin:
      0;

    font-size:
      9px;

    line-height:
      1.45;
  }


  .verify-warning {
    margin-top:
      14px;

    padding:
      16px 18px;

    background:
      #111;

    color:
      #bbb;

    font-size:
      11px;

    line-height:
      1.5;
  }


  .verify-warning strong,
  .verify-warning b {
    color:
      #fff;
  }


  /* PROCESS */

  .verify-process-section {
    padding:
      58px 0;

    background:
      #ece6dc;
  }


  .verify-process-list {
    border-top:
      1px solid
      var(--line);
  }


  .verify-process-row {
    display:
      grid;

    grid-template-columns:
      70px 280px 1fr;

    gap:
      28px;

    padding:
      19px 0;

    border-bottom:
      1px solid
      var(--line);

    align-items:
      start;
  }


  .verify-process-number {
    color:
      var(--accent);

    font-size:
      10px;

    font-weight:
      900;
  }


  .verify-process-row strong {
    font-size:
      13px;
  }


  .verify-process-row p {
    max-width:
      650px;

    margin:
      0;

    color:
      var(--muted);

    font-size:
      11px;

    line-height:
      1.5;
  }


  /* SOURCES */

  .verify-source-section,
  .verify-detail-section,
  .verify-update-section,
  .verify-challenge-section {
    padding:
      60px 0;
  }


  .verify-source-grid,
  .verify-detail-grid,
  .verify-commerce-grid,
  .verify-update-grid,
  .verify-challenge-grid {
    display:
      grid;

    grid-template-columns:
      .8fr 1.2fr;

    gap:
      70px;
  }


  .verify-source-list {
    border-top:
      1px solid
      var(--line);
  }


  .verify-source-row {
    display:
      grid;

    grid-template-columns:
      110px 1fr;

    gap:
      24px;

    padding:
      18px 0;

    border-bottom:
      1px solid
      var(--line);
  }


  .verify-source-row > span {
    color:
      var(--accent);

    font-size:
      8px;

    font-weight:
      900;

    letter-spacing:
      .08em;
  }


  .verify-source-row strong {
    display:
      block;

    margin-bottom:
      5px;

    font-size:
      13px;
  }


  .verify-source-row p,
  .verify-detail-grid > div:last-child p,
  .verify-update-grid > div:last-child p,
  .verify-challenge-grid > div:last-child p {
    margin:
      0 0 14px;

    color:
      var(--muted);

    font-size:
      12px;

    line-height:
      1.58;
  }


  /* DETAIL */

  .price-section {
    background:
      #f8f5ef;

    border-top:
      1px solid
      var(--line);

    border-bottom:
      1px solid
      var(--line);
  }


  /* COMMERCE */

  .verify-commerce-section {
    padding:
      60px 0;

    background:
      #111;

    color:
      #fff;
  }


  .verify-commerce-section .eyebrow {
    color:
      var(--accent);
  }


  .verify-commerce-copy p {
    margin:
      0 0 16px;

    color:
      #bbb;

    font-size:
      12px;

    line-height:
      1.58;
  }


  .verify-commerce-rule {
    margin:
      24px 0;

    display:
      grid;

    grid-template-columns:
      1fr auto 1fr;

    gap:
      18px;

    align-items:
      center;
  }


  .verify-commerce-rule span {
    padding:
      17px;

    border:
      1px solid
      rgba(
        255,
        255,
        255,
        .2
      );

    text-align:
      center;

    font-size:
      9px;

    font-weight:
      900;

