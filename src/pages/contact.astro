---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact — SEEN IN KOREA"
  description="Contact SEEN IN KOREA for editorial inquiries, corrections, interviews, partnerships and business inquiries."
>
  <main>
    <section class="listing-hero">
      <div class="wrap">
        <div class="eyebrow">SEEN IN KOREA</div>
        <h1>CONTACT</h1>
        <p>
          Editorial inquiries, corrections, interviews and partnership requests.
        </p>
      </div>
    </section>

    <section>
      <div class="article-wrap article-body">

        <h2>Editorial inquiries</h2>
        <p>
          For story tips, corrections, source material or editorial questions:
          <a href="mailto:seeninkorea@gmail.com">seeninkorea@gmail.com</a>
        </p>

        <h2>Interviews</h2>
        <p>
          If you would like to participate in an interview or share your experience of living,
          traveling, studying or shopping in Korea, contact us at
          <a href="mailto:seeninkorea@gmail.com">seeninkorea@gmail.com</a>.
        </p>

        <h2>Business and partnerships</h2>
        <p>
          For brand partnerships, commercial inquiries, product information or business proposals:
          <a href="mailto:seeninkorea@gmail.com">seeninkorea@gmail.com</a>
        </p>

        <h2>Corrections</h2>
        <p>
          Please include the article URL and the specific information you believe should be corrected.
          We review material factual corrections and update stories when appropriate.
        </p>

        <h2>Publisher</h2>
        <p>
          SEEN IN KOREA is operated by Won Global in South Korea.
        </p>

      </div>
    </section>
  </main>
</BaseLayout>
