
---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/experiences.css';
import { database, publicCampaigns } from '../../lib/experiences';

export const prerender = false;

const db = database();
const campaigns = db ? await publicCampaigns(db).catch(() => []) : [];

const categoryOf = (value: string) => {
  if (/카페|음식점|dining|cafe|restaurant|food/i.test(value)) return 'dining';
  if (/뷰티|제품|beauty|product|shop/i.test(value)) return 'beauty';
  if (/숙박|호텔|stay|hotel/i.test(value)) return 'stays';
  return 'activities';
};
const categoryNames: Record<string, string> = {
  dining: 'Food & cafés',
  beauty: 'Beauty',
  stays: 'Stays',
  activities: 'Activities',
};

// Fallback images are illustrative, not images of the participating venues.
const categoryPhotos: Record<string, { src: string; credit: string }> = {
  dining: {
    src: 'https://images.unsplash.com/photo-1773064990672-dfbe02865943?auto=format&fit=crop&w=960&q=78',
    credit: 'https://unsplash.com/photos/two-iced-coffees-and-a-pastry-on-a-table-dVKIpaoSAyU',
  },
  beauty: {
    src: 'https://images.unsplash.com/photo-1741896135518-ce303a539bc0?auto=format&fit=crop&w=960&q=78',
    credit: 'https://unsplash.com/photos/skincare-bottles-are-displayed-on-marble-rocks-gVB7Rjp7dZg',
  },
  stays: {
    src: 'https://images.unsplash.com/photo-1702255489644-392758161f1f?auto=format&fit=crop&w=960&q=78',
    credit: 'https://unsplash.com/photos/a-hotel-room-with-a-bed-chair-and-window-T6WRDVQBn8M',
  },
  activities: {
    src: 'https://images.unsplash.com/photo-1691071097372-133c238ac6aa?auto=format&fit=crop&w=960&q=78',
    credit: 'https://unsplash.com/photos/a-car-parked-on-the-side-of-a-street-r4IuuGjTeQo',
  },
};

// Restrict external images to HTTPS URLs, and do not present them as verified photos.
const safeCampaignImage = (value: string | null | undefined): string => {
  if (!value || value.length > 1000) return '';
  try {
    const url = new URL(value.trim());
    return url.protocol === 'https:' && !url.username && !url.password ? url.href : '';
  } catch {
    return '';
  }
};
---

<BaseLayout
  title="Experiences in Korea — SEEN IN KOREA"
  description="Explore local experiences in Korea. See the benefits, understand the creator requirements, and apply."
>
  <main class="exp-page sik-exp-market">
    <section class="sik-exp-intro">
      <div class="wrap sik-exp-intro-layout">
        <div>
          <p class="sik-exp-kicker">SEEN IN KOREA · CREATOR EXPERIENCES</p>
          <h1>Discover Korea.<br /><span>Share your story.</span></h1>
          <p class="sik-exp-lede">Local food, beauty, stays and activities for international creators.</p>
        </div>
        <div class="sik-exp-intro-actions">
          <a class="sik-exp-primary" href="#experiences">Explore experiences <span aria-hidden="true">→</span></a>
          <a class="sik-exp-text-link" href="/creators/join">Join as a creator</a>
        </div>
      </div>
    </section>

    <section id="experiences" class="sik-exp-list">
      <div class="wrap">
        <div class="sik-exp-heading">
          <div>
            <p class="sik-exp-kicker">FIND YOUR NEXT EXPERIENCE</p>
            <h2>Explore experiences <small>({campaigns.length})</small></h2>
          </div>
          <a href="/business/creator-campaigns" class="sik-exp-business-link">For businesses · 매장 등록 →</a>
        </div>

        {campaigns.length > 0 ? (
          <>
            <div class="sik-exp-filters" role="group" aria-label="Filter by category">
              <button class="sik-exp-filter is-current" type="button" data-filter="all" aria-pressed="true">All</button>
              <button class="sik-exp-filter" type="button" data-filter="dining" aria-pressed="false">Food & cafés</button>
              <button class="sik-exp-filter" type="button" data-filter="beauty" aria-pressed="false">Beauty</button>
              <button class="sik-exp-filter" type="button" data-filter="stays" aria-pressed="false">Stays</button>
              <button class="sik-exp-filter" type="button" data-filter="activities" aria-pressed="false">Activities</button>
            </div>

            <div class="sik-exp-grid">
              {campaigns.map((campaign) => {
                const category = categoryOf(campaign.category);
                const examplePhoto = categoryPhotos[category];
                const venuePhoto = safeCampaignImage(campaign.image_url);
                const placesLeft = Math.max(0, campaign.slots - campaign.selected_count);
                const campaignLink = `/experiences/${encodeURIComponent(campaign.id)}`;

                return (
                  <article class="sik-exp-card" data-category={category}>
                    <div class="sik-exp-photo">
                      <img
                        src={venuePhoto || examplePhoto.src}
                        data-fallback-src={examplePhoto.src}
                        alt={venuePhoto
                          ? `Image provided for ${campaign.business_name}`
                          : `Illustrative ${categoryNames[category]} photo, not a photo of ${campaign.business_name}`}
                        width="960"
                        height="600"
                        loading="lazy"
                        decoding="async"
                      />
                      <span class="sik-exp-photo-note" hidden={!!venuePhoto}>Illustrative photo</span>
                      <span class:list={{ 'sik-exp-capacity': true, 'is-full': placesLeft === 0 }}>
                        {placesLeft > 0 ? `${placesLeft} places left` : 'Fully selected'}
                      </span>
                    </div>

                    <div class="sik-exp-card-body">
                      <p class="sik-exp-category">{categoryNames[category]}</p>
                      <h3><a href={campaignLink}>{campaign.title_en}</a></h3>
                      <p class="sik-exp-location">{campaign.location_en}</p>
                      <div class="sik-exp-offer">
                        <span>WHAT YOU GET</span>
                        <strong>{campaign.offer_en}</strong>
                      </div>
                    </div>

                    <div class="sik-exp-card-footer">
                      <a class="sik-exp-card-cta" href={campaignLink}>
                        {placesLeft > 0 ? 'View & apply' : 'View details'} <span aria-hidden="true">→</span>
                      </a>
                      <a
                        class="sik-exp-photo-credit"
                        data-photo-credit
                        href={examplePhoto.credit}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="Illustrative photo source on Unsplash"
                        hidden={!!venuePhoto}
                      >Photo source</a>
                    </div>
                  </article>
                );
              })}
            </div>
            <p class="sik-exp-no-results" id="sik-exp-no-results" hidden>No experiences in this category yet.</p>
          </>
        ) : (
          <div class="sik-exp-empty">
            <h3>New experiences are coming.</h3>
            <p>We're reviewing local partners. Join the creator list while we prepare the first campaigns.</p>
            <a class="sik-exp-primary" href="/creators/join">Join as a creator <span aria-hidden="true">→</span></a>
          </div>
        )}

        <p class="sik-exp-disclaimer">
          Images supplied for individual campaigns have not been independently verified.
          Images marked illustrative are category examples, not photos of the listed venues.
          Applications are reviewed manually; selection is not guaranteed.
          Complimentary benefits must be disclosed. Google Maps reviews are not required.
        </p>
      </div>
    </section>

    <section class="sik-exp-steps">
      <div class="wrap">
        <h2>How it works</h2>
        <div class="sik-exp-step-grid">
          <div><span>01</span><strong>Explore</strong><p>Find a campaign you like.</p></div>
          <div><span>02</span><strong>Apply</strong><p>Share your social profile.</p></div>
          <div><span>03</span><strong>Get selected</strong><p>We review your application.</p></div>
          <div><span>04</span><strong>Experience & share</strong><p>Post your honest, disclosed content.</p></div>
        </div>
      </div>
    </section>
  </main>

  <script>
    const filters = document.querySelectorAll<HTMLButtonElement>('.sik-exp-filter');
    const cards = document.querySelectorAll<HTMLElement>('.sik-exp-card[data-category]');
    const emptyMessage = document.querySelector<HTMLElement>('#sik-exp-no-results');

    filters.forEach((button) => {
      button.addEventListener('click', () => {
        const selected = button.dataset.filter || 'all';
        filters.forEach((item) => {
          const active = item === button;
          item.classList.toggle('is-current', active);
          item.setAttribute('aria-pressed', String(active));
        });
        let visible = 0;
        cards.forEach((card) => {
          const show = selected === 'all' || card.dataset.category === selected;
          card.hidden = !show;
          if (show) visible++;
        });
        if (emptyMessage) emptyMessage.hidden = visible > 0;
      });
    });

    // Broken partner image URLs fall back to an explicitly labelled example photo.
    document.querySelectorAll<HTMLImageElement>('.sik-exp-photo img[data-fallback-src]')
      .forEach((image) => image.addEventListener('error', () => {
        const fallback = image.dataset.fallbackSrc;
        if (!fallback || image.src === fallback) return;
        image.src = fallback;
        const card = image.closest<HTMLElement>('.sik-exp-card');
        const label = card?.querySelector<HTMLElement>('.sik-exp-photo-note');
        const credit = card?.querySelector<HTMLElement>('[data-photo-credit]');
        if (label) label.hidden = false;
        if (credit) credit.hidden = false;
        image.alt = 'Illustrative category photo, not a photo of the listed venue';
      }));
  </script>

  <style>
    .sik-exp-market {background:#f8f7f4;color:#20201f;min-height:65vh}
    .sik-exp-intro {padding:43px 0 39px;background:#f8f7f4;border-bottom:1px solid #e7e4e0}
    .sik-exp-intro-layout {display:flex;justify-content:space-between;gap:32px;align-items:end}
    .sik-exp-kicker {margin:0 0 11px;font-size:11px;font-weight:850;letter-spacing:.12em;color:#da4e23}
    .sik-exp-intro h1 {font-size:clamp(35px,5vw,57px);line-height:1.07;letter-spacing:-.055em;margin:0 0 13px}
    .sik-exp-intro h1 span {color:#f15a25}
    .sik-exp-lede {font-size:15px;line-height:1.55;color:#605c58;margin:0;max-width:540px}
    .sik-exp-intro-actions {display:flex;align-items:center;gap:16px;flex-wrap:wrap;justify-content:flex-end}
    .sik-exp-primary {display:inline-flex;gap:13px;justify-content:center;align-items:center;text-decoration:none;background:#ff5a23;color:#181818;padding:13px 19px;border-radius:9px;font-weight:800;font-size:14px;min-height:46px}
    .sik-exp-primary:hover,.sik-exp-card-cta:hover {background:#f04e19}
    .sik-exp-primary:focus-visible,.sik-exp-market a:focus-visible,.sik-exp-filter:focus-visible {outline:3px solid #1262c3;outline-offset:3px}
    .sik-exp-text-link,.sik-exp-business-link {color:#b9431e;text-decoration:none;font-size:13px;font-weight:700}
    .sik-exp-text-link:hover,.sik-exp-business-link:hover {text-decoration:underline}
    .sik-exp-list {padding:38px 0 54px}
    .sik-exp-heading {display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:22px}
    .sik-exp-heading h2 {font-size:clamp(27px,3.5vw,36px);letter-spacing:-.05em;line-height:1.2;margin:0}
    .sik-exp-heading small {font-size:17px;color:#8a847e;font-weight:650}
    .sik-exp-filters {display:flex;gap:8px;overflow-x:auto;padding:1px 0 18px;scrollbar-width:thin}
    .sik-exp-filter {border:1px solid #ddd9d2;background:#fff;color:#48433f;border-radius:40px;padding:10px 16px;cursor:pointer;white-space:nowrap;font-size:13px;font-weight:700}
    .sik-exp-filter.is-current {background:#202020;color:#fff;border-color:#202020}
    .sik-exp-grid {display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}
    .sik-exp-card {background:white;border:1px solid #e9e5df;border-radius:14px;overflow:hidden;display:flex;flex-direction:column;min-width:0;box-shadow:0 3px 18px rgba(0,0,0,.025);transition:transform .18s,box-shadow .18s}
    .sik-exp-card:hover {transform:translateY(-3px);box-shadow:0 8px 28px rgba(0,0,0,.065)}
    .sik-exp-card[hidden],.sik-exp-no-results[hidden],.sik-exp-photo-note[hidden],.sik-exp-photo-credit[hidden] {display:none!important}
    .sik-exp-photo {position:relative;aspect-ratio:1.55;background:#e6d5c8;overflow:hidden}
    .sik-exp-photo img {display:block;width:100%;height:100%;object-fit:cover;transition:transform .25s}
    .sik-exp-card:hover .sik-exp-photo img {transform:scale(1.025)}
    .sik-exp-photo-note {position:absolute;bottom:10px;left:12px;background:rgba(22,22,22,.72);color:#fff;padding:5px 8px;border-radius:5px;font-size:10px;font-weight:700}
    .sik-exp-capacity {position:absolute;right:12px;top:12px;background:#fff;color:#287450;padding:8px 10px;border-radius:24px;font-weight:800;font-size:11px;box-shadow:0 1px 5px rgba(0,0,0,.07)}
    .sik-exp-capacity.is-full {color:#696969}
    .sik-exp-card-body {padding:19px 20px 16px;flex:1}
    .sik-exp-category {font-size:11px;color:#d35126;text-transform:uppercase;letter-spacing:.07em;font-weight:850;margin:0 0 7px}
    .sik-exp-card h3 {font-size:21px;line-height:1.3;letter-spacing:-.035em;margin:0 0 9px}
    .sik-exp-card h3 a {color:#222;text-decoration:none}
    .sik-exp-card h3 a:hover {text-decoration:underline;text-decoration-color:#f15a25}
    .sik-exp-location {font-size:13px;color:#77716c;margin:0 0 15px}
    .sik-exp-offer {border-top:1px solid #eeeae4;padding-top:13px}
    .sik-exp-offer span {display:block;font-size:10px;color:#b74826;font-weight:900;letter-spacing:.09em;margin-bottom:6px}
    .sik-exp-offer strong {display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;font-size:15px;line-height:1.45}
    .sik-exp-card-footer {display:flex;align-items:center;gap:10px;border-top:1px solid #eeeae4;padding:12px 13px 12px 20px}
    .sik-exp-card-cta {display:flex;align-items:center;justify-content:space-between;gap:15px;background:#ff5a23;color:#1c1c1c;border-radius:7px;padding:11px 12px;text-decoration:none;font-size:13px;font-weight:850;flex:1}
    .sik-exp-photo-credit {font-size:10px;text-decoration:underline;color:#858078;white-space:nowrap}
    .sik-exp-no-results {padding:22px;color:#6c665e}
    .sik-exp-empty {padding:36px;background:#fff;border:1px solid #e7e1da;border-radius:14px;max-width:670px}
    .sik-exp-empty h3 {font-size:25px;margin:0 0 9px}
    .sik-exp-empty p {line-height:1.6;color:#716d68;margin:0 0 22px}
    .sik-exp-disclaimer {margin:21px 0 0!important;color:#77716c!important;font-size:12px!important;line-height:1.65}
    .sik-exp-steps {border-top:1px solid #ebe7e1;background:#fff;padding:32px 0 42px}
    .sik-exp-steps h2 {font-size:24px;margin:0 0 19px}
    .sik-exp-step-grid {display:grid;grid-template-columns:repeat(4,1fr);gap:15px}
    .sik-exp-step-grid>div {display:flex;flex-direction:column;gap:5px}
    .sik-exp-step-grid span {font-weight:850;color:#e95626;font-size:12px}
    .sik-exp-step-grid strong {font-size:15px}
    .sik-exp-step-grid p {font-size:12px;color:#78726b;margin:0;line-height:1.5}
    @media(max-width:960px) {.sik-exp-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.sik-exp-intro-layout{align-items:start}}
    @media(max-width:650px) {
      .sik-exp-intro-layout{display:block}
      .sik-exp-intro{padding:22px 0}
      .sik-exp-intro h1{font-size:clamp(32px,8.5vw,36px);line-height:1.08;margin-bottom:9px}
      .sik-exp-lede{font-size:13px;line-height:1.45}
      .sik-exp-intro-actions{justify-content:flex-start;margin-top:12px}
      .sik-exp-intro-actions .sik-exp-primary{display:none}
      .sik-exp-list{padding:22px 0 36px}
      .sik-exp-heading{align-items:start;display:block;margin-bottom:12px}
      .sik-exp-heading h2{font-size:27px}
      .sik-exp-business-link{display:inline-block;margin-top:9px;font-size:12px}
      .sik-exp-grid{grid-template-columns:1fr;gap:15px}
      .sik-exp-photo{aspect-ratio:2/1}
      .sik-exp-filters{gap:6px;padding-bottom:12px}
      .sik-exp-filter{padding:8px 12px;min-height:42px;font-size:12px}
      .sik-exp-filters:has(+ .sik-exp-grid > .sik-exp-card:only-child){display:none}
      .sik-exp-card-body{padding:15px 16px 12px}
      .sik-exp-card h3{font-size:20px}
      .sik-exp-card-footer{padding:10px 12px}
      .sik-exp-card-cta{min-height:44px}
      .sik-exp-step-grid{grid-template-columns:repeat(2,1fr);row-gap:18px}
    }
    @media(prefers-reduced-motion:reduce) {.sik-exp-card,.sik-exp-photo img{transition:none}.sik-exp-card:hover,.sik-exp-card:hover img{transform:none}}
  </style>
</BaseLayout>
