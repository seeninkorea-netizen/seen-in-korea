---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/experiences.css';
import { database, publicCampaigns } from '../../lib/experiences';
export const prerender = false;
const db = database();
const campaigns = db ? await publicCampaigns(db).catch(() => []) : [];
const spots = (c: typeof campaigns[number]) => Math.max(0, c.slots - c.selected_count);
const categoryOf = (s: string) => /카페|음식점|dining|cafe|restaurant|food/i.test(s) ? 'dining' : /뷰티|제품|beauty|product|shop/i.test(s) ? 'beauty' : /숙박|호텔|stay|hotel/i.test(s) ? 'stays' : 'activities';
const categoryLabels: Record<string, string> = { dining:'Food & cafés', beauty:'Beauty & products', stays:'Stays', activities:'Activities' };
const categoryLabel = (k: string) => categoryLabels[k] || 'Activities';
---
<BaseLayout title="Creator Experiences in Korea — SEEN IN KOREA" description="Find complimentary Korea experiences with clear benefits and transparent sponsored social content requirements.">
  <main class="exp-page exp-simple">
    <section class="exp-simple-hero">
      <div class="wrap exp-simple-hero-inner">
        <div>
          <p class="exp-simple-eyebrow">SEEN IN KOREA · CREATOR EXPERIENCES</p>
          <h1>Explore Korea.<br /><span>Share what you love.</span></h1>
          <p>Browse selected local experiences for Instagram, TikTok and YouTube creators.</p>
        </div>
        <div class="exp-simple-hero-actions">
          <a class="exp-btn exp-btn-accent" href="#campaigns">Explore campaigns</a>
          <a class="exp-simple-text-link" href="/creators/join">Join as a creator →</a>
        </div>
      </div>
    </section>
    <section class="exp-simple-main" id="campaigns">
      <div class="wrap">
        <div class="exp-simple-section-title">
          <div><p class="exp-simple-eyebrow">FIND YOUR NEXT EXPERIENCE</p><h2>Available campaigns <span>({campaigns.length})</span></h2></div>
          <a class="exp-simple-text-link" href="/business/creator-campaigns">For Korean businesses · 매장 등록 →</a>
        </div>
        {campaigns.length ? (
          <>
            <div class="exp-simple-filters" aria-label="Filter campaigns by category">
              <button class="exp-simple-chip is-active" type="button" data-filter="all" aria-pressed="true">All</button>
              <button class="exp-simple-chip" type="button" data-filter="dining" aria-pressed="false">Food & cafés</button>
              <button class="exp-simple-chip" type="button" data-filter="beauty" aria-pressed="false">Beauty</button>
              <button class="exp-simple-chip" type="button" data-filter="stays" aria-pressed="false">Stays</button>
              <button class="exp-simple-chip" type="button" data-filter="activities" aria-pressed="false">Activities</button>
            </div>
            <div class="exp-simple-campaign-grid">
              {campaigns.map(c => <article class="exp-simple-campaign-card" data-category={categoryOf(c.category)}>
                <div class="exp-simple-card-top"><span class="exp-simple-category">{categoryLabel(categoryOf(c.category))}</span><span class:list={{ 'exp-simple-space': true, 'is-full': spots(c) === 0 }}>{spots(c) > 0 ? `${spots(c)} spots left` : 'Fully selected'}</span></div>
                <div class="exp-simple-card-content">
                  <p class="exp-simple-location">{c.location_en}</p>
                  <h3>{c.title_en}</h3>
                  <p class="exp-simple-card-description">{c.description_en}</p>
                  <div class="exp-simple-benefit"><span>COMPLIMENTARY BENEFIT</span><strong>{c.offer_en}</strong></div>
                </div>
                <a class="exp-simple-card-action" href={`/experiences/${encodeURIComponent(c.id)}`}>{spots(c) > 0 ? 'View & apply' : 'View details'} <span aria-hidden="true">→</span></a>
              </article>)}
            </div>
            <p id="exp-filter-empty" class="exp-simple-none" hidden>No campaigns in this category at the moment.</p>
          </>
        ) : (
          <div class="exp-simple-empty"><h3>New experiences are on their way.</h3><p>We're confirming venues and creator opportunities. Register your profile to hear about future campaigns.</p><a class="exp-btn exp-btn-accent" href="/creators/join">Join the creator list</a></div>
        )}
        <p class="exp-simple-disclaimer">Campaigns are reviewed before publication. Applying does not guarantee selection. Complimentary experiences require clear sponsorship disclosure and are never exchanged for Google Maps reviews.</p>
      </div>
    </section>
    <section class="exp-simple-how"><div class="wrap"><h2>How it works</h2><div class="exp-simple-steps"><div><b>01</b><strong>Choose</strong><span>Find an experience you like.</span></div><div><b>02</b><strong>Apply</strong><span>Share your social profile.</span></div><div><b>03</b><strong>Get selected</strong><span>We review and confirm details.</span></div><div><b>04</b><strong>Experience & share</strong><span>Post your honest, disclosed content.</span></div></div></div></section>
  </main>
  <script>
    document.querySelectorAll<HTMLButtonElement>('.exp-simple-filters [data-filter]').forEach(button => {
      button.addEventListener('click', () => {
        const value = button.dataset.filter;
        document.querySelectorAll<HTMLButtonElement>('.exp-simple-filters [data-filter]').forEach(b => {const yes=b===button;b.classList.toggle('is-active',yes);b.setAttribute('aria-pressed',String(yes));});
        let visible=0;
        document.querySelectorAll<HTMLElement>('.exp-simple-campaign-card[data-category]').forEach(card=>{const yes=value==='all'||card.dataset.category===value;card.hidden=!yes;if(yes)visible++;});
        const empty=document.querySelector<HTMLElement>('#exp-filter-empty');if(empty) empty.hidden=visible!==0;
      });
    });
  </script>
</BaseLayout>
