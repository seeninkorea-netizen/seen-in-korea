---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/experiences.css';
import { database, publicCampaign } from '../../lib/experiences';
export const prerender = false;
const campaignId = Astro.params.id || '';
const db = database();
const campaign = db && /^[0-9a-f-]{36}$/i.test(campaignId) ? await publicCampaign(db,campaignId).catch(()=>null) : null;
if (!campaign) Astro.response.status = 404;
---
<BaseLayout title={campaign ? `${campaign.title_en} — SEEN IN KOREA` : 'Experience not available — SEEN IN KOREA'} description={campaign?.description_en || 'Campaign is unavailable.'}>
  <main class="exp-page exp-simple">
    {campaign ? (
      <>
        <section class="exp-simple-detail-top"><div class="wrap">
          <a class="exp-simple-back" href="/experiences">← All experiences</a>
          <div class="exp-simple-detail-heading"><div><p class="exp-simple-eyebrow">CREATOR EXPERIENCE · {campaign.category}</p><h1>{campaign.title_en}</h1><p>{campaign.location_en}</p></div>
            <div class="exp-simple-status">{Math.max(0,campaign.slots-campaign.selected_count)} of {campaign.slots} places available</div>
          </div>
        </div></section>
        <section class="exp-simple-detail-body"><div class="wrap exp-simple-detail-grid">
          <div class="exp-simple-detail-content">
            <div class="exp-simple-benefit-large"><span>WHAT YOU RECEIVE</span><h2>{campaign.offer_en}</h2><p>Complimentary experience · Subject to selection and final scheduling</p></div>
            <div class="exp-simple-info-block"><h2>About this experience</h2><p>{campaign.description_en}</p></div>
            <div class="exp-simple-info-block"><h2>What you'll share</h2><p>{campaign.deliverables_en}</p></div>
            <div class="exp-simple-facts"><div><span>PARTNER</span><strong>{campaign.business_name}</strong></div><div><span>LOCATION</span><strong>{campaign.location_en}</strong></div></div>
            <details class="exp-simple-rules"><summary>Participation & disclosure rules</summary><p>Applicants must be 18 or older and eligible to accept this complimentary experience under applicable rules, including immigration requirements. Clearly disclose any sponsored benefit. Positive ratings and Google Maps reviews are not required or rewarded. Application does not guarantee selection or a reservation.</p></details>
          </div>
          <div class="exp-simple-apply-area"><div class="exp-form exp-simple-apply-form" id="apply">
            {campaign.selected_count >= campaign.slots ? (
              <><h2>Applications closed</h2><p>All creator places have been selected for now.</p><a class="exp-btn exp-btn-accent" href="/experiences">Explore other experiences</a></>
            ) : (
              <><p class="exp-simple-eyebrow">CREATOR APPLICATION</p><h2>Apply for this experience</h2><p>Share your profile. Our team will review it manually.</p>
              <form data-experience-endpoint="/api/experiences/apply">
                <input type="hidden" name="campaignId" value={campaign.id}/>
                <div class="exp-hp" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off" /></label></div>
                <div class="exp-fields">
                  <div class="exp-field"><label for="apply-name">Creator name / handle *</label><input id="apply-name" name="name" maxlength="100" autocomplete="nickname" placeholder="Your name or handle" required /></div>
                  <div class="exp-field"><label for="apply-email">Contact email *</label><input id="apply-email" name="email" type="email" maxlength="180" autocomplete="email" placeholder="you@example.com" required /></div>
                  <div class="exp-field"><label for="apply-social">Instagram, TikTok or YouTube link *</label><input id="apply-social" name="social" type="url" maxlength="300" placeholder="https://www.instagram.com/yourprofile" required /></div>
                </div>
                <details class="exp-simple-optional"><summary>Add a short message (optional)</summary><div class="exp-field"><label for="apply-message">Why would you like to join?</label><textarea id="apply-message" name="message" maxlength="500" placeholder="Tell us a little about your content"></textarea></div></details>
                <div class="exp-simple-consent"><p>Before applying</p>
                  <label class="exp-check"><input type="checkbox" name="adult" required /><span>I am at least 18 years old.</span></label>
                  <label class="exp-check"><input type="checkbox" name="eligibility" required /><span>I understand participation depends on my lawful eligibility, including any visa restrictions.</span></label>
                  <label class="exp-check"><input type="checkbox" name="disclosure" required /><span>I will disclose any sponsored benefits; Google Maps reviews are not required.</span></label>
                  <label class="exp-check"><input type="checkbox" name="consent" required /><span>I agree to the <a class="exp-link" href="/experiences/privacy">data-use notice</a> for application review and contact.</span></label>
                </div>
                <button class="exp-btn exp-btn-accent exp-simple-submit" type="submit">Submit application →</button>
                <p data-result class="exp-form-result" role="status" aria-live="polite"></p>
                <p class="exp-simple-form-note">Submitting an application does not confirm a visit.</p>
              </form></>
            )}
          </div></div>
        </div></section>
      </>
    ) : <section class="exp-simple-main"><div class="wrap exp-empty"><h1>This campaign is not available.</h1><p>It may be pending, paused or closed.</p><a class="exp-btn" href="/experiences">Browse experiences</a></div></section>}
  </main>
  <script>import '../../scripts/experience-submit';</script>
</BaseLayout>
