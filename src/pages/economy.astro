---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getArticlesBySection } from '../lib/content';

const articles =
  await getArticlesBySection('economy');

const latest =
  articles[0] || null;

const rest =
  articles.slice(1);
---

<BaseLayout
  title="Economy — Korean Markets, Companies & Data | SEEN IN KOREA"
  description="Evidence-led reporting on Korea's economy, companies, markets, industrial policy and consumer economy for global readers."
>
  <main class="economy-page">

    <!-- HERO -->
    <section class="economy-hero">

      <div class="wrap economy-hero-grid">

        <div class="economy-hero-copy">

          <div class="eyebrow">
            ECONOMY · KOREA EXPLAINED
          </div>

          <h1>
            Korea’s economy,<br />
            <span>without the noise.</span>
          </h1>

          <p class="economy-dek">
            Markets, companies, industrial policy and the numbers
            shaping Korea — explained with evidence before narrative.
          </p>

          <div class="economy-principle">

            <span>
              OUR PRINCIPLE
            </span>

            <strong>
              Evidence Before Narrative.
            </strong>

          </div>

        </div>


        <aside class="economy-scope">

          <div class="economy-scope-label">
            WHAT WE COVER
          </div>


          <div class="economy-scope-item">

            <span>
              01
            </span>

            <div>

              <strong>
                Markets
              </strong>

              <p>
                KOSPI, semiconductors,
                capital flows and market-moving data.
              </p>

            </div>

          </div>


          <div class="economy-scope-item">

            <span>
              02
            </span>

            <div>

              <strong>
                Companies
              </strong>

              <p>
                Korean companies, earnings,
                shareholder returns and strategy.
              </p>

            </div>

          </div>


          <div class="economy-scope-item">

            <span>
              03
            </span>

            <div>

              <strong>
                Policy
              </strong>

              <p>
                Interest rates, regulation,
                industrial policy and government decisions.
              </p>

            </div>

          </div>


          <div class="economy-scope-item">

            <span>
              04
            </span>

            <div>

              <strong>
                Consumer Economy
              </strong>

              <p>
                Prices, spending, housing
                and the economic reality people feel.
              </p>

            </div>

          </div>

        </aside>

      </div>

    </section>



    <!-- SIGNAL STRIP -->
    <section class="economy-signal">

      <div class="wrap economy-signal-inner">

        <span>
          MARKETS
        </span>

        <span>
          COMPANIES
        </span>

        <span>
          POLICY
        </span>

        <span>
          CONSUMER ECONOMY
        </span>

        <span>
          DATA
        </span>

      </div>

    </section>



    <!-- LATEST LEAD -->
    {
      latest && (

        <section class="economy-lead-section">

          <div class="wrap">

            <div class="economy-section-head">

              <div>

                <div class="eyebrow">
                  LATEST ANALYSIS
                </div>

                <h2>
                  What matters now.
                </h2>

              </div>


              <a
                href="/articles"
                class="economy-link"
              >
                ALL STORIES →
              </a>

            </div>


            <a
              class="economy-lead-card"
              href={`/articles/${latest.slug}`}
            >

              <div class="economy-lead-media">

                {
                  latest.heroImageUrl
                    ? (
                      <img
                        src={latest.heroImageUrl}
                        alt={
                          latest.heroAlt ||
                          latest.title
                        }
                      />
                    )
                    : (
                      <div class="economy-lead-placeholder">
                        ECONOMY
                      </div>
                    )
                }

              </div>


              <div class="economy-lead-copy">

                <div class="economy-lead-meta">

                  <span>
                    {
                      latest.eyebrow ||
                      'ECONOMY'
                    }
                  </span>

                  {
                    latest.verification && (

                      <span>
                        {
                          latest.verification
                        }
                      </span>

                    )
                  }

                </div>


                <h2>
                  {latest.title}
                </h2>


                <p>
                  {latest.dek}
                </p>


                <div class="economy-read">
                  READ THE ANALYSIS →
                </div>

              </div>

            </a>

          </div>

        </section>

      )
    }



    <!-- STORIES -->
    <section class="economy-stories">

      <div class="wrap">

        <div class="economy-section-head">

          <div>

            <div class="eyebrow">
              ECONOMY DESK
            </div>

            <h2>
              Latest reporting & analysis
            </h2>

            <p>
              Korean markets, companies and economic shifts
              with the source material attached.
            </p>

          </div>


          <div class="economy-story-count">

            {articles.length}

            <span>
              PUBLISHED
            </span>

          </div>

        </div>


        {
          rest.length
            ? (

              <div class="listing-grid">

                {
                  rest.map(
                    article => (

                      <ArticleCard
                        article={article}
                      />

                    )
                  )
                }

              </div>

            )
            : latest
              ? (

                <div class="economy-empty">

                  More Economy stories
                  will appear here as they are published.

                </div>

              )
              : (

                <div class="economy-empty">

                  <strong>
                    Economy is now live.
                  </strong>

                  <p>
                    Publish an article with
                    the category
                    <b> Economy </b>
                    in Sanity and it will
                    automatically appear here.
                  </p>

                </div>

              )
        }

      </div>

    </section>



    <!-- EDITORIAL METHOD -->
    <section class="economy-method">

      <div class="wrap economy-method-grid">

        <div>

          <div class="eyebrow eyebrow-light">
            HOW WE APPROACH ECONOMY
          </div>

          <h2>
            Numbers first.<br />
            Interpretation second.
          </h2>

        </div>


        <div class="economy-method-list">


          <div>

            <span>
              01
            </span>

            <div>

              <strong>
                Start with primary evidence
              </strong>

              <p>
                Company disclosures, government data,
                exchange filings and attributable sources
                come before market narratives.
              </p>

            </div>

          </div>


          <div>

            <span>
              02
            </span>

            <div>

              <strong>
                Separate fact from interpretation
              </strong>

              <p>
                What happened, why it may matter
                and what remains uncertain
                are treated as different questions.
              </p>

            </div>

          </div>


          <div>

            <span>
              03
            </span>

            <div>

              <strong>
                Avoid prediction disguised as fact
              </strong>

              <p>
                Market scenarios and analyst expectations
                are labeled as such rather than presented
                as inevitable outcomes.
              </p>

            </div>

          </div>


          <div>

            <span>
              04
            </span>

            <div>

              <strong>
                Explain Korea in global context
              </strong>

              <p>
                The goal is not simply reporting a number,
                but explaining what it means to a reader
                outside Korea.
              </p>

            </div>

          </div>


        </div>

      </div>

    </section>



    <!-- DISCLAIMER -->
    <section class="economy-disclaimer">

      <div class="wrap economy-disclaimer-inner">

        <strong>
          EDITORIAL NOTE
        </strong>

        <p>
          Economy coverage is published for information
          and analysis. It is not individualized investment
          advice, a solicitation to trade securities,
          or a guarantee of future performance.
        </p>

      </div>

    </section>


  </main>

</BaseLayout>



<style>

  .economy-page {
    --economy-ink: #111111;
    --economy-paper: #f2eee6;
    --economy-soft: #f8f6f1;
    --economy-line: #d9d3c9;
    --economy-muted: #68635c;
    --economy-accent: #ff4f12;

    background:
      #fff;

    color:
      var(--economy-ink);
  }



  .economy-page .wrap {

    width:
      min(
        1180px,
        calc(100% - 40px)
      );

    margin:
      0 auto;

  }



  .economy-page .eyebrow {

    color:
      var(--economy-accent);

    font-size:
      10px;

    font-weight:
      900;

    letter-spacing:
      .13em;

  }



  .economy-page .eyebrow-light {

    color:
      #ff845b;

  }



  /* HERO */

  .economy-hero {

    padding:
      78px 0 64px;

    background:
      var(--economy-paper);

    border-bottom:
      1px solid
      var(--economy-line);

  }



  .economy-hero-grid {

    display:
      grid;

    grid-template-columns:
      1.15fr .85fr;

    gap:
      80px;

    align-items:
      end;

  }



  .economy-hero-copy h1 {

    margin:
      14px 0 24px;

    font-size:
      clamp(
        58px,
        7vw,
        94px
      );

    line-height:
      .9;

    letter-spacing:
      -.07em;

  }



  .economy-hero-copy h1 span {

    color:
      var(--economy-accent);

  }



  .economy-dek {

    max-width:
      710px;

    margin:
      0;

    color:
      #413d38;

    font-size:
      18px;

    line-height:
      1.65;

  }



  .economy-principle {

    margin-top:
      38px;

    padding-top:
      20px;

    max-width:
      600px;

    border-top:
      1px solid
      #c9c2b8;

  }



  .economy-principle span {

    display:
      block;

    color:
      var(--economy-muted);

    font-size:
      9px;

    font-weight:
      900;

    letter-spacing:
      .11em;

  }



  .economy-principle strong {

    display:
      block;

    margin-top:
      7px;

    font-size:
      24px;

    letter-spacing:
      -.03em;

  }



  /* SCOPE */

  .economy-scope {

    border-top:
      4px solid
      var(--economy-ink);

  }



  .economy-scope-label {

    padding:
      14px 0;

    color:
      var(--economy-muted);

    font-size:
      9px;

    font-weight:
      900;

    letter-spacing:
      .12em;

  }



  .economy-scope-item {

    display:
      grid;

    grid-template-columns:
      42px 1fr;

    gap:
      12px;

    padding:
      17px 0;

    border-top:
      1px solid
      var(--economy-line);

  }



  .economy-scope-item > span {

    color:
      var(--economy-accent);

    font-size:
      10px;

    font-weight:
      900;

  }



  .economy-scope-item strong {

    display:
      block;

    font-size:
      14px;

  }



  .economy-scope-item p {

    margin:
      5px 0 0;

    color:
      var(--economy-muted);

    font-size:
      11px;

    line-height:
      1.5;

  }



  /* SIGNAL */

  .economy-signal {

    background:
      var(--economy-ink);

    color:
      #fff;

  }



  .economy-signal-inner {

    min-height:
      52px;

    display:
      flex;

    align-items:
      center;

    justify-content:
      space-between;

    gap:
      22px;

    overflow-x:
      auto;

    white-space:
      nowrap;

  }



  .economy-signal span {

    color:
      #bfbab2;

    font-size:
      9px;

    font-weight:
      900;

    letter-spacing:
      .1em;

  }



  /* SHARED SECTION HEAD */

  .economy-section-head {

    display:
      flex;

    justify-content:
      space-between;

    align-items:
      end;

    gap:
      30px;

    margin-bottom:
      30px;

  }



  .economy-section-head h2 {

    margin:
      7px 0 0;

    font-size:
      clamp(
        36px,
        4vw,
        54px
      );

    line-height:
      .95;

    letter-spacing:
      -.055em;

  }



  .economy-section-head p {

    max-width:
      620px;

    margin:
      10px 0 0;

    color:
      var(--economy-muted);

    font-size:
      12px;

    line-height:
      1.55;

  }



  .economy-link {

    flex:
      0 0 auto;

    color:
      var(--economy-ink);

    font-size:
      9px;

    font-weight:
      900;

    letter-spacing:
      .06em;

    text-decoration:
      none;

    border-bottom:
      2px solid
      var(--economy-accent);

  }



  /* LEAD */

  .economy-lead-section {

    padding:
      68px 0;

    background:
      #fff;

  }



  .economy-lead-card {

    display:
      grid;

    grid-template-columns:
      1.15fr .85fr;

    min-height:
      460px;

    color:
      inherit;

    text-decoration:
      none;

    border:
      1px solid
      var(--economy-line);

  }



  .economy-lead-media {

    min-height:
      460px;

    overflow:
      hidden;

    background:
      #ded9d0;

  }



  .economy-lead-media img {

    width:
      100%;

    height:
      100%;

    display:
      block;

    object-fit:
      cover;

  }



  .economy-lead-placeholder {

    width:
      100%;

    height:
      100%;

    min-height:
      460px;

    display:
      grid;

    place-items:
      center;

    background:
      var(--economy-ink);

    color:
      var(--economy-accent);

    font-size:
      13px;

    font-weight:
      900;

    letter-spacing:
      .18em;

  }



  .economy-lead-copy {

    padding:
      42px;

    display:
      flex;

    flex-direction:
      column;

    justify-content:
      center;

    background:
      var(--economy-paper);

  }



  .economy-lead-meta {

    display:
      flex;

    flex-wrap:
      wrap;

    gap:
      8px;

  }



  .economy-lead-meta span {

    padding:
      6px 8px;

    border:
      1px solid
      #cec7bd;

    color:
      var(--economy-muted);

    font-size:
      8px;

    font-weight:
      900;

    letter-spacing:
      .07em;

  }



  .economy-lead-copy h2 {

    margin:
      20px 0 15px;

    font-size:
      clamp(
        34px,
        4vw,
        50px
      );

    line-height:
      .96;

    letter-spacing:
      -.055em;

  }



  .economy-lead-copy p {

    margin:
      0;

    color:
      var(--economy-muted);

    font-size:
      13px;

    line-height:
      1.65;

  }



  .economy-read {

    margin-top:
      28px;

    color:
      var(--economy-accent);

    font-size:
      9px;

    font-weight:
      900;

    letter-spacing:
      .07em;

  }



  /* STORIES */

  .economy-stories {

    padding:
      70px 0 82px;

    background:
      var(--economy-soft);

    border-top:
      1px solid
      var(--economy-line);

  }



  .economy-story-count {

    flex:
      0 0 auto;

    min-width:
      90px;

    text-align:
      right;

    color:
      var(--economy-accent);

    font-size:
      36px;

    font-weight:
      900;

    line-height:
      1;

  }



  .economy-story-count span {

    display:
      block;

    margin-top:
      5px;

    color:
      var(--economy-muted);

    font-size:
      7px;

    letter-spacing:
      .1em;

  }



  .economy-empty {

    padding:
      45px;

    border:
      1px solid
      var(--economy-line);

    background:
      #fff;

    color:
      var(--economy-muted);

    font-size:
      13px;

    line-height:
      1.6;

  }



  .economy-empty strong {

    display:
      block;

    margin-bottom:
      8px;

    color:
      var(--economy-ink);

    font-size:
      19px;

  }



  .economy-empty p {

    margin:
      0;

  }



  /* METHOD */

  .economy-method {

    padding:
      78px 0;

    background:
      var(--economy-ink);

    color:
      #fff;

  }



  .economy-method-grid {

    display:
      grid;

    grid-template-columns:
      .85fr 1.15fr;

    gap:
      80px;

  }



  .economy-method h2 {

    margin:
      10px 0 0;

    font-size:
      clamp(
        40px,
        5vw,
        61px
      );

    line-height:
      .94;

    letter-spacing:
      -.06em;

  }



  .economy-method-list {

    border-top:
      1px solid
      #383838;

  }



  .economy-method-list > div {

    display:
      grid;

    grid-template-columns:
      48px 1fr;

    gap:
      15px;

    padding:
      21px 0;

    border-bottom:
      1px solid
      #383838;

  }



  .economy-method-list > div > span {

    color:
      var(--economy-accent);

    font-size:
      10px;

    font-weight:
      900;

  }



  .economy-method-list strong {

    display:
      block;

    font-size:
      14px;

  }



  .economy-method-list p {

    max-width:
      590px;

    margin:
      6px 0 0;

    color:
      #aaa6a0;

    font-size:
      11px;

    line-height:
      1.55;

  }



  /* DISCLAIMER */

  .economy-disclaimer {

    padding:
      26px 0;

    background:
      #ece7de;

  }



  .economy-disclaimer-inner {

    display:
      grid;

    grid-template-columns:
      150px 1fr;

    gap:
      25px;

  }



  .economy-disclaimer strong {

    color:
      var(--economy-accent);

    font-size:
      9px;

    letter-spacing:
      .1em;

  }



  .economy-disclaimer p {

    max-width:
      820px;

    margin:
      0;

    color:
      var(--economy-muted);

    font-size:
      10px;

    line-height:
      1.5;

  }



  /* TABLET */

  @media (
    max-width: 900px
  ) {

    .economy-hero-grid,
    .economy-lead-card,
    .economy-method-grid {

      grid-template-columns:
        1fr;

    }


    .economy-hero-grid {

      gap:
        45px;

    }


    .economy-lead-media {

      min-height:
        360px;

    }


    .economy-section-head {

      align-items:
        start;

    }

  }



  /* MOBILE */

  @media (
    max-width: 560px
  ) {

    .economy-page .wrap {

      width:
        min(
          100% - 28px,
          1180px
        );

    }


    .economy-hero {

      padding:
        50px 0 42px;

    }


    .economy-hero-copy h1 {

      font-size:
        52px;

    }


    .economy-dek {

      font-size:
        15px;

    }


    .economy-signal-inner {

      justify-content:
        flex-start;

      gap:
        28px;

    }


    .economy-section-head {

      display:
        block;

    }


    .economy-link,
    .economy-story-count {

      display:
        inline-block;

      margin-top:
        18px;

      text-align:
        left;

    }


    .economy-lead-media,
    .economy-lead-placeholder {

      min-height:
        270px;

    }


    .economy-lead-copy {

      padding:
        27px 21px;

    }


    .economy-method-grid {

      gap:
        42px;

    }


    .economy-disclaimer-inner {

      grid-template-columns:
        1fr;

      gap:
        8px;

    }

  }

</style>
