---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/call-korea.css';

const whatsappNumber = '821057397087';

const freeChatText = encodeURIComponent(
  [
    'Hi Seen in Korea. I need help with something in Korea.',
    '',
    'What happened:',
    'Location:',
    'How urgent is it:',
    '',
    'You can also send a photo, screenshot, map link or voice message.'
  ].join('\n')
);

const freeChatUrl =
  `https://wa.me/${whatsappNumber}?text=${freeChatText}`;

const situations = [
  {
    number: '01',
    icon: '⌁',
    title: 'Lost & Stolen',
    description: 'Phone, wallet, passport, bag or something left behind.'
  },
  {
    number: '02',
    icon: '+',
    title: 'Clinic & Pharmacy',
    description: 'Need help communicating with a clinic, hospital or pharmacy.'
  },
  {
    number: '03',
    icon: '▰',
    title: 'Hotel & Booking',
    description: 'Reservation, check-in or booking problem.'
  },
  {
    number: '04',
    icon: '↗',
    title: 'Taxi & Transport',
    description: 'Lost property, route problem or transport communication.'
  },
  {
    number: '05',
    icon: '₩',
    title: 'Payment & Refund',
    description: 'Charge, cancellation, refund or purchase question.'
  },
  {
    number: '06',
    icon: '☎',
    title: 'Call a Business',
    description: 'Send the name or map link. We can find who to contact.'
  }
];

const makeSituationUrl = (title) => {
  const text = encodeURIComponent(
    [
      `Hi Seen in Korea. I need help with: ${title}`,
      '',
      'What happened:',
      'Location:',
      '',
      'I can send a photo, screenshot, map link or voice message.'
    ].join('\n')
  );

  return `https://wa.me/${whatsappNumber}?text=${text}`;
};

const processSteps = [
  {
    number: '01',
    title: 'Send what you have',
    description:
      'A short message, photo, screenshot, map link or voice note is enough.'
  },
  {
    number: '02',
    title: 'We handle the Korean',
    description:
      'We figure out who to contact, explain the situation and make the Korean call when needed.'
  },
  {
    number: '03',
    title: 'You get the answer',
    description:
      'We send the result back in clear English and tell you what happens next.'
  }
];
---

<BaseLayout
  title="Call Korea | Get Help in Korea | SEEN IN KOREA"
  description="Stuck in Korea? Tell us what happened. Call Korea helps foreigners handle Korean phone calls, lost items, bookings, transport issues, refunds and everyday communication."
>

  <main class="call-korea-page call-korea-v2">


    <!-- EMERGENCY -->
    <div class="call-emergency-bar">

      <div class="wrap call-emergency-inner">

        <strong>
          IN IMMEDIATE DANGER?
        </strong>

        <span>
          Police 112 · Fire / Ambulance 119
        </span>

        <span class="call-emergency-note">
          Call Korea is practical support,
          not an emergency service.
        </span>

      </div>

    </div>


    <!-- HERO -->
    <section class="call-hero call-hero-v2">

      <div class="wrap call-hero-grid">


        <div class="call-hero-copy">

          <div class="eyebrow">
            KOREA HELP · CALL KOREA · BETA
          </div>


          <h1>
            Stuck in Korea?<br />
            <span>We’ll handle it.</span>
          </h1>


          <p class="call-hero-dek">
            Don’t know who to call or what to say?
            Tell us what happened.
            We can find the right place,
            handle the Korean
            and give you the answer in English.
          </p>


          <div class="call-hero-actions">

            <a
              href={freeChatUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="call-btn call-btn-whatsapp"
            >
              GET HELP — FREE CHAT →
            </a>

            <a
              href="#call-payment"
              class="call-btn call-btn-dark"
            >
              HANDLE IT FOR ME · ₩2,900 →
            </a>

          </div>


          <div class="call-hero-trust">

            <span>
              No account
            </span>

            <span>
              No long form
            </span>

            <span>
              English ↔ Korean
            </span>

          </div>

        </div>



        <!-- QUICK SERVICE CARD -->
        <aside class="call-status-card call-status-card-v2">

          <div class="call-status-top">

            <span class="call-status-dot"></span>

            <strong>
              CALL KOREA
            </strong>

            <small>
              BETA
            </small>

          </div>


          <div class="call-status-question">
            You tell us the problem.<br />
            We handle the Korean.
          </div>


          <div class="call-benefit-list">

            <div>
              <span>01</span>
              <p>
                We figure out who to contact.
              </p>
            </div>

            <div>
              <span>02</span>
              <p>
                We make the Korean phone call.
              </p>
            </div>

            <div>
              <span>03</span>
              <p>
                We explain your request.
              </p>
            </div>

            <div>
              <span>04</span>
              <p>
                You get the answer in English.
              </p>
            </div>

          </div>


          <div class="call-card-price">

            <span>
              FIRST REQUEST
            </span>

            <strong>
              ₩2,900
            </strong>

            <small>
              One simple request · typically up to 5 minutes
            </small>

          </div>


          <a
            href="#call-payment"
            class="call-status-action"
          >
            HANDLE IT NOW →
          </a>

        </aside>

      </div>

    </section>



    <!-- WHAT HAPPENED -->
    <section class="call-help-section call-help-v2">

      <div class="wrap">

        <div class="section-head">

          <div>

            <div class="eyebrow">
              WHAT HAPPENED?
            </div>

            <h2>
              Just choose the closest one.
            </h2>

          </div>


          <p>
            Don’t see your exact situation?
            Use free chat and just tell us what happened.
          </p>

        </div>



        <div class="call-help-layout">


          <div class="call-situation-grid">

            {
              situations.map((item) => (

                <a
                  href={makeSituationUrl(item.title)}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="call-situation-card"
                >

                  <div class="call-situation-topline">

                    <span class="call-situation-number">
                      {item.number}
                    </span>

                    <span
                      class="call-situation-icon"
                      aria-hidden="true"
                    >
                      {item.icon}
                    </span>

                  </div>


                  <h3>
                    {item.title}
                  </h3>


                  <p>
                    {item.description}
                  </p>


                  <strong>
                    GET HELP →
                  </strong>

                </a>

              ))
            }

          </div>



          <!-- SEND ANYTHING -->
          <aside class="call-send-anything">

            <div class="eyebrow">
              DON’T KNOW THE DETAILS?
            </div>


            <h3>
              Send what you have.
            </h3>


            <div class="call-send-list">

              <div>

                <span>
                  PHOTO
                </span>

                <p>
                  Receipt, sign, ticket or business card.
                </p>

              </div>


              <div>

                <span>
                  SCREENSHOT
                </span>

                <p>
                  Booking, payment, message or app screen.
                </p>

              </div>


              <div>

                <span>
                  MAP LINK
                </span>

                <p>
                  Google Maps, Naver Map or Kakao Map.
                </p>

              </div>


              <div>

                <span>
                  VOICE MESSAGE
                </span>

                <p>
                  Too stressed to type?
                  Just explain what happened.
                </p>

              </div>

            </div>


            <p class="call-send-note">
              You do not need to find the Korean phone number first.
              We can figure out where to contact.
            </p>

          </aside>

        </div>

      </div>

    </section>



    <!-- HOW IT WORKS -->
    <section class="call-how-section call-how-v2">

      <div class="wrap">

        <div class="section-head">

          <div>

            <div class="eyebrow">
              HOW IT WORKS
            </div>

            <h2>
              Three steps. That’s it.
            </h2>

          </div>


          <p>
            No signup.
            No long request form.
            Start with whatever information you already have.
          </p>

        </div>



        <div class="call-how-grid call-how-grid-v2">

          {
            processSteps.map((item) => (

              <article>

                <span>
                  {item.number}
                </span>

                <h3>
                  {item.title}
                </h3>

                <p>
                  {item.description}
                </p>

              </article>

            ))
          }

        </div>

      </div>

    </section>



    <!-- START -->
    <section
      id="call-payment"
      class="call-service-section call-service-v2"
    >

      <div class="wrap">

        <div class="section-head">

          <div>

            <div class="eyebrow">
              START HERE
            </div>

            <h2>
              Ask us — or hand it over.
            </h2>

          </div>


          <p>
            Free chat is for asking what to do.
            Paid help is for when you want us
            to make the Korean call for you.
          </p>

        </div>



        <div class="call-service-grid">


          <!-- FREE -->
          <article class="call-service-card">

            <div class="call-service-label">
              ASK FIRST
            </div>


            <h3>
              Free Chat
            </h3>


            <div class="call-price">
              FREE
            </div>


            <p>
              Tell us what happened.
              Photos, screenshots,
              map links and voice messages are welcome.
            </p>


            <ul>

              <li>
                No signup
              </li>

              <li>
                Ask what to do next
              </li>

              <li>
                Send photos or screenshots
              </li>

              <li>
                No payment to ask
              </li>

            </ul>


            <a
              href={freeChatUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="call-btn call-btn-whatsapp"
            >
              GET HELP — FREE CHAT →
            </a>

          </article>



          <!-- PAID -->
          <article class="call-service-card call-service-featured">

            <div class="call-service-label">
              HANDLE IT FOR ME
            </div>


            <h3>
              Call Korea
            </h3>


            <div class="call-first-price">

              <span>
                FIRST REQUEST
              </span>

              <strong>
                ₩2,900
              </strong>

              <small>
                One simple request · typically up to 5 minutes
              </small>

            </div>


            <div class="call-regular-price">

              <span>
                Regular request
              </span>

              <strong>
                ₩4,900
              </strong>

            </div>


            <ul>

              <li>
                One place or business
              </li>

              <li>
                One Korean phone call
              </li>

              <li>
                We explain your request
              </li>

              <li>
                English result summary
              </li>

            </ul>


            <button
              type="button"
              class="call-btn call-btn-primary call-pay-placeholder"
              aria-disabled="true"
            >
              HANDLE IT FOR ME · ₩2,900 →
            </button>


            <small class="call-payment-note">
              Payment will open directly here.
              Paid calls only begin after payment is confirmed.
            </small>

          </article>

        </div>

      </div>

    </section>



    <!-- EXAMPLE -->
    <section class="call-example-section">

      <div class="wrap">

        <div class="call-example-grid">

          <div>

            <div class="eyebrow">
              EXAMPLE
            </div>

            <h2>
              “I left my bag in a taxi.”
            </h2>

          </div>



          <div class="call-example-conversation">

            <div class="call-message user">

              <span>
                YOU
              </span>

              <p>
                I think I left my bag in the taxi.
                I only have this receipt.
              </p>

            </div>


            <div class="call-message team">

              <span>
                CALL KOREA
              </span>

              <p>
                Send us the receipt.
                You don’t need to find the taxi company first.
              </p>

            </div>


            <div class="call-message user">

              <span>
                YOU
              </span>

              <p>
                Can you call them for me?
              </p>

            </div>


            <div class="call-message team">

              <span>
                CALL KOREA
              </span>

              <p>
                Yes.
                Once payment is confirmed,
                we’ll make the Korean call
                and send you the result.
              </p>

            </div>

          </div>

        </div>

      </div>

    </section>



    <!-- GUIDE -->
    <section class="call-guide-section">

      <div class="wrap">

        <div class="call-guide-grid">

          <article>

            <span>✓</span>

            <h3>
              Simple requests
            </h3>

            <p>
              One place, one request,
              one outbound call
              and a short result summary.
            </p>

          </article>


          <article>

            <span>!</span>

            <h3>
              Emergencies
            </h3>

            <p>
              Use 112 for police
              and 119 for fire or ambulance.
              Call Korea is not an emergency service.
            </p>

          </article>


          <article>

            <span>↗</span>

            <h3>
              Complex requests
            </h3>

            <p>
              Multiple places,
              repeated calls or negotiation
              may need a separate quote.
            </p>

          </article>


          <article>

            <span>○</span>

            <h3>
              Privacy
            </h3>

            <p>
              Only send information
              needed to handle the request.
            </p>

          </article>

        </div>

      </div>

    </section>



    <!-- FINAL -->
    <section class="call-final-section">

      <div class="wrap">

        <div class="call-final-cta">

          <div>

            <div class="eyebrow">
              NOT SURE WHAT TO DO?
            </div>

            <h2>
              Just tell us what happened.
            </h2>

            <p>
              You don’t need to know who to call.
              Start with a free message.
            </p>

          </div>


          <a
            href={freeChatUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="call-btn call-btn-dark"
          >
            GET HELP — FREE CHAT →
          </a>

        </div>

      </div>

    </section>



    <!-- OFFICIAL -->
    <section class="call-public-help">

      <div class="wrap">

        <div class="call-public-help-inner">

          <span>
            OFFICIAL HELP IN KOREA
          </span>

          <strong>
            Police 112
          </strong>

          <strong>
            Fire / Ambulance 119
          </strong>

          <strong>
            Korea Travel Helpline 1330
          </strong>

        </div>

      </div>

    </section>



    <!-- MOBILE FIXED BUTTONS -->
    <div
      class="call-mobile-actions"
      aria-label="Call Korea quick actions"
    >

      <a
        href={freeChatUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="call-mobile-free"
      >
        FREE CHAT
      </a>

      <a
        href="#call-payment"
        class="call-mobile-paid"
      >
        HANDLE IT · ₩2,900
      </a>

    </div>


  </main>

</BaseLayout>
