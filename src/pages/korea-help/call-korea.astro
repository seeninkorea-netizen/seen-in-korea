---
import BaseLayout from '../../layouts/BaseLayout.astro';

const whatsappNumber = '821057397087';

const freeChatText = encodeURIComponent(
  `Hi Seen in Korea. I need help with something in Korea.

My situation:
Location:
How urgent is it:
What do you need help with:`
);

const callNowText = encodeURIComponent(
  `Hi Seen in Korea. I need CALL KOREA now.

What needs to be called:
Business / place:
Phone number or link:
What do you need us to ask:
How urgent is it:`
);

const freeChatUrl =
  `https://wa.me/${whatsappNumber}?text=${freeChatText}`;

const callNowUrl =
  `https://wa.me/${whatsappNumber}?text=${callNowText}`;


const situations = [
  {
    title: 'Lost & Stolen',
    description:
      'Phone, wallet, passport, bag or something left behind.',
    cta: 'GET HELP →'
  },
  {
    title: 'Clinic & Pharmacy',
    description:
      'Help communicating with a clinic, hospital or pharmacy.',
    cta: 'GET HELP →'
  },
  {
    title: 'Hotel & Booking',
    description:
      'Reservation problems, check-in issues or special requests.',
    cta: 'GET HELP →'
  },
  {
    title: 'Taxi & Transport',
    description:
      'Lost property, route problems, transport questions or communication.',
    cta: 'GET HELP →'
  },
  {
    title: 'Payment & Refund',
    description:
      'Need to ask about a charge, refund, cancellation or purchase?',
    cta: 'GET HELP →'
  },
  {
    title: 'Call Someone',
    description:
      'Give us the number and tell us what you need to ask.',
    cta: 'CALL KOREA →'
  }
];


const howItWorks = [
  {
    title: 'Tell us what happened',
    description:
      'Send a message in English. Screenshots, phone numbers and links help.'
  },
  {
    title: 'We check the situation',
    description:
      'We clarify what you need and whether a phone call is necessary.'
  },
  {
    title: 'We call in Korean',
    description:
      'If needed, we contact the business or organization and explain your request.'
  },
  {
    title: 'You get the answer',
    description:
      'We send the result back to you in clear English.'
  }
];
---

<BaseLayout
  title="Call Korea | Real-Time Help in Korea | SEEN IN KOREA"
  description="Need help communicating in Korea? Call Korea helps foreigners handle urgent practical problems, Korean phone calls, bookings, lost items, transport issues and more."
>

  <main class="call-korea-page">


    <!-- EMERGENCY NOTICE -->

    <div class="call-emergency-bar">

      <div class="wrap call-emergency-inner">

        <strong>
          IN IMMEDIATE DANGER?
        </strong>

        <span>
          Police 112 · Fire / Ambulance 119
        </span>

        <span class="call-emergency-note">
          Call Korea is practical support,
          not an emergency service.
        </span>

      </div>

    </div>


    <!-- HERO -->

    <section class="call-hero">

      <div class="wrap call-hero-grid">

        <div class="call-hero-copy">

          <div class="eyebrow">
            KOREA HELP · CALL KOREA · BETA
          </div>


          <h1>
            Stuck in Korea?<br />
            We can help.
          </h1>


          <p class="call-hero-dek">
            Can't explain the problem in Korean?
            Tell us what happened.
            We can help contact the place,
            make the Korean phone call
            and get the answer back to you.
          </p>


          <div class="call-hero-actions">

            <a
              href={freeChatUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="call-btn call-btn-primary"
            >
              START CHAT — FREE →
            </a>


            <a
              href="#call-now"
              class="call-btn call-btn-secondary"
            >
              I NEED A CALL NOW →
            </a>

          </div>


          <div class="call-hero-trust">

            <span>
              No charge to ask
            </span>

            <span>
              English ↔ Korean support
            </span>

            <span>
              Real person assistance
            </span>

          </div>

        </div>



        <!-- QUICK HELP CARD -->

        <aside class="call-status-card">

          <div class="call-status-top">

            <span class="call-status-dot"></span>

            <strong>
              CALL KOREA
            </strong>

            <small>
              BETA
            </small>

          </div>


          <div class="call-status-question">
            What do you need help with?
          </div>


          <div class="call-status-list">

            <span>
              Lost something
            </span>

            <span>
              Need to call a business
            </span>

            <span>
              Hotel or booking problem
            </span>

            <span>
              Clinic or pharmacy communication
            </span>

            <span>
              Taxi or transport issue
            </span>

            <span>
              Something else
            </span>

          </div>


          <a
            href={freeChatUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="call-status-action"
          >
            TELL US WHAT HAPPENED →
          </a>


          <p>
            Send the place name, phone number,
            screenshot or link if you have one.
          </p>

        </aside>

      </div>

    </section>



    <!-- GET HELP NOW -->

    <section class="call-help-section">

      <div class="wrap">

        <div class="section-head">

          <div>

            <div class="eyebrow">
              GET HELP NOW
            </div>

            <h2>
              What's going on?
            </h2>

          </div>


          <p>
            Choose the closest situation.
            You don't need to know exactly what service you need.
          </p>

        </div>


        <div class="call-situation-grid">

          {
            situations.map((item, index) => (

              <a
                href={freeChatUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="call-situation-card"
              >

                <span class="call-situation-number">
                  {String(index + 1).padStart(2, '0')}
                </span>

                <h3>
                  {item.title}
                </h3>

                <p>
                  {item.description}
                </p>

                <strong>
                  {item.cta}
                </strong>

              </a>

            ))
          }

        </div>

      </div>

    </section>



    <!-- HOW IT WORKS -->

    <section class="call-how-section">

      <div class="wrap">

        <div class="section-head">

          <div>

            <div class="eyebrow">
              HOW IT WORKS
            </div>

            <h2>
              You tell us.<br />
              We handle the Korean.
            </h2>

          </div>


          <p>
            Start with a message.
            We'll confirm what you need before
            any paid service begins.
          </p>

        </div>


        <div class="call-how-grid">

          {
            howItWorks.map((item, index) => (

              <article>

                <span>
                  {String(index + 1).padStart(2, '0')}
                </span>

                <h3>
                  {item.title}
                </h3>

                <p>
                  {item.description}
                </p>

              </article>

            ))
          }

        </div>

      </div>

    </section>



    <!-- FREE CHAT VS CALL -->

    <section
      id="call-now"
      class="call-service-section"
    >

      <div class="wrap">

        <div class="section-head">

          <div>

            <div class="eyebrow">
              CHOOSE YOUR HELP
            </div>

            <h2>
              Ask first.<br />
              Pay only when a call is needed.
            </h2>

          </div>

        </div>



        <div class="call-service-grid">


          <!-- FREE CHAT -->

          <article class="call-service-card">

            <div class="call-service-label">
              START HERE
            </div>


            <h3>
              Chat
            </h3>


            <div class="call-price">
              FREE
            </div>


            <p>
              Not sure what you need?
              Message us first.
            </p>


            <ul>

              <li>
                Explain your situation
              </li>

              <li>
                Send screenshots or links
              </li>

              <li>
                Find out whether a call is needed
              </li>

              <li>
                No payment required to ask
              </li>

            </ul>


            <a
              href={freeChatUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="call-btn call-btn-dark"
            >
              START CHAT — FREE →
            </a>

          </article>



          <!-- CALL NOW -->

          <article
            class="call-service-card call-service-featured"
          >

            <div class="call-service-label">
              NEED IT HANDLED?
            </div>


            <h3>
              Call Korea
            </h3>


            <div class="call-first-price">

              <span>
                FIRST CALL
              </span>

              <strong>
                ₩2,900
              </strong>

              <small>
                up to 5 minutes
              </small>

            </div>


            <div class="call-regular-price">

              <span>
                Regular call
              </span>

              <strong>
                ₩4,900
              </strong>

            </div>


            <p>
              We confirm the request first.
              Payment is completed before
              we make the call.
            </p>


            <a
              href={callNowUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="call-btn call-btn-primary"
            >
              I NEED A CALL NOW →
            </a>

          </article>

        </div>

      </div>

    </section>



    <!-- EXAMPLE -->

    <section class="call-example-section">

      <div class="wrap">

        <div class="call-example-grid">


          <div>

            <div class="eyebrow">
              EXAMPLE
            </div>

            <h2>
              “I left my bag
              in a taxi.”
            </h2>

          </div>



          <div class="call-example-conversation">


            <div class="call-message user">

              <span>
                YOU
              </span>

              <p>
                I think I left my bag in the taxi.
                I have the receipt but I can't speak Korean.
              </p>

            </div>



            <div class="call-message team">

              <span>
                CALL KOREA
              </span>

              <p>
                Send us a photo of the receipt.
                We'll check the information and tell you
                what we can do next.
              </p>

            </div>



            <div class="call-message user">

              <span>
                YOU
              </span>

              <p>
                Can you call them for me?
              </p>

            </div>



            <div class="call-message team">

              <span>
                CALL KOREA
              </span>

              <p>
                Yes. We'll confirm the call details
                and price before making the call.
              </p>

            </div>


          </div>

        </div>

      </div>

    </section>



    <!-- LIMITS -->

    <section class="call-limits-section">

      <div class="wrap">

        <div class="section-head">

          <div>

            <div class="eyebrow">
              BEFORE YOU USE CALL KOREA
            </div>

            <h2>
              What we can — and can't — do.
            </h2>

          </div>

        </div>



        <div class="call-limits-grid">


          <div>

            <strong>
              WE CAN HELP WITH
            </strong>

            <p>
              Korean-language phone calls,
              practical communication,
              bookings, inquiries,
              lost-property follow-up
              and everyday problems.
            </p>

          </div>



          <div>

            <strong>
              WE ARE NOT
            </strong>

            <p>
              Police, emergency medical services,
              a law firm, medical provider
              or government agency.
            </p>

          </div>



          <div>

            <strong>
              FOR EMERGENCIES
            </strong>

            <p>
              Contact official emergency services first:
              112 for police and
              119 for fire or ambulance.
            </p>

          </div>


        </div>

      </div>

    </section>



    <!-- FINAL CTA -->

    <section class="call-final-section">

      <div class="wrap">

        <div class="call-final-cta">


          <div>

            <div class="eyebrow">
              STILL NOT SURE?
            </div>

            <h2>
              Just tell us<br />
              what happened.
            </h2>

            <p>
              You don't need to choose the right service.
              Start with a free message
              and we'll tell you the next step.
            </p>

          </div>



          <a
            href={freeChatUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="call-btn call-btn-dark"
          >
            GET HELP NOW →
          </a>


        </div>

      </div>

    </section>



    <!-- OFFICIAL HELP -->

    <section class="call-public-help">

      <div class="wrap">

        <div class="call-public-help-inner">

          <span>
            OFFICIAL HELP IN KOREA
          </span>

          <strong>
            Police 112
          </strong>

          <strong>
            Fire / Ambulance 119
          </strong>

          <strong>
            Korea Travel Helpline 1330
          </strong>

        </div>

      </div>

    </section>


  </main>

</BaseLayout>
