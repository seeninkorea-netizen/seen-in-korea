---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/call-korea.css';

const whatsappNumber = '821057397087';

const freeChatText = encodeURIComponent(
  [
    'Hi Seen in Korea. I need help with something in Korea.',
    '',
    'What happened:',
    'Location:',
    'How urgent is it:',
    '',
    'You can send a photo, screenshot, map link or voice message.'
  ].join('\n')
);

const freeChatUrl =
  `https://wa.me/${whatsappNumber}?text=${freeChatText}`;

const situations = [
  {
    icon: '⌁',
    title: 'Lost something',
    description: 'Phone, wallet, passport, bag or something left behind.'
  },
  {
    icon: '▰',
    title: 'Booking problem',
    description: 'Hotel, restaurant, salon, clinic or reservation issue.'
  },
  {
    icon: '↗',
    title: 'Taxi / transport',
    description: 'Lost property, route problem or transport communication.'
  },
  {
    icon: '₩',
    title: 'Payment / refund',
    description: 'Charge, cancellation, refund or purchase question.'
  },
  {
    icon: '☎',
    title: 'Call a business',
    description: 'Send the place name or map link. We can find who to contact.'
  },
  {
    icon: '…',
    title: 'Something else',
    description: 'Not sure which category fits? Just tell us what happened.'
  }
];

const makeSituationUrl = (title) => {
  const text = encodeURIComponent(
    [
      `Hi Seen in Korea. I need help with: ${title}`,
      '',
      'What happened:',
      'Location:',
      '',
      'I can send a photo, screenshot, map link or voice message.'
    ].join('\n')
  );

  return `https://wa.me/${whatsappNumber}?text=${text}`;
};

const steps = [
  {
    number: '1',
    title: 'Send what you have',
    description: 'Message, photo, screenshot, map link or voice note.'
  },
  {
    number: '2',
    title: 'We handle the Korean',
    description: 'We figure out who to contact and make the call when needed.'
  },
  {
    number: '3',
    title: 'Get the answer',
    description: 'We send the result back to you in clear English.'
  }
];
---

<BaseLayout
  title="Call Korea | Get Help in Korea | SEEN IN KOREA"
  description="Stuck in Korea? Tell us what happened. Call Korea helps foreigners handle Korean phone calls, lost items, bookings, transport issues, refunds and everyday communication."
>
  <main class="call-korea-page">

    <!-- EMERGENCY -->
    <div class="call-emergency">
      <div class="wrap call-emergency-inner">

        <strong>
          Emergency?
        </strong>

        <span>
          Police 112 · Fire / Ambulance 119
        </span>

        <small>
          Call Korea is not an emergency service.
        </small>

      </div>
    </div>


    <!-- HERO -->
    <section class="call-hero">

      <div class="wrap call-hero-grid">

        <div class="call-hero-copy">

          <div class="eyebrow">
            KOREA HELP · CALL KOREA · BETA
          </div>

          <h1>
            Stuck in Korea?<br />
            <span>We’ll handle the Korean.</span>
          </h1>

          <p>
            Lost something? Need to call a place?
            Booking or refund problem?
            Tell us what happened.
            You do not need to know who to call first.
          </p>


          <div class="call-hero-actions">

            <a
              href={freeChatUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="call-action call-action-free"
            >
              FREE CHAT
              <small>
                Ask us first
              </small>
            </a>


            <a
              href="#call-payment"
              class="call-action call-action-paid"
            >
              HANDLE IT · ₩2,900
              <small>
                First paid request
              </small>
            </a>

          </div>


          <div class="call-trust">

            <span>
              No signup
            </span>

            <span>
              No long form
            </span>

            <span>
              English ↔ Korean
            </span>

          </div>

        </div>


        <!-- DESKTOP SUMMARY -->
        <aside class="call-hero-summary">

          <div class="call-summary-top">

            <strong>
              CALL KOREA
            </strong>

            <span>
              BETA
            </span>

          </div>


          <h2>
            You tell us the problem.<br />
            We handle the Korean.
          </h2>


          <ol>

            <li>
              We find who to contact.
            </li>

            <li>
              We make the Korean call.
            </li>

            <li>
              You get the answer in English.
            </li>

          </ol>


          <div class="call-summary-price">

            <span>
              FIRST REQUEST
            </span>

            <strong>
              ₩2,900
            </strong>

            <small>
              One simple request · typically up to 5 minutes
            </small>

          </div>


          <a href="#call-payment">
            HANDLE IT NOW →
          </a>

        </aside>

      </div>

    </section>


    <!-- SITUATIONS -->
    <section class="call-section call-situations">

      <div class="wrap">

        <div class="call-section-head">

          <div>

            <div class="eyebrow">
              WHAT HAPPENED?
            </div>

            <h2>
              Choose the closest one.
            </h2>

          </div>

          <p>
            Not sure?
            Tap “Something else”
            or start a free chat.
          </p>

        </div>


        <div class="call-situation-list">

          {
            situations.map((item) => (

              <a
                href={makeSituationUrl(item.title)}
                target="_blank"
                rel="noopener noreferrer"
                class="call-situation"
              >

                <span
                  class="call-situation-icon"
                  aria-hidden="true"
                >
                  {item.icon}
                </span>


                <div>

                  <h3>
                    {item.title}
                  </h3>

                  <p>
                    {item.description}
                  </p>

                </div>


                <strong>
                  →
                </strong>

              </a>

            ))
          }

        </div>


        <!-- SEND WHAT YOU HAVE -->
        <div class="call-send-box">

          <div>

            <div class="eyebrow">
              DON’T KNOW THE DETAILS?
            </div>

            <h3>
              Send what you have.
            </h3>

          </div>


          <div class="call-send-options">

            <span>
              PHOTO
            </span>

            <span>
              SCREENSHOT
            </span>

            <span>
              MAP LINK
            </span>

            <span>
              VOICE MESSAGE
            </span>

          </div>


          <p>
            You do not need to find the Korean phone number first.
            A receipt, booking screen or map link can be enough.
          </p>

        </div>

      </div>

    </section>


    <!-- HOW IT WORKS -->
    <section class="call-section call-how">

      <div class="wrap">

        <div class="call-section-head">

          <div>

            <div class="eyebrow">
              HOW IT WORKS
            </div>

            <h2>
              Three steps. That’s it.
            </h2>

          </div>

          <p>
            No account.
            No long request form.
          </p>

        </div>


        <div class="call-step-list">

          {
            steps.map((item) => (

              <article>

                <span>
                  {item.number}
                </span>

                <div>

                  <h3>
                    {item.title}
                  </h3>

                  <p>
                    {item.description}
                  </p>

                </div>

              </article>

            ))
          }

        </div>

      </div>

    </section>


    <!-- START -->
    <section
      id="call-payment"
      class="call-section call-start"
    >

      <div class="wrap">

        <div class="call-section-head">

          <div>

            <div class="eyebrow">
              START HERE
            </div>

            <h2>
              Ask us — or hand it over.
            </h2>

          </div>

        </div>


        <div class="call-start-grid">


          <!-- FREE CHAT -->
          <article class="call-start-card call-start-free">

            <div>

              <span class="call-start-label">
                ASK FIRST
              </span>

              <h3>
                Free Chat
              </h3>

              <strong>
                FREE
              </strong>

            </div>


            <p>
              Ask what to do next.
              Send a photo, screenshot,
              map link or voice message.
            </p>


            <a
              href={freeChatUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              START FREE CHAT →
            </a>

          </article>


          <!-- PAID -->
          <article class="call-start-card call-start-paid">

            <div>

              <span class="call-start-label">
                HANDLE IT FOR ME
              </span>

              <h3>
                Call Korea
              </h3>

              <strong>
                ₩2,900
              </strong>

              <small>
                First request · regular request ₩4,900
              </small>

            </div>


            <p>
              One place,
              one simple Korean phone call
              and a short English result summary.
            </p>


            <button
              type="button"
              aria-disabled="true"
              class="call-payment-button"
            >
              HANDLE IT · ₩2,900 →
            </button>


            <small class="call-payment-note">
              Payment connection is being prepared.
              Paid calls begin only after payment is confirmed.
            </small>

          </article>

        </div>


        <!-- NOTES -->
        <div class="call-compact-notes">

          <div>

            <strong>
              Emergency
            </strong>

            <p>
              Use 112 for police
              or 119 for fire / ambulance.
            </p>

          </div>


          <div>

            <strong>
              Complex requests
            </strong>

            <p>
              Repeated calls,
              negotiation or multiple places
              may need a separate quote.
            </p>

          </div>


          <div>

            <strong>
              Privacy
            </strong>

            <p>
              Only send information
              needed to handle your request.
            </p>

          </div>

        </div>

      </div>

    </section>


    <!-- OFFICIAL HELP -->
    <section class="call-official">

      <div class="wrap">

        <span>
          OFFICIAL HELP IN KOREA
        </span>

        <strong>
          Police 112
        </strong>

        <strong>
          Fire / Ambulance 119
        </strong>

        <strong>
          Travel Helpline 1330
        </strong>

      </div>

    </section>


    <!-- MOBILE QUICK ACTIONS -->
    <div
      class="call-mobile-actions"
      aria-label="Call Korea quick actions"
    >

      <a
        href={freeChatUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="call-mobile-free"
      >
        FREE CHAT
      </a>


      <a
        href="#call-payment"
        class="call-mobile-paid"
      >
        HANDLE IT · ₩2,900
      </a>

    </div>


    <script is:inline>

      const quickActions =
        document.querySelector('.call-mobile-actions');

      const officialHelp =
        document.querySelector('.call-official');


      if (
        quickActions &&
        officialHelp &&
        'IntersectionObserver' in window
      ) {

        const observer =
          new IntersectionObserver(
            ([entry]) => {

              quickActions.classList.toggle(
                'is-hidden',
                entry.isIntersecting
              );

            },
            {
              threshold: 0.15
            }
          );


        observer.observe(officialHelp);

      }

    </script>

  </main>

</BaseLayout>
