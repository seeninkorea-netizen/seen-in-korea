---
import BaseLayout from '../../layouts/BaseLayout.astro';

const whatsappNumber = '821057397087';

const freeChatText = encodeURIComponent(
  [
    'Hi Seen in Korea. I need help with something in Korea.',
    '',
    'What happened:',
    'Location:',
    'How urgent is it:',
    '',
    'I can send a photo, screenshot, map link or voice message if that helps.'
  ].join('\n')
);

const freeChatUrl =
  'https://wa.me/' + whatsappNumber + '?text=' + freeChatText;

const situations = [
  {
    number: '01',
    icon: '⌁',
    title: 'Lost & Stolen',
    description: 'Phone, wallet, passport, bag or something left behind.'
  },
  {
    number: '02',
    icon: '+',
    title: 'Clinic & Pharmacy',
    description: 'Help communicating with a clinic, hospital or pharmacy.'
  },
  {
    number: '03',
    icon: '▰',
    title: 'Hotel & Booking',
    description: 'Reservation problems, check-in issues or special requests.'
  },
  {
    number: '04',
    icon: '↗',
    title: 'Taxi & Transport',
    description: 'Lost property, route problems or transport communication.'
  },
  {
    number: '05',
    icon: '₩',
    title: 'Payment & Refund',
    description: 'Charges, refunds, cancellations or purchase questions.'
  },
  {
    number: '06',
    icon: '☎',
    title: 'Call a Business',
    description: 'Send the name or a map link. We can find the number.'
  }
];

const makeSituationUrl = (title) => {
  const text = encodeURIComponent(
    [
      `Hi Seen in Korea. I need help with: ${title}`,
      '',
      'What happened:',
      'Location:',
      '',
      'I can send a photo, screenshot, map link or voice message.'
    ].join('\n')
  );

  return `https://wa.me/${whatsappNumber}?text=${text}`;
};

const processSteps = [
  {
    number: '01',
    title: 'Send what you have',
    description:
      'A short message, photo, screenshot, map link or voice note is enough.'
  },
  {
    number: '02',
    title: 'We handle the Korean',
    description:
      'We figure out who to contact, explain the situation and make the Korean call when needed.'
  },
  {
    number: '03',
    title: 'You get the answer',
    description:
      'We send the result back to you in clear English and tell you the next step.'
  }
];
---

<BaseLayout
  title="Call Korea | Practical Help in Korea | SEEN IN KOREA"
  description="Stuck in Korea? Tell us what happened. Call Korea helps foreigners handle Korean phone calls, lost items, bookings, transport issues, refunds and practical communication."
>
  <main class="call-korea-page call-korea-v2">

    <!-- EMERGENCY NOTICE -->
    <div class="call-emergency-bar">
      <div class="wrap call-emergency-inner">

        <strong>
          IN IMMEDIATE DANGER?
        </strong>

        <span>
          Police 112 · Fire / Ambulance 119
        </span>

        <span class="call-emergency-note">
          Call Korea is practical support,
          not an emergency service.
        </span>

      </div>
    </div>


    <!-- HERO -->
    <section class="call-hero call-hero-v2">

      <div class="wrap call-hero-grid">

        <div class="call-hero-copy">

          <div class="eyebrow">
            KOREA HELP · CALL KOREA · BETA
          </div>

          <h1>
            Stuck in Korea?<br />
            Tell us what happened.<br />
            <span>We’ll handle the Korean.</span>
          </h1>

          <p class="call-hero-dek">
            Don’t know who to call or what to say?
            Send us what you have.
            We can find the right place,
            handle the Korean phone call
            and tell you what to do next.
          </p>


          <div class="call-hero-actions">

            <a
              href={freeChatUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="call-btn call-btn-primary call-btn-whatsapp"
            >
              GET HELP — FREE CHAT →
            </a>

            <a
              href="#call-payment"
              class="call-btn call-btn-dark"
            >
              HANDLE IT FOR ME · ₩2,900 →
            </a>

          </div>


          <div class="call-hero-trust">

            <span>No charge to ask</span>

            <span>English ↔ Korean support</span>

            <span>No account required</span>

          </div>

        </div>


        <!-- HERO SERVICE CARD -->
        <aside class="call-status-card call-status-card-v2">

          <div class="call-status-top">

            <span class="call-status-dot"></span>

            <strong>
              CALL KOREA
            </strong>

            <small>
              BETA
            </small>

          </div>


          <div class="call-status-question">
            We don’t just translate.<br />
            We handle it for you.
          </div>


          <div class="call-benefit-list">

            <div>
              <span>01</span>
              <p>
                We find the right place to contact.
              </p>
            </div>

            <div>
              <span>02</span>
              <p>
                We make the Korean phone call.
              </p>
            </div>

            <div>
              <span>03</span>
              <p>
                We explain your request clearly.
              </p>
            </div>

            <div>
              <span>04</span>
              <p>
                You get the answer in English.
              </p>
            </div>

          </div>


          <div class="call-card-price">

            <span>
              FIRST REQUEST
            </span>

            <strong>
              ₩2,900
            </strong>

            <small>
              one simple request · typically up to 5 minutes
            </small>

          </div>


          <a
            href="#call-payment"
            class="call-status-action"
          >
            HANDLE IT NOW →
          </a>

        </aside>

      </div>

    </section>


    <!-- WHAT HAPPENED -->
    <section class="call-help-section call-help-v2">

      <div class="wrap">

        <div class="section-head">

          <div>

            <div class="eyebrow">
              WHAT HAPPENED?
            </div>

            <h2>
              Choose a situation — or just message us.
            </h2>

          </div>


          <p>
            You do not need to know the Korean name,
            phone number or the right organization
            before asking for help.
          </p>

        </div>


        <div class="call-help-layout">

          <div class="call-situation-grid">

            {
              situations.map((item) => (

                <a
                  href={makeSituationUrl(item.title)}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="call-situation-card"
                >

                  <div class="call-situation-topline">

                    <span class="call-situation-number">
                      {item.number}
                    </span>

                    <span
                      class="call-situation-icon"
                      aria-hidden="true"
                    >
                      {item.icon}
                    </span>

                  </div>

                  <h3>
                    {item.title}
                  </h3>

                  <p>
                    {item.description}
                  </p>

                  <strong>
                    ASK FOR HELP →
                  </strong>

                </a>

              ))
            }

          </div>


          <!-- SEND ANYTHING -->
          <aside class="call-send-anything">

            <div class="eyebrow">
              DON’T KNOW THE DETAILS?
            </div>

            <h3>
              Just send what you have.
            </h3>


            <div class="call-send-list">

              <div>
                <span>
                  PHOTO
                </span>

                <p>
                  Receipt, sign, ticket or business card.
                </p>
              </div>


              <div>
                <span>
                  SCREENSHOT
                </span>

                <p>
                  Booking, message, payment screen or app.
                </p>
              </div>


              <div>
                <span>
                  MAP LINK
                </span>

                <p>
                  Google Maps, Naver Map or Kakao Map.
                </p>
              </div>


              <div>
                <span>
                  VOICE
                </span>

                <p>
                  Too stressed to type?
                  Send a voice message.
                </p>
              </div>

            </div>


            <p class="call-send-note">
              You don’t need to find the phone number first.
              We’ll figure out where to contact.
            </p>

          </aside>

        </div>

      </div>

    </section>


    <!-- HOW IT WORKS -->
    <section class="call-how-section call-how-v2">

      <div class="wrap">

        <div class="section-head">

          <div>

            <div class="eyebrow">
              HOW IT WORKS
            </div>

            <h2>
              Three steps. No account. No long form.
            </h2>

          </div>


          <p>
            Start with the fastest option for you.
            We only ask for the information
            needed to handle the request.
          </p>

        </div>


        <div class="call-how-grid call-how-grid-v2">

          {
            processSteps.map((item) => (

              <article>

                <span>
                  {item.number}
                </span>

                <h3>
                  {item.title}
                </h3>

                <p>
                  {item.description}
                </p>

              </article>

            ))
          }

        </div>

      </div>

    </section>


    <!-- FREE CHAT / PAID HELP -->
    <section
      id="call-payment"
      class="call-service-section call-service-v2"
    >

      <div class="wrap">

        <div class="section-head">

          <div>

            <div class="eyebrow">
              CHOOSE HOW TO START
            </div>

            <h2>
              Ask free — or hand it over to us.
            </h2>

          </div>


          <p>
            Free chat is for questions and quick guidance.
            Paid help is for one simple request
            that needs us to act for you.
          </p>

        </div>


        <div class="call-service-grid">


          <!-- FREE CHAT -->
          <article class="call-service-card">

            <div class="call-service-label">
              ASK FIRST
            </div>

            <h3>
              Free Chat
            </h3>

            <div class="call-price">
              FREE
            </div>

            <p>
              Tell us what happened and send any screenshot,
              photo, map link or voice message you already have.
            </p>


            <ul>

              <li>
                No account or signup
              </li>

              <li>
                Ask what to do next
              </li>

              <li>
                Send photos, screenshots or links
              </li>

              <li>
                No payment required to ask
              </li>

            </ul>


            <a
              href={freeChatUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="call-btn call-btn-whatsapp"
            >
              GET HELP — FREE CHAT →
            </a>

          </article>


          <!-- PAID HELP -->
          <article class="call-service-card call-service-featured">

            <div class="call-service-label">
              HANDLE IT FOR ME
            </div>

            <h3>
              Call Korea
            </h3>


            <div class="call-first-price">

              <span>
                FIRST REQUEST
              </span>

              <strong>
                ₩2,900
              </strong>

              <small>
                one simple request · typically up to 5 minutes
              </small>

            </div>


            <div class="call-regular-price">

              <span>
                Regular request
              </span>

              <strong>
                ₩4,900
              </strong>

            </div>


            <ul>

              <li>
                One place or business
              </li>

              <li>
                One Korean phone call
              </li>

              <li>
                We explain your request
              </li>

              <li>
                Short English result summary
              </li>

            </ul>


            <button
              type="button"
              class="call-btn call-btn-primary call-pay-placeholder"
              aria-disabled="true"
              data-payment-coming
            >
              HANDLE IT FOR ME · ₩2,900 →
            </button>


            <small class="call-payment-note">
              Secure payment will open here.
              Payment is required before a paid call begins.
            </small>

          </article>

        </div>

      </div>

    </section>


    <!-- EXAMPLE -->
    <section class="call-example-section">

      <div class="wrap">

        <div class="call-example-grid">

          <div>

            <div class="eyebrow">
              EXAMPLE
            </div>

            <h2>
              “I left my bag in a taxi.”
            </h2>

          </div>


          <div class="call-example-conversation">


            <div class="call-message user">

              <span>
                YOU
              </span>

              <p>
                I think I left my bag in the taxi.
                I only have this receipt.
              </p>

            </div>


            <div class="call-message team">

              <span>
                CALL KOREA
              </span>

              <p>
                Send us a photo.
                You don’t need to find the taxi company
                or phone number first.
              </p>

            </div>


            <div class="call-message user">

              <span>
                YOU
              </span>

              <p>
                Can you handle it for me?
              </p>

            </div>


            <div class="call-message team">

              <span>
                CALL KOREA
              </span>

              <p>
                Yes. For a paid request,
                payment is confirmed first.
                Then we make the Korean call
                and send you the result.
              </p>

            </div>

          </div>

        </div>

      </div>

    </section>


    <!-- SERVICE GUIDE -->
    <section class="call-guide-section">

      <div class="wrap">

        <div class="call-guide-grid">


          <article>

            <span>
              ✓
            </span>

            <h3>
              Simple requests
            </h3>

            <p>
              One place, one request,
              one outbound call
              and a short result summary.
            </p>

          </article>


          <article>

            <span>
              !
            </span>

            <h3>
              Emergencies
            </h3>

            <p>
              Contact 112 for police
              or 119 for fire and ambulance.
              Call Korea does not replace emergency services.
            </p>

          </article>


          <article>

            <span>
              ↗
            </span>

            <h3>
              Complex cases
            </h3>

            <p>
              Repeated calls, negotiation
              or multi-place requests
              may need a separate quote before we begin.
            </p>

          </article>


          <article>

            <span>
              ○
            </span>

            <h3>
              Privacy
            </h3>

            <p>
              Only send information needed
              to handle your request.
              Avoid unnecessary sensitive information.
            </p>

          </article>

        </div>

      </div>

    </section>


    <!-- FINAL CTA -->
    <section class="call-final-section">

      <div class="wrap">

        <div class="call-final-cta">

          <div>

            <div class="eyebrow">
              STILL NOT SURE?
            </div>

            <h2>
              Don’t figure it out alone.<br />
              Send it to us.
            </h2>

            <p>
              You do not need to choose the perfect category.
              A message, photo or screenshot is enough to start.
            </p>

          </div>


          <a
            href={freeChatUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="call-btn call-btn-dark"
          >
            GET HELP — FREE CHAT →
          </a>

        </div>

      </div>

    </section>


    <!-- OFFICIAL HELP -->
    <section class="call-public-help">

      <div class="wrap">

        <div class="call-public-help-inner">

          <span>
            OFFICIAL HELP IN KOREA
          </span>

          <strong>
            Police 112
          </strong>

          <strong>
            Fire / Ambulance 119
          </strong>

          <strong>
            Korea Travel Helpline 1330
          </strong>

        </div>

      </div>

    </section>


    <!-- MOBILE STICKY ACTIONS -->
    <div
      class="call-mobile-actions"
      aria-label="Call Korea quick actions"
    >

      <a
        href={freeChatUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="call-mobile-free"
      >
        FREE CHAT
      </a>

      <a
        href="#call-payment"
        class="call-mobile-paid"
      >
        HANDLE IT · ₩2,900
      </a>

    </div>

  </main>
</BaseLayout>
