---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TranslationEstimate from '../../components/TranslationEstimate.astro';

const projectExperience = [
  'NH NongHyup',
  'HYOSUNG',
  'LG Electronics USA',
  'National Cancer Center',
  'Wonkwang Univ. Medical Center',
  'Sejong University',
  'VISTACOMICS',
  'Jakgadabang',
  'BERNAMA TV',
  'The Korea Post Media',
  'The Epoch Times',
  'Jandisoft',
  'Korean Fine Arts Association',
];

const agencyExperience = [
  'DayTranslations',
  'D&T Translations',
  'GTE Localize',
  'Taika Translations',
  'Transparent',
  '1-Stop Asia',
  'E4Net',
  'ONASIA',
  'Evertran',
  'Voithru',
];
---

<BaseLayout
  title="Korean ↔ English Translation & Localization | SEEN IN KOREA"
  description="Korean ↔ English translation, localization, subtitles and linguistic QA for businesses, creators and Korean-market content."
>
  <main class="translation-page">

    <!-- HERO -->
    <section class="translation-hero">
      <div class="translation-wrap hero-grid">

        <div class="hero-copy">
          <div class="eyebrow">
            KOREA HELP · TRANSLATION
          </div>

          <h1>
            Korean ↔ English<br />
            translation that works<br />
            in the real world.
          </h1>

          <p class="hero-dek">
            Documents, websites, videos and Korean-market content —
            translated, localized and reviewed for the people
            who will actually read it.
          </p>

          <div class="hero-actions">
            <a href="#estimate" class="btn-primary">
              GET MY ESTIMATE →
            </a>

            <a href="#work" class="btn-secondary">
              SEE OUR WORK →
            </a>
          </div>

          <div class="hero-stats">
            <div>
              <strong>8+</strong>
              <span>YEARS<br />EXPERIENCE</span>
            </div>

            <div>
              <strong>1M+</strong>
              <span>WORDS<br />TRANSLATED</span>
            </div>

            <div>
              <strong>50+</strong>
              <span>YOUTUBE<br />CREATORS</span>
            </div>

            <div>
              <strong>10+</strong>
              <span>AGENCY<br />COLLABORATIONS</span>
            </div>
          </div>
        </div>

        <aside class="hero-proof">
          <div class="hero-proof-label">
            WHAT YOU GET
          </div>

          <ul>
            <li>Accurate Korean ↔ English translation</li>
            <li>Audience-ready localization</li>
            <li>Human linguistic QA</li>
            <li>Subtitle & on-screen text support</li>
            <li>AI / MTPE review available</li>
            <li>Second English-language review available</li>
          </ul>

          <div class="hero-proof-note">
            Accuracy first.<br />
            Naturalness where it matters.
          </div>
        </aside>

      </div>
    </section>


    <!-- TRUST STRIP -->
    <section class="trust-strip">
      <div class="translation-wrap trust-strip-inner">
        <span>✓ ACCURATE & NATURAL</span>
        <span>✓ CULTURALLY LOCALIZED</span>
        <span>✓ HUMAN QUALITY REVIEW</span>
        <span>✓ CONFIDENTIAL WORKFLOW</span>
      </div>
    </section>


    <!-- CASE STUDIES -->
    <section class="translation-section" id="work">
      <div class="translation-wrap">

        <div class="section-head">
          <div>
            <div class="section-kicker">
              REAL PROJECT EXPERIENCE
            </div>

            <h2>
              Featured case studies
            </h2>

            <p>
              Real project scopes across finance, video and localization.
            </p>
          </div>
        </div>

        <div class="case-grid">

          <article class="case-card">
            <div class="case-tag">
              FINANCIAL · UX
            </div>

            <h3>
              Digital banking localization
            </h3>

            <p>
              Website, mobile service and kiosk / ATM interface localization
              with terminology and interface-consistency review.
            </p>

            <div class="case-meta">
              <span>KO ↔ EN</span>
              <span>UX · FINANCE</span>
            </div>

            <div class="case-qa">
              <strong>QA FOCUS</strong>
              Terminology · UI consistency · user-facing clarity
            </div>
          </article>


          <article class="case-card">
            <div class="case-tag">
              VIDEO · SUBTITLES
            </div>

            <h3>
              50+ creator channels
            </h3>

            <p>
              Dialogue translation, subtitles, on-screen text,
              contextual notes and final linguistic QA.
            </p>

            <div class="case-meta">
              <span>EN → KO</span>
              <span>VIDEO · MEDIA</span>
            </div>

            <div class="case-qa">
              <strong>QA FOCUS</strong>
              Tone · context · readability · omissions
            </div>
          </article>


          <article class="case-card">
            <div class="case-tag">
              GAME · LOCALIZATION
            </div>

            <h3>
              98K-word game project
            </h3>

            <p>
              UI translation, localization and QA across
              a long-form game project.
            </p>

            <div class="case-meta">
              <span>KO ↔ EN</span>
              <span>GAME</span>
            </div>

            <div class="case-qa">
              <strong>QA FOCUS</strong>
              Terminology · consistency · character voice
            </div>
          </article>

        </div>

      </div>
    </section>


    <!-- SERVICES -->
    <section class="translation-section section-soft">
      <div class="translation-wrap">

        <div class="section-head">
          <div>
            <div class="section-kicker">
              SERVICES
            </div>

            <h2>
              What we do
            </h2>

            <p>
              Three core services for real-world Korean ↔ English content.
            </p>
          </div>
        </div>

        <div class="service-grid">

          <article class="service-card">
            <div class="service-icon">文</div>

            <h3>
              Translation & Localization
            </h3>

            <p>
              Business documents, websites, marketing content
              and Korean-market materials.
            </p>

            <ul>
              <li>Terminology consistency</li>
              <li>Cultural and contextual adaptation</li>
              <li>Final QA and proofreading</li>
            </ul>
          </article>


          <article class="service-card">
            <div class="service-icon">▶</div>

            <h3>
              Video & Subtitle Localization
            </h3>

            <p>
              YouTube, interviews, subtitles,
              on-screen text and creator content.
            </p>

            <ul>
              <li>Dialogue & on-screen text</li>
              <li>Natural subtitle adaptation</li>
              <li>Entity and background notes</li>
            </ul>
          </article>


          <article class="service-card">
            <div class="service-icon">✓</div>

            <h3>
              Review & AI Post-editing
            </h3>

            <p>
              Review and improve existing translations,
              including AI-generated content.
            </p>

            <ul>
              <li>Meaning and omission checks</li>
              <li>Tone and terminology correction</li>
              <li>Naturalness and clarity review</li>
            </ul>
          </article>

        </div>


        <div class="specialized">

          <strong>
            Other specialized project experience
          </strong>

          <div class="specialized-list">
            <span>Medical & Healthcare</span>
            <span>Legal & Finance</span>
            <span>Technical & IT</span>
            <span>Game & Web Novel</span>
            <span>Academic & Research</span>
            <span>Media & Journalism</span>
          </div>

        </div>

      </div>
    </section>


    <!-- SAMPLE -->
    <section class="translation-section sample-section">
      <div class="translation-wrap">

        <div class="section-head">
          <div>
            <div class="section-kicker">
              ILLUSTRATIVE SIK SAMPLE
            </div>

            <h2>
              See the difference
            </h2>

            <p>
              The same meaning. A more natural and audience-ready result.
            </p>
          </div>
        </div>


        <div class="sample-grid">

          <div class="sample-card">
            <small>
              ORIGINAL KOREAN
            </small>

            <p class="sample-korean">
              본 제품은 고객님의 편의를 위하여
              다양한 기능을 제공합니다.
            </p>
          </div>


          <div class="sample-card">
            <small>
              LITERAL TRANSLATION
            </small>

            <p>
              This product provides various functions
              for the convenience of customers.
            </p>
          </div>


          <div class="sample-card sample-highlight">
            <small>
              SIK LOCALIZED TRANSLATION
            </small>

            <p>
              Designed to make your experience simpler
              and more convenient, this product offers
              a range of useful features.
            </p>
          </div>


          <aside class="sample-reason">
            <strong>
              WHY WE CHANGED IT
            </strong>

            <ul>
              <li>More natural English</li>
              <li>Clearer for the reader</li>
              <li>Preserves the original meaning</li>
              <li>Fits public-facing content better</li>
            </ul>
          </aside>

        </div>

      </div>
    </section>


    <!-- QUALITY -->
    <section class="translation-section quality-section">
      <div class="translation-wrap quality-grid">

        <div>
          <div class="section-kicker">
            QUALITY ASSURANCE
          </div>

          <h2>
            Not just translated.<br />
            Checked.
          </h2>

          <p>
            A translation can be technically correct and still sound wrong.
            We review the areas that create the most expensive mistakes.
          </p>
        </div>

        <div class="quality-items">

          <div>
            <strong>Meaning</strong>
            <span>Original meaning, conditions, negation and cause/effect.</span>
          </div>

          <div>
            <strong>Omissions</strong>
            <span>Dialogue, numbers, units and missing on-screen text.</span>
          </div>

          <div>
            <strong>Terminology</strong>
            <span>Product names, technical terms, people and organizations.</span>
          </div>

          <div>
            <strong>Tone</strong>
            <span>Formal / informal register and intended audience.</span>
          </div>

          <div>
            <strong>Numbers & Facts</strong>
            <span>Dates, percentages, units and proper nouns.</span>
          </div>

          <div>
            <strong>Final Proof</strong>
            <span>Spelling, formatting, consistency and final delivery check.</span>
          </div>

        </div>

      </div>
    </section>


    <!-- PEOPLE -->
    <section class="translation-section section-soft">
      <div class="translation-wrap">

        <div class="section-head">
          <div>
            <div class="section-kicker">
              WHO IS BEHIND THE WORK
            </div>

            <h2>
              Human responsibility,
              not anonymous output.
            </h2>
          </div>
        </div>


        <div class="people-grid">

          <article class="profile-card">

            <div class="profile-initial">
              DK
            </div>

            <div>
              <h3>
                Dokyun Kim
              </h3>

              <strong>
                Lead Translator & Localization Specialist
              </strong>

              <p>
                8+ years across translation, localization,
                video subtitles and linguistic QA, with experience
                spanning finance, medical, legal, media,
                games and Korean-market content.
              </p>

              <a
                href="#experience"
                class="text-link"
              >
                VIEW EXPERIENCE →
              </a>
            </div>

          </article>


          <article class="profile-card">

            <div class="profile-initial">
              EN
            </div>

            <div>
              <h3>
                Additional English-language review
              </h3>

              <strong>
                Available for selected projects
              </strong>

              <p>
                Public-facing Korean → English projects can receive
                an additional independent review for clarity,
                naturalness and reader-facing quality.
              </p>

            </div>

          </article>

        </div>

      </div>
    </section>


    <!-- HOW -->
    <section class="translation-section">
      <div class="translation-wrap">

        <div class="section-head">
          <div>
            <div class="section-kicker">
              SIMPLE FROM START TO FINISH
            </div>

            <h2>
              How it works
            </h2>
          </div>
        </div>


        <div class="steps">

          <article>
            <span>01</span>
            <strong>Upload</strong>
            <p>
              Upload a file, paste text or share a video URL.
            </p>
          </article>

          <article>
            <span>02</span>
            <strong>Estimate</strong>
            <p>
              See an estimated price and project scope.
            </p>
          </article>

          <article>
            <span>03</span>
            <strong>Approve & pay</strong>
            <p>
              Review the final quote before payment.
            </p>
          </article>

          <article>
            <span>04</span>
            <strong>We get to work</strong>
            <p>
              Translation, localization and QA begin.
            </p>
          </article>

          <article>
            <span>05</span>
            <strong>Receive your file</strong>
            <p>
              Download the completed project from your order page.
            </p>
          </article>

        </div>

      </div>
    </section>


    <!-- SECURITY -->
    <section class="security-section">
      <div class="translation-wrap security-grid">

        <div>
          <div class="security-icon">
            🔒
          </div>

          <div>
            <strong>
              Your files stay private.
            </strong>

            <p>
              Files are used only for your project.
              NDA support will be available for applicable projects.
            </p>
          </div>
        </div>


        <div>
          <div class="security-icon">
            ↺
          </div>

          <div>
            <strong>
              1 revision included.
            </strong>

            <p>
              Wording, tone and terminology adjustments
              within the original source scope.
            </p>
          </div>
        </div>


        <div>
          <div class="security-icon">
            ✓
          </div>

          <div>
            <strong>
              Final price before payment.
            </strong>

            <p>
              No translation work starts until
              the final scope and price are approved.
            </p>
          </div>
        </div>

      </div>
    </section>


    <!-- EXPERIENCE -->
    <section
      class="experience-section"
      id="experience"
    >
      <div class="translation-wrap">

        <div class="experience-head">
          <div>
            <div class="section-kicker">
              SELECTED PROJECT & COLLABORATION EXPERIENCE
            </div>

            <p>
              Experience across companies, institutions,
              media organizations and language-service agencies.
            </p>
          </div>

          <small>
            Logos / names indicate project or collaboration experience
            and do not imply endorsement.
          </small>
        </div>


        <div class="marquee-block">

          <div class="marquee-label">
            PROJECT EXPERIENCE
          </div>

          <div class="marquee">
            <div class="marquee-track">
              {[...projectExperience, ...projectExperience].map((item) => (
                <span>{item}</span>
              ))}
            </div>
          </div>

        </div>


        <div class="marquee-block">

          <div class="marquee-label">
            AGENCY COLLABORATIONS
          </div>

          <div class="marquee marquee-reverse">
            <div class="marquee-track">
              {[...agencyExperience, ...agencyExperience].map((item) => (
                <span>{item}</span>
              ))}
            </div>
          </div>

        </div>

      </div>
    </section>


    <!-- AGENCY -->
    <section class="partner-section">
      <div class="translation-wrap partner-grid">

        <div>
          <div class="section-kicker">
            AGENCIES · COMPANIES · RECURRING PROJECTS
          </div>

          <h2>
            Need a long-term Korean partner?
          </h2>

          <p>
            For language-service agencies, companies
            and recurring localization workflows.
          </p>
        </div>

        <a href="mailto:seeninkorea@gmail.com" class="btn-primary">
          WORK WITH US →
        </a>

      </div>
    </section>


    <!-- ESTIMATE -->
    <section
      class="estimate-section"
      id="estimate"
    >
      <div class="translation-wrap estimate-grid">

        <div>
          <div class="section-kicker">
            START HERE
          </div>

          <h2>
            Get an estimate in seconds.
          </h2>

          <p>
            Upload your content, choose the service
            and see the estimated price before ordering.
          </p>

          <div class="estimate-points">
            <span>✓ No sign-up required</span>
            <span>✓ Final price before payment</span>
            <span>✓ Human review for complex projects</span>
          </div>
        </div>

        <div class="estimate-preview">
          <TranslationEstimate />
        </div>

      </div>
    </section>

  </main>
</BaseLayout>


<style>

  :global(body) {
    margin: 0;
  }

  .translation-page {
    --navy: #0b2645;
    --teal: #078d91;
    --teal-dark: #05777a;
    --soft: #f4f9fc;
    --line: #dfe8ee;
    --text: #1d334c;
    --muted: #627287;
    color: var(--text);
    background: #fff;
  }

  .translation-wrap {
    width: min(1180px, calc(100% - 40px));
    margin: 0 auto;
  }

  .translation-hero {
    padding: 80px 0 70px;
    background:
      radial-gradient(circle at 80% 20%, rgba(7,141,145,.15), transparent 30%),
      linear-gradient(135deg, #f8fbfe 0%, #edf6fb 55%, #fbf4e8 100%);
    overflow: hidden;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.35fr .65fr;
    gap: 70px;
    align-items: center;
  }

  .eyebrow,
  .section-kicker {
    font-size: 12px;
    font-weight: 900;
    letter-spacing: .1em;
    color: var(--teal);
  }

  .hero-copy h1 {
    margin: 14px 0 20px;
    font-size: clamp(48px, 6vw, 78px);
    line-height: .97;
    letter-spacing: -.055em;
    color: var(--navy);
  }

  .hero-dek {
    font-size: 19px;
    line-height: 1.65;
    max-width: 720px;
    color: #354d66;
  }

  .hero-actions {
    display: flex;
    gap: 12px;
    margin-top: 30px;
    flex-wrap: wrap;
  }

  .btn-primary,
  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 24px;
    border-radius: 999px;
    text-decoration: none;
    font-size: 14px;
    font-weight: 900;
  }

  .btn-primary {
    background: var(--teal);
    color: #fff;
  }

  .btn-primary:hover {
    background: var(--teal-dark);
  }

  .btn-secondary {
    border: 1px solid #b7c7d4;
    color: var(--navy);
    background: rgba(255,255,255,.8);
  }

  .hero-stats {
    margin-top: 48px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  .hero-stats > div {
    padding: 0 18px;
    border-left: 1px solid #cad6df;
  }

  .hero-stats > div:first-child {
    padding-left: 0;
    border-left: 0;
  }

  .hero-stats strong {
    display: block;
    color: var(--navy);
    font-size: 36px;
    line-height: 1;
  }

  .hero-stats span {
    display: block;
    margin-top: 7px;
    font-size: 10px;
    font-weight: 900;
    line-height: 1.25;
  }

  .hero-proof {
    border: 1px solid rgba(255,255,255,.8);
    background: rgba(255,255,255,.86);
    backdrop-filter: blur(14px);
    border-radius: 22px;
    padding: 28px;
    box-shadow: 0 16px 45px rgba(16,43,66,.10);
  }

  .hero-proof-label {
    font-size: 11px;
    font-weight: 900;
    color: var(--teal);
  }

  .hero-proof ul {
    padding: 0;
    margin: 20px 0;
    list-style: none;
  }

  .hero-proof li {
    padding: 10px 0 10px 28px;
    border-bottom: 1px solid #edf2f5;
    position: relative;
    font-size: 14px;
  }

  .hero-proof li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--teal);
    font-weight: 900;
  }

  .hero-proof-note {
    color: var(--navy);
    font-size: 23px;
    line-height: 1.2;
    font-weight: 900;
  }


  .trust-strip {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: #fff;
  }

  .trust-strip-inner {
    display: flex;
    justify-content: space-between;
    gap: 22px;
    padding: 17px 0;
    font-size: 11px;
    font-weight: 900;
    color: var(--navy);
  }


  .translation-section {
    padding: 72px 0;
  }

  .section-soft {
    background: var(--soft);
  }

  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 30px;
    margin-bottom: 30px;
  }

  .section-head h2,
  .quality-grid h2,
  .partner-grid h2,
  .estimate-grid h2 {
    margin: 7px 0;
    color: var(--navy);
    font-size: clamp(34px, 4vw, 48px);
    letter-spacing: -.045em;
    line-height: 1;
  }

  .section-head p,
  .quality-grid p,
  .partner-grid p,
  .estimate-grid p {
    color: var(--muted);
    margin: 7px 0 0;
    line-height: 1.6;
  }


  .case-grid,
  .service-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  .case-card,
  .service-card {
    border: 1px solid var(--line);
    border-radius: 18px;
    background: #fff;
    padding: 25px;
  }

  .case-card h3,
  .service-card h3,
  .profile-card h3 {
    margin: 8px 0;
    font-size: 21px;
    color: var(--navy);
  }

  .case-card p,
  .service-card p,
  .profile-card p {
    color: var(--muted);
    line-height: 1.6;
    font-size: 14px;
  }

  .case-tag {
    font-size: 10px;
    font-weight: 900;
    color: var(--teal);
  }

  .case-meta {
    display: flex;
    gap: 7px;
    margin-top: 20px;
  }

  .case-meta span {
    background: #ebf7f7;
    color: var(--teal-dark);
    padding: 6px 9px;
    border-radius: 999px;
    font-size: 10px;
    font-weight: 900;
  }

  .case-qa {
    border-top: 1px solid var(--line);
    margin-top: 18px;
    padding-top: 16px;
    font-size: 12px;
    line-height: 1.5;
    color: var(--muted);
  }

  .case-qa strong {
    display: block;
    color: var(--navy);
    font-size: 10px;
  }


  .service-icon {
    width: 45px;
    height: 45px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: #e7f6fb;
    color: #087d8d;
    font-size: 20px;
    font-weight: 900;
  }

  .service-card ul {
    list-style: none;
    padding: 0;
    margin: 18px 0 0;
  }

  .service-card li {
    padding: 6px 0 6px 21px;
    font-size: 13px;
    position: relative;
  }

  .service-card li::before {
    content: "✓";
    color: var(--teal);
    position: absolute;
    left: 0;
    font-weight: 900;
  }

  .specialized {
    margin-top: 22px;
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: #fff;
  }

  .specialized > strong {
