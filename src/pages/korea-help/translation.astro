---
import BaseLayout from '../../layouts/BaseLayout.astro';

const fullPortfolioUrl =
  '/portfolio/Dokyun_Kim_Translation_Localization_Portfolio_FINAL_v19.pdf';

const inquiryMailto =
  'mailto:seeninkorea@gmail.com?subject=Creator%20Localization%20Inquiry';

const selectedExperience = [
  'NH NongHyup Bank',
  'HYOSUNG',
  'LG Electronics USA',
  'National Cancer Center',
  'Wonkwang Univ. Medical Center',
  'Sejong University',
  'BERNAMA TV',
  'The Korea Post Media',
  'The Epoch Times',
  'VISTACOMICS',
  'Jandisoft',
  'Jakgadabang'
];

const agencyExperience = [
  'DayTranslations',
  'D&T Translations',
  'GTE Localize',
  'Taika Translations',
  'Transparent',
  '1-Stop Asia',
  'E4Net',
  'ONASIA',
  'Evertran',
  'Voithru'
];
---

<BaseLayout
  title="Korean ↔ English Creator Localization | SEEN IN KOREA"
  description="Korean ↔ English creator localization, subtitles and linguistic QA led by one dedicated translator who learns your channel's voice."
>
  <main class="translation-page">

    <!-- HERO -->
    <section class="hero">
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <div class="eyebrow">CREATOR LOCALIZATION · KOREAN ↔ ENGLISH</div>

          <h1>
            Take your channel global.<br />
            <span>Keep your voice.</span>
          </h1>

          <p class="hero-dek">
            English localization for Korean creators — and Korean localization
            for global creators. One dedicated translator learns your channel’s
            tone, recurring language and audience instead of treating every
            video like a new assignment.
          </p>

          <div class="hero-actions">
            <a href={inquiryMailto} class="btn btn-primary">
              SEND A VIDEO FOR A QUOTE →
            </a>

            <a
              href={fullPortfolioUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-secondary"
            >
              VIEW FULL PORTFOLIO
            </a>
          </div>

          <p class="hero-note">
            Share a recent video URL and target language. We’ll review the scope
            and reply by email with a tailored quote.
          </p>
        </div>

        <aside class="hero-card">
          <div class="hero-card-label">WHY THIS IS DIFFERENT</div>

          <div class="hero-card-big">
            One channel.<br />
            One lead translator.
          </div>

          <p>
            The same person stays with the channel, building familiarity with
            character voice, running jokes, terminology, names and preferred
            phrasing over time.
          </p>

          <div class="hero-card-rule"></div>

          <ul>
            <li>Channel-specific tone continuity</li>
            <li>Dialogue + subtitles + on-screen text</li>
            <li>Cultural adaptation, not word-for-word output</li>
            <li>Final linguistic QA before delivery</li>
          </ul>
        </aside>
      </div>

      <div class="wrap stats">
        <div>
          <strong>50+</strong>
          <span>YouTube creators</span>
        </div>
        <div>
          <strong>10</strong>
          <span>Active creator channels</span>
        </div>
        <div>
          <strong>140+</strong>
          <span>Legacy video assignments</span>
        </div>
        <div>
          <strong>8+</strong>
          <span>Years in localization</span>
        </div>
      </div>
    </section>

    <!-- POSITIONING -->
    <section class="section section-dark">
      <div class="wrap statement-grid">
        <div>
          <div class="eyebrow eyebrow-light">NOT JUST SUBTITLES</div>
          <h2>
            Translation is only one part
            of how a video travels.
          </h2>
        </div>

        <div class="statement-copy">
          <p>
            A technically correct subtitle can still flatten a creator’s
            personality. We localize for the viewer who will actually watch
            the video — while protecting the meaning of the original.
          </p>

          <div class="deliverables">
            <span>Dialogue</span>
            <span>Subtitle adaptation</span>
            <span>On-screen text</span>
            <span>Titles & descriptions</span>
            <span>Cultural context</span>
            <span>Final QA</span>
          </div>
        </div>
      </div>
    </section>

    <!-- COMPARISON -->
    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <div class="eyebrow">CONTINUITY MATTERS</div>
          <h2>Why a dedicated translator matters.</h2>
          <p>
            Creator content depends on personality. Consistency becomes more
            valuable as a channel publishes more videos.
          </p>
        </div>

        <div class="compare-grid">
          <article class="compare-card compare-muted">
            <div class="compare-label">ROTATING WORKFLOW</div>
            <h3>Every video starts from zero.</h3>
            <ul>
              <li>Different translator depending on availability</li>
              <li>Channel tone must be re-learned repeatedly</li>
              <li>Recurring phrases can drift across videos</li>
              <li>Character voice depends on each individual assignment</li>
            </ul>
          </article>

          <article class="compare-card compare-featured">
            <div class="compare-label">SEEN IN KOREA WORKFLOW</div>
            <h3>The channel context accumulates.</h3>
            <ul>
              <li>One lead translator follows the channel over time</li>
              <li>Voice, terminology and recurring references stay consistent</li>
              <li>Previous decisions inform future episodes</li>
              <li>Final QA checks meaning, tone, names and omissions</li>
            </ul>
          </article>
        </div>
      </div>
    </section>

    <!-- SAMPLE -->
    <section class="section sample-section">
      <div class="wrap">
        <div class="section-head">
          <div class="eyebrow">ILLUSTRATIVE CREATOR SAMPLE</div>
          <h2>Correct English is not always natural English.</h2>
          <p>
            A simple example of how tone changes when copy is localized for
            an actual viewer rather than translated sentence by sentence.
          </p>
        </div>

        <div class="sample-shell">
          <div class="sample-source">
            <small>ORIGINAL KOREAN</small>
            <p>
              이번 주 내내 식단 잘 지켰는데 오늘 너무 먹었어요.
              이러다 바로 살찌는 거 아니야?
            </p>
          </div>

          <div class="sample-row">
            <div class="sample-label">LITERAL</div>
            <div>
              I kept my diet well all week, but I ate too much today.
              Won’t I gain weight right away?
            </div>
          </div>

          <div class="sample-row sample-final">
            <div class="sample-label">LOCALIZED</div>
            <div>
              I was so good with my diet all week… and then I completely
              overdid it today. Watch me gain it all back overnight.
            </div>
          </div>

          <div class="sample-reason">
            <strong>WHY IT CHANGED</strong>
            <p>
              The meaning stays intact, but the phrasing is reshaped into a
              more natural creator-style line with the same self-aware,
              conversational tone.
            </p>
          </div>
        </div>

        <small class="sample-disclaimer">
          Illustrative sample created for portfolio demonstration; not client source material.
        </small>
      </div>
    </section>

    <!-- WORKFLOW -->
    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <div class="eyebrow">WORKFLOW</div>
          <h2>Simple on your side.</h2>
        </div>

        <div class="steps">
          <article>
            <span>01</span>
            <strong>Send the video</strong>
            <p>Share the YouTube URL or source file and target language.</p>
          </article>

          <article>
            <span>02</span>
            <strong>Scope & quote</strong>
            <p>We review length, subtitle needs, on-screen text and deadline.</p>
          </article>

          <article>
            <span>03</span>
            <strong>Localization</strong>
            <p>Dialogue, subtitles and creator-specific language are adapted.</p>
          </article>

          <article>
            <span>04</span>
            <strong>Final QA</strong>
            <p>Meaning, omissions, names, terminology and tone are checked.</p>
          </article>

          <article>
            <span>05</span>
            <strong>Delivery</strong>
            <p>Receive the agreed format, including SRT/TXT when required.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- EXPERIENCE -->
    <section class="section experience-section">
      <div class="wrap experience-grid">
        <div>
          <div class="eyebrow">SELECTED EXPERIENCE</div>
          <h2>Creator work backed by broader localization experience.</h2>
          <p>
            Video is the focus here, but the working method is supported by
            experience across media, finance, legal, medical, technical,
            game and corporate localization.
          </p>

          <a
            href={fullPortfolioUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-link"
          >
            OPEN FULL PORTFOLIO →
          </a>
        </div>

        <div>
          <div class="experience-label">PROJECT EXPERIENCE</div>
          <div class="name-grid">
            {selectedExperience.map((item) => (
              <span>{item}</span>
            ))}
          </div>

          <div class="experience-label agency-label">AGENCY COLLABORATIONS</div>
          <div class="agency-list">
            {agencyExperience.map((item) => (
              <span>{item}</span>
            ))}
          </div>

          <small class="experience-note">
            Names indicate project or collaboration experience and do not imply endorsement or an ongoing partnership.
          </small>
        </div>
      </div>
    </section>

    <!-- HUMAN -->
    <section class="section human-section">
      <div class="wrap human-grid">
        <div class="human-mark">DK</div>

        <div>
          <div class="eyebrow">WHO IS BEHIND THE WORK</div>
          <h2>Dokyun Kim</h2>
          <strong>Lead Translator & Localization Specialist</strong>

          <p>
            8+ years across Korean ↔ English translation, creator video
            localization and linguistic QA. Experience includes 1M+ cumulative
            words and work across 50+ YouTube creators, with 10 channels
            currently supported on an ongoing basis.
          </p>

          <div class="human-links">
            <a href="mailto:seeninkorea@gmail.com">seeninkorea@gmail.com</a>
            <a
              href={fullPortfolioUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Full portfolio
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- FINAL CTA -->
    <section class="cta-section">
      <div class="wrap cta-grid">
        <div>
          <div class="eyebrow eyebrow-light">START WITH ONE VIDEO</div>
          <h2>Have a video in mind?</h2>
          <p>
            Send the URL, target language and preferred deadline.
            We’ll review the actual scope and reply with a tailored quote.
          </p>
        </div>

        <div class="cta-actions">
          <a href={inquiryMailto} class="btn btn-white">
            EMAIL PROJECT DETAILS →
          </a>

          <a
            href={fullPortfolioUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-outline"
          >
            VIEW PORTFOLIO
          </a>
        </div>
      </div>

      <div class="wrap trust-row">
        <span>NDA available upon request</span>
        <span>Confidential files handled only for project delivery</span>
        <span>Scope and price confirmed before work begins</span>
      </div>
    </section>

  </main>
</BaseLayout>

<style>
  :global(body) {
    margin: 0;
  }

  .translation-page {
    --ink: #111111;
    --paper: #f4f0e8;
    --orange: #ff4f12;
    --line: #ded8cf;
    --muted: #65615b;
    --soft: #faf8f3;
    color: var(--ink);
    background: #fff;
  }

  .wrap {
    width: min(1180px, calc(100% - 40px));
    margin: 0 auto;
  }

  .eyebrow {
    font-size: 11px;
    font-weight: 900;
    letter-spacing: .13em;
    color: var(--orange);
  }

  .eyebrow-light {
    color: #ff8154;
  }

  .hero {
    padding: 84px 0 0;
    background: var(--paper);
    border-bottom: 1px solid var(--line);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.25fr .75fr;
    gap: 72px;
    align-items: start;
  }

  .hero-copy h1 {
    margin: 17px 0 22px;
    max-width: 800px;
    font-size: clamp(52px, 6.5vw, 88px);
    line-height: .92;
    letter-spacing: -.065em;
  }

  .hero-copy h1 span {
    color: var(--orange);
  }

  .hero-dek {
    max-width: 735px;
    margin: 0;
    color: #3f3c37;
    font-size: 19px;
    line-height: 1.65;
  }

  .hero-actions,
  .cta-actions,
  .human-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .hero-actions {
    margin-top: 30px;
  }

  .btn {
    min-height: 50px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 23px;
    border-radius: 2px;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: .04em;
    text-decoration: none;
    box-sizing: border-box;
  }

  .btn-primary {
    background: var(--ink);
    color: #fff;
  }

  .btn-primary:hover {
    background: var(--orange);
  }

  .btn-secondary {
    border: 1px solid #aaa39a;
    color: var(--ink);
    background: transparent;
  }

  .hero-note {
    margin: 15px 0 0;
    color: #76716a;
    font-size: 12px;
    line-height: 1.55;
  }

  .hero-card {
    background: var(--ink);
    color: #fff;
    padding: 34px;
  }

  .hero-card-label {
    color: #ff8154;
    font-size: 10px;
    font-weight: 900;
    letter-spacing: .12em;
  }

  .hero-card-big {
    margin-top: 22px;
    font-size: 36px;
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -.04em;
  }

  .hero-card p {
    color: #c8c4bd;
    font-size: 14px;
    line-height: 1.65;
  }

  .hero-card-rule {
    height: 1px;
    margin: 25px 0 14px;
    background: #343434;
  }

  .hero-card ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .hero-card li {
    padding: 10px 0 10px 22px;
    border-bottom: 1px solid #2c2c2c;
    position: relative;
    font-size: 12px;
    line-height: 1.5;
  }

  .hero-card li::before {
    content: "→";
    position: absolute;
    left: 0;
    color: var(--orange);
  }

  .stats {
    margin-top: 70px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid #cfc8bf;
  }

  .stats > div {
    padding: 26px 22px 30px;
    border-left: 1px solid #cfc8bf;
  }

  .stats > div:first-child {
    border-left: 0;
    padding-left: 0;
  }

  .stats strong {
    display: block;
    font-size: 40px;
    line-height: 1;
    letter-spacing: -.04em;
  }

  .stats span {
    display: block;
    margin-top: 7px;
    color: #6b665f;
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
  }

  .section {
    padding: 82px 0;
  }

  .section-dark {
    background: var(--ink);
    color: #fff;
  }

  .statement-grid {
    display: grid;
    grid-template-columns: .95fr 1.05fr;
    gap: 80px;
    align-items: start;
  }

  .statement-grid h2,
  .section-head h2,
  .experience-grid h2,
  .human-grid h2,
  .cta-grid h2 {
    margin: 10px 0 0;
    font-size: clamp(38px, 5vw, 58px);
    line-height: .98;
    letter-spacing: -.05em;
  }

  .statement-copy > p {
    margin: 0;
    color: #c7c3bc;
    font-size: 17px;
    line-height: 1.7;
  }

  .deliverables {
    margin-top: 30px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .deliverables span {
    padding: 9px 12px;
    border: 1px solid #3b3b3b;
    font-size: 11px;
    font-weight: 800;
  }

  .section-head {
    max-width: 820px;
    margin-bottom: 34px;
  }

  .section-head p,
  .experience-grid p,
  .human-grid p,
  .cta-grid p {
    color: var(--muted);
    line-height: 1.7;
  }

  .compare-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .compare-card {
    min-height: 330px;
    padding: 32px;
    border: 1px solid var(--line);
  }

  .compare-muted {
    background: #f7f5f0;
  }

  .compare-featured {
    background: var(--paper);
    border-top: 5px solid var(--orange);
  }

  .compare-label,
  .experience-label {
    color: var(--orange);
    font-size: 10px;
    font-weight: 900;
    letter-spacing: .11em;
  }

  .compare-card h3 {
    margin: 14px 0 24px;
    font-size: 27px;
    letter-spacing: -.03em;
  }

  .compare-card ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .compare-card li {
    padding: 12px 0;
    border-top: 1px solid var(--line);
    font-size: 13px;
    line-height: 1.55;
  }

  .sample-section {
    background: var(--soft);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .sample-shell {
    border: 1px solid #ccc5bb;
    background: #fff;
  }

  .sample-source {
    padding: 26px;
    background: var(--ink);
    color: #fff;
  }

  .sample-source small,
  .sample-label {
    font-size: 10px;
    font-weight: 900;
    letter-spacing: .1em;
  }

  .sample-source small {
    color: #ff8154;
  }

  .sample-source p {
    margin: 12px 0 0;
    max-width: 850px;
    font-size: 19px;
    line-height: 1.65;
  }

  .sample-row {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 24px;
    padding: 24px 26px;
    border-bottom: 1px solid var(--line);
    line-height: 1.7;
  }

  .sample-label {
    color: #7d7770;
  }

  .sample-final {
    background: #fff3ed;
    font-weight: 800;
  }

  .sample-final .sample-label {
    color: var(--orange);
  }

  .sample-reason {
    padding: 24px 26px;
  }

  .sample-reason strong {
    color: var(--orange);
    font-size: 10px;
    letter-spacing: .1em;
  }

  .sample-reason p {
    margin: 8px 0 0;
    color: var(--muted);
    line-height: 1.65;
    font-size: 13px;
  }

  .sample-disclaimer {
    display: block;
    margin-top: 10px;
    color: #8a857e;
    font-size: 10px;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .steps article {
    padding: 26px 20px 28px;
    border-left: 1px solid var(--line);
  }

  .steps article:first-child {
    border-left: 0;
    padding-left: 0;
  }

  .steps span {
    color: var(--orange);
    font-size: 11px;
    font-weight: 900;
  }

  .steps strong {
    display: block;
    margin-top: 15px;
    font-size: 16px;
  }

  .steps p {
    color: var(--muted);
    font-size: 12px;
    line-height: 1.6;
  }

  .experience-section {
    background: var(--paper);
  }

  .experience-grid {
    display: grid;
    grid-template-columns: .8fr 1.2fr;
    gap: 70px;
    align-items: start;
  }

  .text-link {
    display: inline-flex;
    margin-top: 18px;
    color: var(--ink);
    font-size: 12px;
    font-weight: 900;
    text-decoration: none;
    border-bottom: 2px solid var(--orange);
  }

  .name-grid {
    margin-top: 14px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid #cfc8bf;
    border-left: 1px solid #cfc8bf;
  }

  .name-grid span {
    min-height: 62px;
    display: flex;
    align-items: center;
    padding: 12px;
    border-right: 1px solid #cfc8bf;
    border-bottom: 1px solid #cfc8bf;
    background: rgba(255,255,255,.35);
    font-size: 11px;
    font-weight: 800;
    box-sizing: border-box;
  }

  .agency-label {
    margin-top: 30px;
  }

  .agency-list {
    margin-top: 12px;
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }

  .agency-list span {
    padding: 7px 9px;
    background: #fff;
    border: 1px solid #d7d0c8;
    font-size: 10px;
    font-weight: 700;
  }

  .experience-note {
    display: block;
    margin-top: 14px;
    color: #807a72;
    font-size: 9px;
    line-height: 1.5;
  }

  .human-section {
    border-bottom: 1px solid var(--line);
  }

  .human-grid {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: 35px;
    max-width: 920px;
  }

  .human-mark {
    width: 110px;
    height: 110px;
    display: grid;
    place-items: center;
    background: var(--ink);
    color: #fff;
    font-size: 32px;
    font-weight: 900;
  }

  .human-grid h2 {
    font-size: 44px;
  }

  .human-grid > div > strong {
    display: block;
    margin-top: 8px;
    color: var(--orange);
    font-size: 13px;
  }

  .human-links {
    margin-top: 18px;
  }

  .human-links a {
    color: var(--ink);
    font-size: 12px;
    font-weight: 800;
  }

  .cta-section {
    padding: 82px 0 38px;
    background: var(--ink);
    color: #fff;
  }

  .cta-grid {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 50px;
    align-items: end;
  }

  .cta-grid p {
    max-width: 700px;
    color: #bdb9b2;
  }

  .btn-white {
    background: #fff;
    color: var(--ink);
  }

  .btn-outline {
    border: 1px solid #555;
    color: #fff;
  }

  .trust-row {
    margin-top: 55px;
    padding-top: 22px;
    border-top: 1px solid #2d2d2d;
    display: flex;
    flex-wrap: wrap;
    gap: 18px 35px;
    color: #8f8b84;
    font-size: 10px;
  }

  @media (max-width: 900px) {
    .hero {
      padding-top: 56px;
    }

    .hero-grid,
    .statement-grid,
    .experience-grid,
    .cta-grid {
      grid-template-columns: 1fr;
    }

    .hero-grid {
      gap: 38px;
    }

    .hero-copy h1 {
      font-size: clamp(48px, 12vw, 70px);
    }

