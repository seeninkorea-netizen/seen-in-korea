---
import BaseLayout from '../../layouts/BaseLayout.astro';

const fullPortfolioUrl =
  '/portfolio/Dokyun_Kim_Translation_Localization_Portfolio_FINAL_v19.pdf';

const inquiryMailto =
  'mailto:seeninkorea@gmail.com?subject=Creator%20Localization%20Inquiry';
---

<BaseLayout
  title="Korean ↔ English Creator Localization | SEEN IN KOREA"
  description="Korean ↔ English creator localization, subtitles and linguistic QA led by one dedicated translator who learns your channel's voice."
>
  <main class="translation-page">

    <!-- HERO -->
    <section class="hero">
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <div class="eyebrow">
            CREATOR LOCALIZATION · KOREAN ↔ ENGLISH
          </div>

          <h1>
            Take your channel global.<br />
            <span>Keep your voice.</span>
          </h1>

          <p class="hero-dek">
            English localization for Korean creators — and Korean localization
            for global creators. One dedicated translator learns your channel’s
            tone, recurring language and audience instead of treating every
            video like a new assignment.
          </p>

          <div class="hero-actions">
            <a href={inquiryMailto} class="btn btn-primary">
              SEND A VIDEO FOR A QUOTE →
            </a>

            <a
              href={fullPortfolioUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-secondary"
            >
              VIEW FULL PORTFOLIO
            </a>
          </div>

          <p class="hero-note">
            Share a recent video URL and target language. We’ll review the scope
            and reply by email with a tailored quote.
          </p>
        </div>

        <aside class="hero-card">
          <div class="hero-card-label">
            WHY THIS IS DIFFERENT
          </div>

          <div class="hero-card-big">
            One channel.<br />
            One lead translator.
          </div>

          <p>
            The same person stays with the channel, building familiarity with
            character voice, running jokes, terminology, names and preferred
            phrasing over time.
          </p>

          <div class="hero-card-rule"></div>

          <ul>
            <li>Channel-specific tone continuity</li>
            <li>Dialogue + subtitles + on-screen text</li>
            <li>Cultural adaptation, not word-for-word output</li>
            <li>Final linguistic QA before delivery</li>
          </ul>
        </aside>
      </div>

      <!-- PROVEN AT SCALE -->
      <div class="proof-strip">
        <div class="wrap">
          <div class="proof-head">
            <span>PROVEN AT SCALE</span>

            <p>
              Creator-focused localization backed by years of real production
              experience.
            </p>
          </div>

          <div class="stats">
            <div class="stat stat-featured">
              <strong>50<span>+</span></strong>
              <div>YOUTUBE CREATORS</div>
              <small>Cumulative creator work</small>
            </div>

            <div class="stat">
              <strong>10</strong>
              <div>ACTIVE CREATOR CHANNELS</div>
              <small>Ongoing channel support</small>
            </div>

            <div class="stat">
              <strong>140<span>+</span></strong>
              <div>LEGACY VIDEO ASSIGNMENTS</div>
              <small>Across earlier video programs</small>
            </div>

            <div class="stat">
              <strong>8<span>+</span></strong>
              <div>YEARS IN LOCALIZATION</div>
              <small>Korean ↔ English</small>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- PROJECT EXPERIENCE — TOP TRUST STRIP -->
    <section class="project-trust-strip">
      <div class="wrap project-trust-head">
        <div>
          <strong>SELECTED PROJECT EXPERIENCE</strong>
          <span>
            CLIENTS &amp; PROJECTS ACROSS MEDIA, FINANCE, LEGAL, MEDICAL,
            TECH &amp; MORE
          </span>
        </div>

        <a
          href={fullPortfolioUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="portfolio-mini-link"
        >
          → FULL PORTFOLIO
        </a>
      </div>

      <div class="logo-marquee project-marquee">
        <div class="logo-marquee-track project-track">

          <div class="logo-strip project-strip">
            <img
              src="/images/translation-project-logos-single-row.png"
              alt="Selected translation and localization project experience"
            />
          </div>

          <div
            class="logo-strip project-strip"
            aria-hidden="true"
          >
            <img
              src="/images/translation-project-logos-single-row.png"
              alt=""
            />
          </div>

        </div>
      </div>
    </section>

    <!-- POSITIONING -->
    <section class="section section-dark">
      <div class="wrap statement-grid">
        <div>
          <div class="eyebrow eyebrow-light">
            NOT JUST SUBTITLES
          </div>

          <h2>
            Translation is only one part
            of how a video travels.
          </h2>
        </div>

        <div class="statement-copy">
          <p>
            A technically correct subtitle can still flatten a creator’s
            personality. We localize for the viewer who will actually watch
            the video — while protecting the meaning of the original.
          </p>

          <div class="deliverables">
            <span>Dialogue</span>
            <span>Subtitle adaptation</span>
            <span>On-screen text</span>
            <span>Titles &amp; descriptions</span>
            <span>Cultural context</span>
            <span>Final QA</span>
          </div>
        </div>
      </div>
    </section>

    <!-- COMPARISON -->
    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <div class="eyebrow">
            CONTINUITY MATTERS
          </div>

          <h2>
            Why a dedicated translator matters.
          </h2>

          <p>
            Creator content depends on personality. Consistency becomes more
            valuable as a channel publishes more videos.
          </p>
        </div>

        <div class="compare-grid">
          <article class="compare-card compare-muted">
            <div class="compare-label">
              ROTATING WORKFLOW
            </div>

            <h3>
              Every video starts from zero.
            </h3>

            <ul>
              <li>Different translator depending on availability</li>
              <li>Channel tone must be re-learned repeatedly</li>
              <li>Recurring phrases can drift across videos</li>
              <li>Character voice depends on each individual assignment</li>
            </ul>
          </article>

          <article class="compare-card compare-featured">
            <div class="compare-label">
              SEEN IN KOREA WORKFLOW
            </div>

            <h3>
              The channel context accumulates.
            </h3>

            <ul>
              <li>One lead translator follows the channel over time</li>
              <li>Voice, terminology and recurring references stay consistent</li>
              <li>Previous decisions inform future episodes</li>
              <li>Final QA checks meaning, tone, names and omissions</li>
            </ul>
          </article>
        </div>
      </div>
    </section>

    <!-- SAMPLE -->
    <section class="section sample-section">
      <div class="wrap">
        <div class="section-head">
          <div class="eyebrow">
            ILLUSTRATIVE CREATOR SAMPLE
          </div>

          <h2>
            Correct English is not always natural English.
          </h2>

          <p>
            A simple example of how tone changes when copy is localized for
            an actual viewer rather than translated sentence by sentence.
          </p>
        </div>

        <div class="sample-shell">
          <div class="sample-source">
            <small>ORIGINAL KOREAN</small>

            <p>
              이번 주 내내 식단 잘 지켰는데 오늘 너무 먹었어요.
              이러다 바로 살찌는 거 아니야?
            </p>
          </div>

          <div class="sample-row">
            <div class="sample-label">LITERAL</div>

            <div>
              I kept my diet well all week, but I ate too much today.
              Won’t I gain weight right away?
            </div>
          </div>

          <div class="sample-row sample-final">
            <div class="sample-label">LOCALIZED</div>

            <div>
              I was so good with my diet all week… and then I completely
              overdid it today. Watch me gain it all back overnight.
            </div>
          </div>

          <div class="sample-reason">
            <strong>WHY IT CHANGED</strong>

            <p>
              The meaning stays intact, but the phrasing is reshaped into a
              more natural creator-style line with the same self-aware,
              conversational tone.
            </p>
          </div>
        </div>

        <small class="sample-disclaimer">
          Illustrative sample created for portfolio demonstration;
          not client source material.
        </small>
      </div>
    </section>

    <!-- WORKFLOW -->
    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <div class="eyebrow">WORKFLOW</div>
          <h2>Simple on your side.</h2>
        </div>

        <div class="steps">
          <article>
            <span>01</span>
            <strong>Send the video</strong>
            <p>Share the YouTube URL or source file and target language.</p>
          </article>

          <article>
            <span>02</span>
            <strong>Scope &amp; quote</strong>
            <p>We review length, subtitle needs, on-screen text and deadline.</p>
          </article>

          <article>
            <span>03</span>
            <strong>Localization</strong>
            <p>Dialogue, subtitles and creator-specific language are adapted.</p>
          </article>

          <article>
            <span>04</span>
            <strong>Final QA</strong>
            <p>Meaning, omissions, names, terminology and tone are checked.</p>
          </article>

          <article>
            <span>05</span>
            <strong>Delivery</strong>
            <p>Receive the agreed format, including SRT/TXT when required.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- BROADER EXPERIENCE -->
    <section class="section experience-section">
      <div class="wrap experience-intro">
        <div>
          <div class="eyebrow">
            BROADER EXPERIENCE
          </div>

          <h2>
            Built on years of localization work.
          </h2>
        </div>

        <div class="experience-copy">
          <p>
            Creator video is the focus here, supported by broader experience
            across media, finance, legal, medical, technical, game and
            corporate localization — including work delivered through
            specialist translation and localization agencies.
          </p>

          <a
            href={fullPortfolioUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-link"
          >
            OPEN FULL PORTFOLIO →
          </a>
        </div>
      </div>

      <!-- AGENCY COLLABORATIONS -->
      <div class="agency-block">
        <div class="wrap logo-row-title">
          <div>
            <span>AGENCY COLLABORATIONS</span>
            <small>TRANSLATION &amp; LOCALIZATION PARTNERS</small>
          </div>
        </div>

        <div class="logo-marquee agency-marquee">
          <div class="logo-marquee-track agency-track">

            <div class="logo-strip agency-strip">
              <img
                src="/images/translation-agency-logos-single-row.png"
                alt="Translation and localization agency collaborations"
              />
            </div>

            <div
              class="logo-strip agency-strip"
              aria-hidden="true"
            >
              <img
                src="/images/translation-agency-logos-single-row.png"
                alt=""
              />
            </div>

          </div>
        </div>
      </div>

      <div class="wrap">
        <small class="experience-note">
          Names indicate project or collaboration experience and do not imply
          endorsement or an ongoing partnership.
        </small>
      </div>
    </section>

    <!-- HUMAN -->
    <section class="section human-section">
      <div class="wrap human-grid">

        <div class="human-photo-column">
          <div class="human-photo-frame">
            <img
              src="/images/dokyun-kim-profile-studio.png"
              alt="Dokyun Kim, Lead Translator and Localization Specialist"
              loading="lazy"
            />

            <div class="photo-corner photo-corner-top"></div>
            <div class="photo-corner photo-corner-bottom"></div>
          </div>

          <div class="photo-caption">
            <strong>DOKYUN KIM</strong>
            <span>SEOUL · KOREA</span>
          </div>
        </div>

        <div class="human-copy">
          <div class="eyebrow">
            WHO IS BEHIND THE WORK
          </div>

          <h2>Dokyun Kim</h2>

          <strong class="human-role">
            Lead Translator &amp; Localization Specialist
          </strong>

          <p class="human-intro">
            8+ years across Korean ↔ English translation, creator video
            localization and linguistic QA. Experience includes 1M+ cumulative
            words and work across 50+ YouTube creators, with 10 channels
            currently supported on an ongoing basis.
          </p>

          <div class="human-proof">
            <div>
              <b>1M<span>+</span></b>
              <small>CUMULATIVE WORDS</small>
            </div>

            <div>
              <b>50<span>+</span></b>
              <small>YOUTUBE CREATORS</small>
            </div>

            <div>
              <b>10</b>
              <small>ACTIVE CHANNELS</small>
            </div>
          </div>

          <div class="human-links">
            <a href="mailto:seeninkorea@gmail.com">
              seeninkorea@gmail.com
            </a>

            <a
              href={fullPortfolioUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Full portfolio →
            </a>
          </div>
        </div>

      </div>
    </section>

    <!-- FINAL CTA -->
    <section class="cta-section">
      <div class="wrap cta-grid">
        <div>
          <div class="eyebrow eyebrow-light">
            START WITH ONE VIDEO
          </div>

          <h2>
            Have a video in mind?
          </h2>

          <p>
            Send the URL, target language and preferred deadline.
            We’ll review the actual scope and reply with a tailored quote.
          </p>
        </div>

        <div class="cta-actions">
          <a href={inquiryMailto} class="btn btn-white">
            EMAIL PROJECT DETAILS →
          </a>

          <a
            href={fullPortfolioUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-outline"
          >
            VIEW PORTFOLIO
          </a>
        </div>
      </div>

      <div class="wrap trust-row">
        <span>NDA available upon request</span>
        <span>Confidential files handled only for project delivery</span>
        <span>Scope and price confirmed before work begins</span>
      </div>
    </section>

  </main>
</BaseLayout>

<style>
  :global(body) {
    margin: 0;
  }

  .translation-page {
    --ink: #111111;
    --paper: #f4f0e8;
    --orange: #ff4f12;
    --line: #ded8cf;
    --muted: #65615b;
    --soft: #faf8f3;

    color: var(--ink);
    background: #fff;
    overflow: hidden;
  }

  .wrap {
    width: min(1180px, calc(100% - 40px));
    margin: 0 auto;
  }

  .eyebrow {
    font-size: 11px;
    font-weight: 900;
    letter-spacing: .13em;
    color: var(--orange);
  }

  .eyebrow-light {
    color: #ff8154;
  }

  /* HERO */

  .hero {
    padding: 84px 0 0;
    background: var(--paper);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.25fr .75fr;
    gap: 72px;
    align-items: start;
    padding-bottom: 72px;
  }

  .hero-copy h1 {
    margin: 17px 0 22px;
    max-width: 800px;
    font-size: clamp(52px, 6.5vw, 88px);
    line-height: .92;
    letter-spacing: -.065em;
  }

  .hero-copy h1 span {
    color: var(--orange);
  }

  .hero-dek {
    max-width: 735px;
    margin: 0;
    color: #3f3c37;
    font-size: 19px;
    line-height: 1.65;
  }

  .hero-actions,
  .cta-actions,
  .human-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .hero-actions {
    margin-top: 30px;
  }

  .btn {
    min-height: 50px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 23px;
    border-radius: 2px;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: .04em;
    text-decoration: none;
    box-sizing: border-box;
    transition: all .18s ease;
  }

  .btn-primary {
    background: var(--ink);
    color: #fff;
  }

  .btn-primary:hover {
    background: var(--orange);
    transform: translateY(-2px);
  }

  .btn-secondary {
    border: 1px solid #aaa39a;
    color: var(--ink);
    background: transparent;
  }

  .btn-secondary:hover {
    border-color: var(--ink);
  }

  .hero-note {
    margin: 15px 0 0;
    color: #76716a;
    font-size: 12px;
    line-height: 1.55;
  }

  .hero-card {
    background: var(--ink);
    color: #fff;
    padding: 34px;
    box-shadow: 18px 22px 0 rgba(255, 79, 18, .12);
  }

  .hero-card-label {
    color: #ff8154;
    font-size: 10px;
    font-weight: 900;
    letter-spacing: .12em;
  }

  .hero-card-big {
    margin-top: 22px;
    font-size: 36px;
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -.04em;
  }

  .hero-card p {
    color: #c8c4bd;
    font-size: 14px;
    line-height: 1.65;
  }

  .hero-card-rule {
    height: 1px;
    margin: 25px 0 14px;
    background: #343434;
  }

  .hero-card ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .hero-card li {
    padding: 10px 0 10px 22px;
    border-bottom: 1px solid #2c2c2c;
    position: relative;
    font-size: 12px;
    line-height: 1.5;
  }

  .hero-card li::before {
    content: "→";
    position: absolute;
    left: 0;
    color: var(--orange);
  }

  /* PROVEN AT SCALE */

  .proof-strip {
    background: #0d0d0d;
    color: #fff;
    border-top: 1px solid #252525;
  }

  .proof-head {
    min-height: 68px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    border-bottom: 1px solid #292929;
  }

  .proof-head > span {
    color: var(--orange);
    font-size: 10px;
    font-weight: 900;
    letter-spacing: .15em;
  }

  .proof-head p {
    margin: 0;
    color: #858585;
    font-size: 11px;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  .stat {
    min-height: 180px;
    padding: 34px 26px 28px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    border-left: 1px solid #292929;
    position: relative;
  }

  .stat:first-child {
    border-left: 0;
  }

  .stat-featured {
    background: #171717;
  }

  .stat-featured::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: var(--orange);
  }

  .stat strong {
    color: #fff;
    font-size: clamp(48px, 5vw, 66px);
    line-height: .9;
    letter-spacing: -.055em;
  }

  .stat-featured strong {
    color: var(--orange);
  }

  .stat strong span {
    color: var(--orange);
  }

  .stat > div {
    margin-top: 17px;
    color: #fff;
    font-size: 10px;
    font-weight: 900;
    letter-spacing: .06em;
  }

  .stat small {
    display: block;
    margin-top: 7px;
    color: #777;
    font-size: 9px;
  }

  /* TOP PROJECT LOGO STRIP */

  .project-trust-strip {
    padding: 32px 0 27px;
    background: var(--paper);
    border-bottom: 1px solid #d8d0c5;
    overflow: hidden;
  }

  .project-trust-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 30px;
  }

  .project-trust-head > div {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .project-trust-head strong {
    color: var(--orange);
    font-size: 11px;
    font-weight: 900;
    letter-spacing: .11em;
  }

  .project-trust-head span {
    color: #6c665e;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: .08em;
  }

  .portfolio-mini-link {
    color: var(--ink);
    font-size: 10px;
    font-weight: 900;
    letter-spacing: .08em;
    text-decoration: none;
    border-bottom: 2px solid var(--orange);
    padding-bottom: 5px;
    white-space: nowrap;
  }

  /* SHARED LOGO MARQUEE */

  .logo-marquee {
    width: 100%;
    overflow: hidden;
    position: relative;

    -webkit-mask-image:
      linear-gradient(
        to right,
        transparent,
        #000 4%,
        #000 96%,
        transparent
      );

    mask-image:
      linear-gradient(
        to right,
        transparent,
        #000 4%,
        #000 96%,
        transparent
      );
  }

  .project-marquee {
    margin-top: 17px;
    padding: 11px 0 7px;
  }

  .agency-marquee {
    margin-top: 8px;
    padding: 13px 0 15px;
  }

  .logo-marquee-track {
    --logo-gap: 85px;
    width: max-content;
    display: flex;
    align-items: center;
    gap: var(--logo-gap);
    will-change: transform;
  }

  .logo-strip {
    flex-shrink: 0;
  }

  .project-strip {
    width: 1550px;
  }

  .agency-strip {
    width: 1580px;
  }

  .logo-strip img {
    width: 100%;
    height: auto;
    display: block;
  }

  .project-track {
    animation:
      project-logo-scroll
      48s
      linear
      infinite;
  }

  .agency-track {
    animation:
      agency-logo-scroll
      52s
      linear
      infinite;
  }

  .logo-marquee:hover .logo-marquee-track {
    animation-play-state: paused;
  }

  @keyframes project-logo-scroll {
    from {
      transform: translateX(0);
    }

    to {
      transform: translateX(calc(-50% - 42.5px));
    }
  }

  @keyframes agency-logo-scroll {
    from {
      transform: translateX(calc(-50% - 42.5px));
    }

    to {
      transform: translateX(0);
    }
  }

  /* BASIC SECTIONS */

  .section {
    padding: 82px 0;
  }

  .section-dark {
    background: var(--ink);
    color: #fff;
  }

  .statement-grid {
    display: grid;
    grid-template-columns: .95fr 1.05fr;
    gap: 80px;
  }

  .statement-grid h2,
  .section-head h2,
  .experience-intro h2,
  .human-grid h2,
  .cta-grid h2 {
    margin: 10px 0 0;
    font-size: clamp(38px, 5vw, 58px);
    line-height: .98;
    letter-spacing: -.05em;
  }

  .statement-copy > p {
    margin: 0;
    color: #c7c3bc;
    font-size: 17px;
    line-height: 1.7;
  }

  .deliverables {
    margin-top: 30px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .deliverables span {
    padding: 9px 12px;
    border: 1px solid #3b3b3b;
    font-size: 11px;
    font-weight: 800;
  }

  .section-head {
    max-width: 820px;
    margin-bottom: 34px;
  }

  .section-head p,
  .experience-copy p,
  .human-grid p,
  .cta-grid p {
    color: var(--muted);
