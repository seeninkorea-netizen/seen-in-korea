---
import '../styles/global.css';
import { getSiteSettings } from '../lib/content';

const {
  title = 'SEEN IN KOREA — Korea, verified',
  description = 'K-culture trends, real stories from foreigners in Korea, Korean products, and practical help.',
  image,
  canonical,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  author
} = Astro.props;

const currentUrl =
  canonical ||
  new URL(Astro.url.pathname, Astro.site || Astro.url.origin).toString();

const siteSettings = await getSiteSettings();
const footerCopy = siteSettings?.footerCopy ?? '';
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{title}</title>

    <meta name="description" content={description} />
    <meta
      name="robots"
      content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"
    />

    <link rel="canonical" href={currentUrl} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:site_name" content="SEEN IN KOREA" />

    {image && <meta property="og:image" content={image} />}
    {image && <meta property="og:image:alt" content={title} />}

    <!-- Article metadata -->
    {
      ogType === 'article' && publishedTime && (
        <meta property="article:published_time" content={publishedTime} />
      )
    }

    {
      ogType === 'article' && modifiedTime && (
        <meta property="article:modified_time" content={modifiedTime} />
      )
    }

    {
      ogType === 'article' && author && (
        <meta property="article:author" content={author} />
      )
    }

    <!-- Twitter / X -->
    <meta
      name="twitter:card"
      content={image ? 'summary_large_image' : 'summary'}
    />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {image && <meta name="twitter:image" content={image} />}

    <slot name="head" />
  </head>

  <body>
   <header class="site-header">

  <!-- Desktop header -->
  <div class="wrap nav desktop-header-row">
    <a class="brand" href="/">SEEN IN <span>KOREA</span></a>

    <nav class="desktop-nav">
      <a href="/category/trending">TRENDING</a>
      <a href="/category/seen-on">SEEN ON</a>
      <a href="/real-korea">REAL KOREA</a>
      <a href="/shop-korea">SHOP KOREA</a>
      <a href="/articles">ALL STORIES</a>
    </nav>

    <a class="help-btn" href="/korea-help">KOREA HELP →</a>
  </div>

  <!-- Mobile header -->
  <div class="mobile-header">

    <div class="mobile-header-main">
      <button
        class="mobile-menu-btn"
        type="button"
        aria-label="Open menu"
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>

      <a class="brand mobile-brand" href="/">
        SEEN IN <span>KOREA</span>
      </a>

      <div class="mobile-header-spacer" aria-hidden="true"></div>
    </div>

    <nav class="mobile-category-nav" aria-label="Main sections">
  <a
    href="/"
    class:list={{ active: currentPath === '/' }}
  >
    TOP
  </a>

  <a
    href="/category/trending"
    class:list={{ active: currentPath.startsWith('/category/trending') }}
  >
    TRENDING
  </a>

  <a
    href="/category/seen-on"
    class:list={{ active: currentPath.startsWith('/category/seen-on') }}
  >
    SEEN ON
  </a>

  <a
    href="/real-korea"
    class:list={{ active: currentPath.startsWith('/real-korea') }}
  >
    REAL KOREA
  </a>

  <a
    href="/shop-korea"
    class:list={{ active: currentPath.startsWith('/shop-korea') }}
  >
    SHOP
  </a>
</nav>

  </div>

</header>

<div class="mobile-menu-overlay" data-mobile-menu-close></div>

<aside
  id="mobile-menu"
  class="mobile-menu-drawer"
  aria-hidden="true"
>
  <div class="mobile-menu-top">
    <a class="brand" href="/">SEEN IN <span>KOREA</span></a>

    <button
      class="mobile-menu-close"
      type="button"
      aria-label="Close menu"
      data-mobile-menu-close
    >
      ×
    </button>
  </div>

 <nav class="mobile-menu-links">

  <a class="mobile-menu-primary" href="/">
    TOP STORIES
  </a>

  <a href="/category/trending">
    TRENDING
  </a>

  <a href="/category/seen-on">
    SEEN ON
  </a>

  <a href="/real-korea">
    REAL KOREA
  </a>

  <a href="/shop-korea">
    SHOP KOREA
  </a>

  <a href="/articles">
    ALL STORIES
  </a>

</nav>

  <div class="mobile-menu-divider"></div>

  <div class="mobile-menu-service">
    <div class="mobile-menu-service-title">
      KOREA HELP <small>BETA</small>
    </div>

    <a href="/korea-help/call-korea">Call Korea</a>
    <a href="/korea-help/translation">Translation</a>
    <a href="/korea-help">Korea Help</a>
  </div>

  <div class="mobile-menu-divider"></div>

  <nav class="mobile-menu-secondary">
    <a href="/about">ABOUT</a>
    <a href="mailto:seeninkorea@gmail.com">CONTACT</a>
  </nav>

</aside>

    <slot />

    <footer>
  <div class="wrap footer-grid">
    <div>
      <div class="footer-brand">SEEN IN KOREA</div>
    </div>

    {footerCopy && (
      <div class="footer-copy">
        {footerCopy}
      </div>
    )}
  </div>
</footer>
<script is:inline>
  const menuButton = document.querySelector('.mobile-menu-btn');
  const menuDrawer = document.querySelector('.mobile-menu-drawer');
  const menuOverlay = document.querySelector('.mobile-menu-overlay');
  const closeButtons = document.querySelectorAll('[data-mobile-menu-close]');

  function openMobileMenu() {
    menuDrawer?.classList.add('is-open');
    menuOverlay?.classList.add('is-open');
    document.body.classList.add('mobile-menu-open');

    menuButton?.setAttribute('aria-expanded', 'true');
    menuDrawer?.setAttribute('aria-hidden', 'false');
  }

  function closeMobileMenu() {
    menuDrawer?.classList.remove('is-open');
    menuOverlay?.classList.remove('is-open');
    document.body.classList.remove('mobile-menu-open');

    menuButton?.setAttribute('aria-expanded', 'false');
    menuDrawer?.setAttribute('aria-hidden', 'true');
  }

  menuButton?.addEventListener('click', openMobileMenu);

  closeButtons.forEach((button) => {
    button.addEventListener('click', closeMobileMenu);
  });

  menuDrawer?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', closeMobileMenu);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      closeMobileMenu();
    }
  });
</script>
  </body>
</html>
